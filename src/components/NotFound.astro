---
import { blogPath, homePath, pricingPath, ui, LOCALES, LANG_NATIVE, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /**
   * The root 404 answers for URLs outside every locale, so it cannot know the
   * reader's language: it also offers each locale's home page.
   */
  languages?: boolean;
}

const { locale, languages = false } = Astro.props;
const t = ui[locale].notFound;
// Root-relative on purpose: a 404 page is served at whatever URL was missing,
// so a relative link would resolve against the mistyped address.
const links = [
  { href: homePath(locale), label: t.home },
  { href: blogPath(locale), label: t.blog },
  { href: pricingPath(locale), label: t.pricing },
];
---

<section class="not-found" aria-labelledby="not-found-title">
  <p class="code">404 · {t.title}</p>
  <h1 id="not-found-title">{t.heading}</h1>
  <p class="lead">{t.lead}</p>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a class="btn btn-secondary" href={link.href}>{link.label}&nbsp;<span aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul>
  {languages && (
    <ul class="languages">
      {LOCALES.filter((l) => l !== locale).map((l) => (
        <li>
          <a href={homePath(l)} lang={l} hreflang={l}>{LANG_NATIVE[l]}</a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .not-found {
    max-width: var(--measure-prose);
    padding: 2.5rem 0 1rem;
  }
  /* A single green rule: the tri-colour bar it replaces used amber as
     decoration, and amber is a status colour. */
  .not-found::before {
    content: '';
    display: block;
    width: 78px;
    height: 5px;
    margin-bottom: 1.4rem;
    background: var(--green);
    border-radius: var(--r-pill);
  }
  .code {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font: 700 var(--fs-13)/var(--lh-ui) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
  }
  .lead {
    margin: 0 0 2rem;
    color: var(--ink-soft);
    font-size: var(--fs-17);
  }
  .links,
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links span {
    color: var(--brand);
  }
  .languages {
    gap: 0.4rem 1rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-14);
  }
  .languages a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .languages a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .not-found {
      padding-top: 1rem;
    }
    .lead {
      font-size: var(--fs-16);
    }
  }
</style>
