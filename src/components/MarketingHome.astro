---
import { getPostsInLocale } from '../lib/posts';
import { blogPath, postPath, securityPath, type Locale } from '../lib/i18n';
import { homeCopy } from '../lib/home';
import { termBySlug, termHref } from '../lib/terms';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const posts = (await getPostsInLocale(locale))
  .filter((post) => post.entry.data.status !== 'archived')
  .slice(0, 3);

const topicLink = (slug: string) => {
  const term = termBySlug(slug);
  return term ? termHref(locale, term) : `/${locale}/`;
};

const templateLinks = [
  {
    href: 'https://github.com/objectstack-ai/templates/tree/main/packages/helpdesk',
    tone: 'green',
  },
  {
    href: 'https://github.com/objectstack-ai/templates/tree/main/packages/contracts',
    tone: 'blue',
  },
  {
    href: 'https://github.com/objectstack-ai/templates/tree/main/packages/procurement',
    tone: 'amber',
  },
];

const coverSrc = (cover: unknown): string =>
  typeof cover === 'string'
    ? cover
    : (cover as { src?: string })?.src ?? '';
---

<div class:list={['home', `lang-${locale}`]}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> {copy.eyebrow}</p>
      <h1>{copy.hero[0]}<br /><strong>{copy.hero[1]}</strong></h1>
      <p class="hero-lead">{copy.heroLead}</p>
      <div class="hero-actions">
        <a class="button primary" href="#capabilities">{copy.primaryCta} <span>→</span></a>
        <a class="button secondary" href={topicLink('app-building')}>{copy.secondaryCta}</a>
      </div>
      <dl class="proof">
        {copy.proof.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
    <div class="hero-media">
      <img
        src="/images/objectos-home-hero.png"
        alt={copy.imageAlt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="media-note">
        <span class="live-dot"></span>
        <span><strong>{copy.imageNoteTitle}</strong>{copy.imageNote}</span>
      </div>
    </div>
  </section>

  <section class="positioning" aria-label={copy.positioningKicker}>
    <p class="section-kicker">{copy.positioningKicker}</p>
    <h2>{copy.positioningTitle[0]}<br />{copy.positioningTitle[1]}</h2>
    <p>{copy.positioningCopy}</p>
  </section>

  <section class="capability-section" id="capabilities">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.capabilitiesKicker}</p>
        <h2>{copy.capabilitiesTitle[0]}<br />{copy.capabilitiesTitle[1]}</h2>
      </div>
      <a class="text-link" href={topicLink('ai-agents')}>{copy.capabilitiesLink} <span>→</span></a>
    </div>
    <ol class="capability-list">
      {copy.capabilities.map((item, index) => (
        <li>
          <span class="cap-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="ai-section" id="ai">
    <div class="ai-copy">
      <p class="section-kicker">{copy.aiKicker}</p>
      <h2>{copy.aiTitle[0]}<br />{copy.aiTitle[1]}</h2>
      <p>{copy.aiCopy}</p>
      <a class="text-link" href={securityPath(locale)}>{copy.aiLink} <span>→</span></a>
    </div>
    <div class="ai-grid">
      {copy.aiItems.map((item, index) => (
        <div class:list={['ai-card', `tone-${index + 1}`]}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="workflow">
    <div class="workflow-intro">
      <p class="section-kicker">{copy.workflowKicker}</p>
      <h2>{copy.workflowTitle[0]}<br />{copy.workflowTitle[1]}</h2>
      <p>{copy.workflowCopy}</p>
    </div>
    <div class="workflow-map" aria-label={copy.workflowKicker}>
      <div class="map-row">
        <span class="map-label">{copy.existingSystems}</span>
        <div class="map-items">
          {copy.systemLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
      <div class="connector"><span></span><b>{copy.connectModel}</b><span></span></div>
      <div class="object-layer">
        <small>OBJECTOS BUSINESS OBJECT LAYER</small>
        <strong>{copy.objectLayer}</strong>
      </div>
      <div class="connector"><span></span><b>{copy.secureExecution}</b><span></span></div>
      <div class="map-row outputs">
        <span class="map-label">{copy.outcomes}</span>
        <div class="map-items">
          {copy.outcomeLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="security-section" id="security">
    <div class="security-copy">
      <p class="section-kicker">{copy.securityKicker}</p>
      <h2>{copy.securityTitle[0]}<br />{copy.securityTitle[1]}</h2>
      <p>{copy.securityCopy}</p>
      <a class="text-link" href={securityPath(locale)}>{copy.securityLink} <span>→</span></a>
    </div>
    <div class="security-grid">
      {copy.securityItems.map((item) => (
        <div class="security-item">
          <span></span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="solution-section" id="templates">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.solutionsKicker}</p>
        <h2>{copy.solutionsTitle[0]}<br />{copy.solutionsTitle[1]}</h2>
      </div>
    </div>
    <div class="solution-grid">
      {copy.solutions.map((solution, index) => (
        <a
          class:list={['solution', templateLinks[index].tone]}
          href={templateLinks[index].href}
          target="_blank"
          rel="noreferrer"
        >
          <span class="solution-mark"></span>
          <h3>{solution.title}</h3>
          <p>{solution.copy}</p>
          <span class="solution-link">{copy.solutionLink} →</span>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="articles">
      <div class="section-head">
        <div>
          <p class="section-kicker">{copy.insightsKicker}</p>
          <h2>{copy.insightsTitle}</h2>
        </div>
        <a class="text-link" href={blogPath(locale)}>{copy.insightsLink} <span>→</span></a>
      </div>
      <div class="article-grid">
        {posts.map((post) => (
          <a class="article" href={postPath(locale, post.slug)}>
            {post.entry.data.cover && (
              <img
                src={coverSrc(post.entry.data.cover)}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <time>{post.entry.data.date.toISOString().slice(0, 10)}</time>
              <h3>{post.entry.data.title}</h3>
              <p>{post.entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="closing">
    <p class="section-kicker">{copy.closingKicker}</p>
    <h2>{copy.closingTitle}</h2>
    <p>{copy.closingCopy}</p>
    <a class="button light" href={topicLink('integration-data')}>{copy.closingCta} <span>→</span></a>
  </section>
</div>

<style>
  .home {
    --home-green: #087f5b;
    --home-blue: #2563eb;
    --home-amber: #b45309;
  }
  .home :global(h1),
  .home :global(h2),
  .home :global(h3),
  .home :global(p) {
    margin-top: 0;
  }
  .hero {
    min-height: min(760px, calc(100vh - 104px));
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(460px, 1.1fr);
    gap: 2.5rem;
    align-items: center;
    padding: 1rem 0 4rem;
  }
  .hero-copy {
    min-width: 0;
  }
  .eyebrow,
  .section-kicker {
    color: var(--home-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.35rem;
    overflow-wrap: anywhere;
  }
  .eyebrow span {
    width: 26px;
    height: 1px;
    background: currentColor;
  }
  .hero h1 {
    font-size: clamp(3.15rem, 5vw, 4.65rem);
    line-height: 1.04;
    letter-spacing: 0;
    margin-bottom: 1.4rem;
    font-weight: 750;
  }
  .hero h1 strong {
    display: block;
    color: var(--home-green);
    font-weight: inherit;
    font-size: 0.9em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
    max-width: 35rem;
    margin-bottom: 1.8rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }
  .button:hover {
    transform: translateY(-1px);
  }
  .button.primary {
    color: white;
    background: #1c1917;
  }
  .button.secondary {
    border-color: var(--line);
    background: var(--surface);
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .proof div {
    display: flex;
    flex-direction: column;
  }
  .proof dt {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .proof dd {
    color: var(--muted);
    font-size: 0.75rem;
    margin: 0.1rem 0 0;
  }
  .hero-media {
    position: relative;
  }
  .hero-media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 30px 80px -46px rgba(19, 78, 58, 0.7);
  }
  .media-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    max-width: 250px;
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.75rem 0.85rem;
    color: #292524;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 6px;
    box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.4);
    font-size: 0.72rem;
    line-height: 1.5;
    backdrop-filter: blur(12px);
  }
  .media-note strong {
    display: block;
    font-size: 0.78rem;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    margin-top: 0.3rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.13);
  }
  .positioning {
    max-width: 850px;
    padding: 7rem 0 8rem;
  }
  .positioning h2,
  .section-head h2,
  .ai-copy h2,
  .workflow-intro h2,
  .security-copy h2,
  .closing h2 {
    font-size: clamp(2rem, 4.2vw, 3.55rem);
    line-height: 1.18;
    letter-spacing: 0;
    margin-bottom: 1.3rem;
  }
  .positioning > p:last-child,
  .ai-copy > p,
  .workflow-intro > p:last-child,
  .security-copy > p:last-child,
  .closing > p {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.9;
  }
  .capability-section,
  .ai-section,
  .workflow,
  .security-section,
  .solution-section,
  .articles {
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .text-link {
    flex: 0 0 auto;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
  }
  .capability-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .capability-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0 1rem;
    padding: 2rem 1.5rem 2.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .capability-list li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .capability-list li:nth-child(even) {
    padding-left: 1.5rem;
  }
  .cap-index {
    grid-row: span 2;
    color: var(--home-green);
    font: 700 0.72rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .capability-list h3 {
    font-size: 1.12rem;
    line-height: 1.45;
    margin-bottom: 0.55rem;
  }
  .capability-list p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.86fr) minmax(460px, 1.14fr);
    gap: 4rem;
    align-items: start;
  }
  .ai-copy .text-link {
    display: inline-block;
    margin-top: 0.6rem;
  }
  .ai-grid {
    display: grid;
    gap: 0.9rem;
  }
  .ai-card {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 0 1rem;
    padding: 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .ai-card span {
    grid-row: span 2;
    color: var(--tone);
    font: 750 0.78rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .ai-card h3 {
    font-size: 1.12rem;
    margin-bottom: 0.55rem;
  }
  .ai-card p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-card.tone-1 { --tone: var(--home-blue); }
  .ai-card.tone-2 { --tone: var(--home-green); }
  .ai-card.tone-3 { --tone: var(--home-amber); }
  .workflow {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(440px, 1.25fr);
    gap: 5rem;
    align-items: center;
  }
  .workflow > * {
    min-width: 0;
  }
  .workflow-map {
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .map-row {
    display: grid;
    gap: 0.8rem;
  }
  .map-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .map-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }
  .map-items span {
    display: grid;
    min-height: 54px;
    place-items: center;
    color: var(--ink-soft);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 650;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .outputs .map-items {
    grid-template-columns: repeat(3, 1fr);
  }
  .outputs .map-items span {
    color: var(--home-green);
    background: color-mix(in srgb, var(--home-green) 8%, var(--surface));
    border-color: color-mix(in srgb, var(--home-green) 25%, var(--line));
  }
  .connector {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.7rem;
    align-items: center;
    margin: 1rem 0;
    color: var(--muted);
  }
  .connector span {
    height: 1px;
    background: var(--line);
  }
  .connector b {
    font-size: 0.64rem;
    font-weight: 650;
  }
  .object-layer {
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem;
    color: white;
    background: #12352c;
    border-radius: 4px;
    text-align: center;
  }
  .object-layer small {
    color: #8ee3c2;
    font: 650 0.58rem/1.4 var(--font-mono);
  }
  .object-layer strong {
    font-size: 0.88rem;
  }
  .security-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(460px, 1.2fr);
    gap: 4rem;
    align-items: start;
  }
  .security-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .security-item {
    min-height: 230px;
    padding: 1.45rem;
    background: var(--surface);
  }
  .security-item span {
    display: block;
    width: 28px;
    height: 4px;
    margin-bottom: 2.2rem;
    background: var(--home-green);
  }
  .security-item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.65rem;
  }
  .security-item p {
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.72;
    margin-bottom: 0;
  }
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .solution {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .solution:hover {
    transform: translateY(-3px);
    border-color: var(--tone);
  }
  .solution.green { --tone: var(--home-green); }
  .solution.blue { --tone: var(--home-blue); }
  .solution.amber { --tone: var(--home-amber); }
  .solution-mark {
    width: 34px;
    height: 5px;
    margin-bottom: auto;
    background: var(--tone);
  }
  .solution h3 {
    font-size: 1.35rem;
    margin-bottom: 0.65rem;
  }
  .solution p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 1.4rem;
  }
  .solution-link {
    color: var(--tone);
    font-size: 0.76rem;
    font-weight: 700;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .article {
    color: var(--ink);
    text-decoration: none;
  }
  .article img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: 1rem;
    border-radius: 4px;
    background: var(--surface-sunk);
  }
  .article time {
    color: var(--muted);
    font: 600 0.68rem/1 var(--font-mono);
  }
  .article h3 {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0.65rem 0 0.4rem;
  }
  .article p {
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .closing {
    margin-top: 7rem;
    padding: 5rem;
    color: white;
    background: #172b26;
    border-radius: 6px;
  }
  .closing .section-kicker {
    color: #8ee3c2;
  }
  .closing > p {
    color: #bdc9c5;
  }
  .button.light {
    margin-top: 1rem;
    color: #172b26;
    background: white;
  }
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
    }
    .hero-copy {
      max-width: 680px;
    }
    .workflow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .ai-section,
    .security-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
    .solution:last-child {
      grid-column: span 2;
      min-height: 240px;
    }
  }
  .home.lang-de .hero h1,
  .home.lang-fr .hero h1,
  .home.lang-es .hero h1 {
    font-size: clamp(2.8rem, 4vw, 4rem);
  }
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2.7rem;
    }
    .home.lang-de .hero h1,
    .home.lang-fr .hero h1,
    .home.lang-es .hero h1 {
      font-size: 2.25rem;
    }
    .hero-media img {
      aspect-ratio: 4 / 3;
    }
    .media-note {
      display: none;
    }
    .proof {
      gap: 0.5rem;
    }
    .positioning,
    .capability-section,
    .ai-section,
    .workflow,
    .security-section,
    .solution-section,
    .articles {
      padding: 3.75rem 0;
    }
    .section-head {
      display: block;
    }
    .section-head .text-link {
      display: inline-block;
      margin-top: 1.25rem;
    }
    .capability-list {
