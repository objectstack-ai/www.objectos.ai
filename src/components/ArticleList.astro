---
import { getPostGroups, entryFor, articleHasTerm } from '../lib/posts';
import { ui, postPath, STATUS_COLOR, type Locale } from '../lib/i18n';
import { termBySlug, termLabel, type TermGroup } from '../lib/terms';

interface Props {
  locale: Locale;
  filter?: { group: TermGroup; slug: string } | null;
}
const { locale, filter = null } = Astro.props;
const t = ui[locale];

const groups = await getPostGroups();

const activeTerm = filter ? termBySlug(filter.slug) : null;
const shown = activeTerm
  ? groups.filter((g) => articleHasTerm(entryFor(g, locale).data, activeTerm))
  : groups;

const heroTitle = activeTerm ? activeTerm.label[locale] : t.articlesTitle;
---

<section class="hero">
  <h1>{heroTitle}</h1>
  <p class="lead">{t.articlesLead(shown.length)}</p>
</section>

{
  shown.length === 0 ? (
    <p class="empty">{t.empty}</p>
  ) : (
    <ul class="grid">
      {shown.map((g) => {
        const entry = entryFor(g, locale);
        const d = entry.data;
        return (
          <li>
            <a class="card" href={postPath(entry.id)}>
              <div class="thumb">
                {d.cover ? (
                  <img src={d.cover.src} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="thumb-fallback">
                    <span class="fmark">◆</span>
                    <span class="ftopic">{termLabel(d.topic, locale)}</span>
                  </div>
                )}
              </div>
              <div class="body">
                <div class="top">
                  <span class="pill" style={`--c:${STATUS_COLOR[d.status]}`}>
                    {t.status[d.status]}
                  </span>
                  <time>{d.date.toISOString().slice(0, 10)}</time>
                </div>
                <h2>{d.title}</h2>
                <p class="desc">{d.description}</p>
                <div class="facets">
                  <span class="facet topic">{termLabel(d.topic, locale)}</span>
                  <span class="facet">{termLabel(d.audience, locale)}</span>
                  {(d.solutions ?? []).map((slug) => (
                    <span class="facet">{termLabel(slug, locale)}</span>
                  ))}
                  {(d.industries ?? []).map((slug) => (
                    <span class="facet">{termLabel(slug, locale)}</span>
                  ))}
                  {d.tags.map((tag) => (
                    <span class="facet tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .hero {
    margin-bottom: 2.25rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
  }
  .hero .lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .empty {
    color: var(--ink-soft);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    box-shadow: 0 10px 30px -14px rgba(28, 25, 23, 0.28);
    transform: translateY(-2px);
  }

  .thumb {
    aspect-ratio: 16 / 10;
    background: var(--surface-sunk);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: color-mix(in srgb, var(--accent) 50%, var(--muted));
  }
  .thumb-fallback .fmark {
    font-size: 1.7rem;
    opacity: 0.45;
  }
  .thumb-fallback .ftopic {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.25rem 1.3rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }
  .top time {
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .card h2 {
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 0.4rem;
    transition: color 0.18s ease;
  }
  .card:hover h2 {
    color: var(--accent);
  }
  .desc {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .facets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .facet {
    font-size: 0.72rem;
    color: var(--ink-soft);
    background: var(--surface-sunk);
    padding: 0.12rem 0.5rem;
    border-radius: 5px;
    white-space: nowrap;
  }
  .facet.topic {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .facet.tag {
    color: var(--muted);
    background: transparent;
    padding: 0.12rem 0.35rem;
  }
  .facet.tag::before {
    content: '#';
    opacity: 0.6;
  }
</style>
