---
import { getPostsInLocale } from '../lib/posts';
import { blogPath, formatDate, pricingPath, postPath, type Locale } from '../lib/i18n';
import { homeCopy } from '../lib/home';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { clusterCopy } from '../lib/cluster-i18n';
import { marketingPagePath } from '../content-pages/registry';
import VideoEmbed from './VideoEmbed.astro';

// The 90-second overview. Same video and same channel as the docs site
// homepage — these URLs are identical in every locale.
const OVERVIEW_VIDEO_ID = 'CX_FlOoOtr0';
const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@objectstack';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const lineJoin = locale === 'zh-Hans' || locale === 'zh-Hant' || locale === 'ja' ? '' : ' ';
const productTourHref = marketingPagePath(locale, 'product-tour');
const templatesHref = `${marketingPagePath(locale, 'templates')}#catalog`;
const agentDeveloperHref = marketingPagePath(locale, 'agent-developer');
const trustCenterHref = marketingPagePath(locale, 'trust-center');

// Capability and AI cards deep-link into the capability pages. Index-based:
// every locale translates the same arrays in the same order.
const capabilityCardHrefs = [
  marketingPagePath(locale, 'data-modeling'),
  marketingPagePath(locale, 'data-modeling'),
  productTourHref,
  marketingPagePath(locale, 'permissions'),
];
const aiCardHrefs = [
  marketingPagePath(locale, 'ai'),
  marketingPagePath(locale, 'ai'),
  marketingPagePath(locale, 'mcp'),
];
const posts = (await getPostsInLocale(locale))
  .filter((post) => post.entry.data.status !== 'archived')
  .slice(0, 3);

const topicLink = (slug: string) => {
  const term = termBySlug(slug);
  return term ? termHref(locale, term) : `/${locale}/`;
};

const templateLinks = [
  {
    href: templatesHref,
    tone: 'green',
  },
  {
    href: templatesHref,
    tone: 'blue',
  },
  {
    href: templatesHref,
    tone: 'amber',
  },
];
const insightTerms = [
  'app-building',
  'integration-data',
  'governance',
  'crm',
  'manufacturing',
]
  .map((slug) => termBySlug(slug))
  .filter(Boolean);
const clusterLinks = CLUSTERS;
const compareLinks = [
  { slug: 'airtable-omni-vs-governed-ai-app-platform', tone: 'green' },
  { slug: 'retool-vs-ai-native-app-platform', tone: 'blue' },
  { slug: 'is-lovable-safe-for-production', tone: 'amber' },
];

const coverSrc = (cover: unknown): string =>
  typeof cover === 'string'
    ? cover
    : (cover as { src?: string })?.src ?? '';
---

<div class:list={['home', `lang-${locale}`]}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> {copy.eyebrow}</p>
      <h1>{copy.hero[0]}<br />{lineJoin}<strong>{copy.hero[1]}</strong></h1>
      <p class="hero-lead">{copy.heroLead}</p>
      <div class="hero-actions">
        <a class="button primary" href={pricingPath(locale)}>{copy.primaryCta} <span>→</span></a>
        <a class="button secondary" href={productTourHref}>{copy.secondaryCta}</a>
        <a class="button secondary" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">YouTube</a>
      </div>
      <dl class="proof">
        {copy.proof.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="overview-video" aria-label={copy.videoCaption}>
    <figure>
      <VideoEmbed
        videoId={OVERVIEW_VIDEO_ID}
        title={copy.videoCaption}
        poster="/images/objectstack-overview-poster.svg"
        playLabel={copy.videoPlayLabel}
      />
      <figcaption>
        <span class="video-name">{copy.videoCaption}</span>
        <a class="text-link" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
          {copy.videoMoreLink} <span aria-hidden="true">→</span>
        </a>
      </figcaption>
    </figure>
  </section>

  <section class="positioning" aria-label={copy.positioningKicker}>
    <p class="section-kicker">{copy.positioningKicker}</p>
    <h2>{copy.positioningTitle[0]}<br />{lineJoin}{copy.positioningTitle[1]}</h2>
    <p class="positioning-copy">{copy.positioningCopy}</p>
    {/* The product diagram used to open the hero. The overview video is the
        page's first visual now, so this sits below it, illustrating the
        positioning it belongs to. */}
    <div class="hero-media">
      <img
        src="/images/objectos-home-hero.png"
        alt={copy.imageAlt}
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
      />
      <div class="media-note">
        <span class="live-dot"></span>
        <span><strong>{copy.imageNoteTitle}</strong>{copy.imageNote}</span>
      </div>
    </div>
  </section>

  <section class="capability-section" id="capabilities">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.capabilitiesKicker}</p>
        <h2>{copy.capabilitiesTitle[0]}<br />{lineJoin}{copy.capabilitiesTitle[1]}</h2>
      </div>
      <a class="text-link" href={agentDeveloperHref}>{copy.capabilitiesLink} <span>→</span></a>
    </div>
    <ol class="capability-list">
      {copy.capabilities.map((item, index) => (
        <li>
          <span class="cap-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={capabilityCardHrefs[index] ?? productTourHref}>
              {item.title} <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="ai-section" id="ai">
    <div class="ai-copy">
      <p class="section-kicker">{copy.aiKicker}</p>
      <h2>{copy.aiTitle[0]}<br />{lineJoin}{copy.aiTitle[1]}</h2>
      <p>{copy.aiCopy}</p>
      <a class="text-link" href={agentDeveloperHref}>{copy.aiLink} <span>→</span></a>
    </div>
    <div class="ai-grid">
      {copy.aiItems.map((item, index) => (
        <div class:list={['ai-card', `tone-${index + 1}`]}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={aiCardHrefs[index] ?? productTourHref}>
              {item.title} <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="workflow">
    <div class="workflow-intro">
      <p class="section-kicker">{copy.workflowKicker}</p>
      <h2>{copy.workflowTitle[0]}<br />{lineJoin}{copy.workflowTitle[1]}</h2>
      <p>{copy.workflowCopy}</p>
    </div>
    <div class="workflow-map" aria-label={copy.workflowKicker}>
      <div class="map-row">
        <span class="map-label">{copy.existingSystems}</span>
        <div class="map-items">
          {copy.systemLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
      <div class="connector"><span></span><b>{copy.connectModel}</b><span></span></div>
      <div class="object-layer">
        <small>OBJECTSTACK DEFINITION LAYER</small>
        <strong>{copy.objectLayer}</strong>
      </div>
      <div class="connector"><span></span><b>{copy.secureExecution}</b><span></span></div>
      <div class="map-row outputs">
        <span class="map-label">{copy.outcomes}</span>
        <div class="map-items">
          {copy.outcomeLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="security-section" id="security">
    <div class="security-copy">
      <p class="section-kicker">{copy.securityKicker}</p>
      <h2>{copy.securityTitle[0]}<br />{lineJoin}{copy.securityTitle[1]}</h2>
      <p>{copy.securityCopy}</p>
      <a class="text-link" href={trustCenterHref}>{copy.securityLink} <span>→</span></a>
    </div>
    <div class="security-grid">
      {copy.securityItems.map((item) => (
        <div class="security-item">
          <span></span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="solution-section" id="templates">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.solutionsKicker}</p>
        <h2>{copy.solutionsTitle[0]}<br />{lineJoin}{copy.solutionsTitle[1]}</h2>
      </div>
    </div>
    <div class="solution-grid">
      {copy.solutions.map((solution, index) => (
        <a
          class:list={['solution', templateLinks[index].tone]}
          href={templateLinks[index].href}
        >
          <span class="solution-mark"></span>
          <h3>{solution.title}</h3>
          <p>{solution.copy}</p>
          <span class="solution-link">{copy.solutionLink} →</span>
        </a>
      ))}
    </div>
  </section>

  {/* id="compare" is a nav contract: the header's "Why ObjectOS" item links here. */}
  <section class="solution-section" id="compare">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.compareKicker}</p>
        <h2>{copy.compareTitle[0]}<br />{lineJoin}{copy.compareTitle[1]}</h2>
      </div>
      <a class="text-link" href={blogPath(locale)}>{copy.compareLink} <span>→</span></a>
    </div>
    <div class="solution-grid">
      {copy.comparisons.map((c, index) => (
        <a
          class:list={['solution', compareLinks[index].tone]}
          href={postPath(locale, compareLinks[index].slug)}
        >
          <span class="solution-mark"></span>
          <h3>{c.title}</h3>
          <p>{c.copy}</p>
          <span class="solution-link">{copy.compareLink} →</span>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="articles">
      <div class="section-head">
        <div>
          <p class="section-kicker">{copy.insightsKicker}</p>
          <h2>{copy.insightsTitle}</h2>
        </div>
        <a class="text-link" href={blogPath(locale)}>{copy.insightsLink} <span>→</span></a>
      </div>
      <nav class="insight-links" aria-label={copy.insightsTitle}>
        {insightTerms.map((term) => (
          <a href={termHref(locale, term!)}>
            {termLabel(term!.slug, locale)}
          </a>
        ))}
      </nav>
      {clusterLinks.length > 0 && (
        <nav class="cluster-links" aria-label="Topic clusters">
          {clusterLinks.map((cluster) => (
            <a href={clusterPath(locale, cluster.slug)}>{clusterCopy(cluster, locale).shortTitle}</a>
          ))}
        </nav>
      )}
      <div class="article-grid">
        {posts.map((post) => (
          <a class="article" href={postPath(locale, post.slug)}>
            {post.entry.data.cover && (
              <img
                src={coverSrc(post.entry.data.cover)}
                alt={post.entry.data.title}
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <time datetime={post.entry.data.date.toISOString().slice(0, 10)}>
                {formatDate(locale, post.entry.data.date)}
              </time>
              <h3>{post.entry.data.title}</h3>
              <p>{post.entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="closing">
    <p class="section-kicker">{copy.closingKicker}</p>
    <h2>{copy.closingTitle}</h2>
    <p>{copy.closingCopy}</p>
    <a class="button light" href={topicLink('integration-data')}>{copy.closingCta} <span>→</span></a>
  </section>
</div>

<style>
  .home {
    --home-green: #057a58;
    --home-blue: #3157d8;
    --home-amber: #b7791f;
    --home-red: #bd4b4b;
    --panel-shadow: 0 22px 58px -42px rgba(var(--shadow), 0.62);
  }
  .home :global(h1),
  .home :global(h2),
  .home :global(h3),
  .home :global(p) {
    margin-top: 0;
  }
  .home :global(h1),
  .home :global(h2) {
    font-family: var(--font-display);
    font-weight: 760;
  }
  /* Single column since the overview video took over as the page's opening
     visual: the copy block runs full width and the video sits directly under
     it. No `min-height` floor here on purpose — the old one reserved a
     viewport's worth of space for the side image and would now do nothing but
     push the video below the fold. */
  .hero {
    padding: 0.5rem 0 2.5rem;
  }
  .hero-copy {
    min-width: 0;
    max-width: 760px;
  }
  .eyebrow,
  .section-kicker {
    color: var(--home-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.35rem;
    overflow-wrap: anywhere;
  }
  .eyebrow span {
    width: 26px;
    height: 1px;
    background: currentColor;
  }
  .hero h1 {
    font-size: clamp(3.1rem, 5.4vw, 5rem);
    line-height: 1.01;
    letter-spacing: 0;
    margin-bottom: 1.4rem;
  }
  .hero h1 strong {
    display: block;
    color: color-mix(in srgb, var(--home-green) 88%, var(--ink));
    font-weight: inherit;
    font-size: 0.9em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
    max-width: 35rem;
    margin-bottom: 1.8rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.32) inset;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button.primary {
    color: white;
    background: linear-gradient(135deg, #151a17, #24483b);
    box-shadow: 0 18px 34px -24px rgba(5, 122, 88, 0.75);
  }
  .button.secondary {
    border-color: var(--line);
    background: var(--surface);
    box-shadow: 0 12px 30px -26px rgba(var(--shadow), 0.45);
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2.25rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .proof div {
    display: flex;
    flex-direction: column;
  }
  .proof dt {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .proof dd {
    color: var(--muted);
    font-size: 0.75rem;
    margin: 0.1rem 0 0;
  }
  .hero-media {
    position: relative;
    isolation: isolate;
    margin-top: 3rem;
  }
  .hero-media::before {
    content: '';
    position: absolute;
    inset: -18px 22px 28px -20px;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--home-green) 28%, transparent);
    border-radius: 8px;
  }
  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    border-radius: 8px;
    box-shadow: 0 34px 86px -48px rgba(19, 78, 58, 0.78);
  }
  .media-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    max-width: 250px;
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.75rem 0.85rem;
    color: #292524;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 8px;
    box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.4);
    font-size: 0.72rem;
    line-height: 1.5;
    backdrop-filter: blur(12px);
  }
  .media-note strong {
    display: block;
    font-size: 0.78rem;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    margin-top: 0.3rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.13);
  }
  /* The 90-second overview — the first thing under the hero, above every
     other section. Sized so its top edge clears the fold on a laptop. */
  .overview-video {
    max-width: 940px;
    margin: 0 auto;
  }
  .overview-video figure {
    margin: 0;
  }
  .overview-video figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.15rem;
    margin-top: 0.95rem;
    font-size: 0.85rem;
  }
  .video-name {
    color: var(--ink-soft);
    font-weight: 650;
  }
  .positioning {
    max-width: 850px;
    padding: 7rem 0 8rem;
    position: relative;
  }
  .positioning::before {
    content: '';
    display: block;
    width: 96px;
    height: 5px;
    margin-bottom: 2.4rem;
    background: linear-gradient(90deg, var(--home-green), var(--home-blue), var(--home-amber));
  }
  .positioning h2,
  .section-head h2,
  .ai-copy h2,
  .workflow-intro h2,
  .security-copy h2,
  .closing h2 {
    font-size: clamp(2rem, 4.2vw, 3.55rem);
    line-height: 1.18;
    letter-spacing: 0;
    margin-bottom: 1.3rem;
  }
  .positioning-copy,
  .ai-copy > p,
  .workflow-intro > p:last-child,
  .security-copy > p:last-child,
  .closing > p {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.9;
  }
  .capability-section,
  .ai-section,
  .workflow,
  .security-section,
  .solution-section,
  .articles {
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .text-link {
    flex: 0 0 auto;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    transition: color 0.16s ease, border-color 0.16s ease;
  }
  .text-link:hover {
    color: var(--home-green);
    border-color: var(--home-green);
  }
  .capability-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .capability-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0 1rem;
    padding: 2rem 1.5rem 2.2rem 0;
    border-bottom: 1px solid var(--line);
    transition: background 0.16s ease;
  }
  .capability-list li:hover {
    background: color-mix(in srgb, var(--surface) 42%, transparent);
  }
  .capability-list li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .capability-list li:nth-child(even) {
    padding-left: 1.5rem;
  }
  .cap-index {
    grid-row: span 2;
    color: var(--home-green);
    font: 700 0.72rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .capability-list h3 {
    font-size: 1.12rem;
    line-height: 1.45;
    margin-bottom: 0.55rem;
  }
  .capability-list h3 a,
  .ai-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .capability-list h3 a:hover,
  .ai-card h3 a:hover {
    text-decoration: underline;
  }
  .card-arrow {
    color: var(--accent);
    font-size: 0.85em;
  }
  .capability-list p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.86fr) minmax(460px, 1.14fr);
    gap: 4rem;
    align-items: start;
  }
  .ai-copy .text-link {
    display: inline-block;
    margin-top: 0.6rem;
  }
  .ai-grid {
    display: grid;
    gap: 0.9rem;
  }
  .ai-card {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 0 1rem;
    padding: 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--panel-shadow);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .ai-card:hover {
    border-color: color-mix(in srgb, var(--tone) 36%, var(--line));
    box-shadow: 0 28px 64px -42px color-mix(in srgb, var(--tone) 35%, rgba(var(--shadow), 0.5));
    transform: translateY(-2px);
  }
  .ai-card span {
    grid-row: span 2;
    color: var(--tone);
    font: 750 0.78rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .ai-card h3 {
    font-size: 1.12rem;
    margin-bottom: 0.55rem;
  }
  .ai-card p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-card.tone-1 { --tone: var(--home-blue); }
  .ai-card.tone-2 { --tone: var(--home-green); }
  .ai-card.tone-3 { --tone: var(--home-amber); }
  .workflow {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(440px, 1.25fr);
    gap: 5rem;
    align-items: center;
  }
  .workflow > * {
    min-width: 0;
  }
  .workflow-map {
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
