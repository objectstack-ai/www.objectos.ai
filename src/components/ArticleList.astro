---
import { getPostsInLocale, articleHasTerm } from '../lib/posts';
import { ui, type Locale } from '../lib/i18n';
import { termBySlug, termDescription, type TermGroup } from '../lib/terms';
import ArticleCard from './ArticleCard.astro';

interface Props {
  locale: Locale;
  filter?: { group: TermGroup; slug: string } | null;
}
const { locale, filter = null } = Astro.props;
const t = ui[locale];

// Only posts that exist in this locale — untranslated ones don't appear.
const posts = await getPostsInLocale(locale);

const activeTerm = filter ? termBySlug(filter.slug) : null;
const shown = activeTerm
  ? posts.filter((p) => articleHasTerm(p.entry.data, activeTerm))
  : posts;

const heroTitle = activeTerm ? activeTerm.label[locale] : t.articlesTitle;
const heroLead = activeTerm
  ? termDescription(activeTerm, locale)
  : t.articlesLead(shown.length);

// The four "start here" picks; the first renders as the feature card. The
// `recommendedLead` strings below describe exactly these four, in this order:
// the pillar definition post, who owns the business definition layer, and the
// two posts on why AI-built apps are governable and changeable only as
// metadata rather than generated code.
const featuredSlugs = [
  'what-does-the-ontology-is-the-software-mean',
  'enterprise-ontology-race-open-vs-closed',
  'metadata-not-code-generation',
  'vibe-coding-technical-debt-2026',
];
const isBlogHome = !activeTerm;
const featured = isBlogHome
  ? featuredSlugs
      .map((slug) => shown.find((post) => post.slug === slug))
      .filter(Boolean)
  : [];
const featuredSet = new Set(featured.map((post) => post!.slug));
const latest = isBlogHome ? shown.filter((post) => !featuredSet.has(post.slug)) : shown;
const homeCopy: Record<Locale, {
  recommendedTitle: string;
  recommendedLead: string;
  latestTitle: string;
  latestLead: string;
}> = {
  en: {
    recommendedTitle: 'Recommended',
    recommendedLead: 'Start here: what "the ontology is the software" means, who should own the business definition layer, and why AI-built apps stay governable as metadata, not generated code.',
    latestTitle: 'Latest Articles',
    latestLead: 'New writing from the ObjectOS blog.',
  },
  'zh-Hans': {
    recommendedTitle: '推荐文章',
    recommendedLead: '从这几篇读起：「本体即软件」是什么意思、业务定义层该归谁所有，以及 AI 生成的应用为什么是元数据而非代码才可治理、可改。',
    latestTitle: '最新文章',
    latestLead: '按发布时间浏览 ObjectOS 的最新内容。',
  },
  'zh-Hant': {
    recommendedTitle: '推薦文章',
    recommendedLead: '從這幾篇讀起：「本體即軟體」是什麼意思、業務定義層該歸誰所有，以及 AI 生成的應用為什麼是後設資料而非程式碼才可治理、可改。',
    latestTitle: '最新文章',
    latestLead: '按發布時間瀏覽 ObjectOS 的最新內容。',
  },
  ja: {
    recommendedTitle: 'おすすめ記事',
    recommendedLead: 'まずはここから：「オントロジーがソフトウェアである」とはどういう意味か、業務定義層は誰が所有すべきか、AI が作ったアプリはなぜコードではなくメタデータならガバナンスでき変えられるのか。',
    latestTitle: '最新記事',
    latestLead: 'ObjectOS ブログの新着記事です。',
  },
  de: {
    recommendedTitle: 'Empfohlen',
    recommendedLead: 'Hier anfangen: was „Die Ontologie ist die Software“ bedeutet, wem die Geschäftsdefinitionsschicht gehören sollte, und warum AI-gebaute Apps als Metadaten statt Code änderbar bleiben.',
    latestTitle: 'Neueste Artikel',
    latestLead: 'Aktuelle Beiträge aus dem ObjectOS Blog.',
  },
  es: {
    recommendedTitle: 'Recomendados',
    recommendedLead: 'Empieza por aquí: qué significa «La ontología es el software», de quién debe ser la capa de definición del negocio, y por qué las apps hechas con AI se gobiernan como metadatos, no como código.',
    latestTitle: 'Artículos Recientes',
    latestLead: 'Publicaciones recientes del blog de ObjectOS.',
  },
  fr: {
    recommendedTitle: 'Recommandés',
    recommendedLead: 'Commencez ici : ce que signifie « L’ontologie est le logiciel », à qui doit appartenir la couche de définition du métier, et pourquoi les apps écrites par l’AI restent gouvernables en métadonnées, pas en code.',
    latestTitle: 'Articles Récents',
    latestLead: 'Les dernières publications du blog ObjectOS.',
  },
  ko: {
    recommendedTitle: '추천 글',
    recommendedLead: '여기서부터: 「온톨로지가 곧 소프트웨어다」가 무슨 뜻인지, 비즈니스 정의 계층은 누가 소유해야 하는지, AI가 만든 앱이 왜 코드가 아니라 메타데이터여야 바꿀 수 있는지.',
    latestTitle: '최신 글',
    latestLead: 'ObjectOS 블로그의 최신 글입니다.',
  },
};
const c = homeCopy[locale];
---

<section class="hero">
  <h1>{heroTitle}</h1>
  <p class="lead">{heroLead}</p>
</section>

{
  shown.length === 0 ? (
    <p class="empty">{t.empty}</p>
  ) : isBlogHome ? (
    <>
      {featured.length > 0 && (
        <section class="section-block recommended" aria-labelledby="recommended-title">
          <div class="section-head">
            <p class="kicker">{c.recommendedTitle}</p>
            <h2 id="recommended-title">{c.recommendedTitle}</h2>
            <p>{c.recommendedLead}</p>
          </div>
          <ul class="featured-grid">
            {featured.map((post, index) => (
              <ArticleCard
                post={post!}
                {locale}
                variant={index === 0 ? 'feature' : 'standard'}
              />
            ))}
          </ul>
        </section>
      )}
      <section class="section-block latest" aria-labelledby="latest-title">
        <div class="section-head compact">
          <p class="kicker">{c.latestTitle}</p>
          <h2 id="latest-title">{c.latestTitle}</h2>
          <p>{c.latestLead}</p>
        </div>
        <ul class="grid">
          {latest.map((post) => (
            <ArticleCard {post} {locale} />
          ))}
        </ul>
      </section>
    </>
  ) : (
    <ul class="grid">
      {shown.map((post) => (
        <ArticleCard {post} {locale} />
      ))}
    </ul>
  )
}

<style>
  .hero {
    position: relative;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .hero::before {
    content: '';
    display: block;
    width: 78px;
    height: 5px;
    margin-bottom: 1.4rem;
    background: linear-gradient(90deg, #057a58, var(--accent), #b7791f);
    border-radius: 999px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: 0;
    margin: 0 0 0.5rem;
  }
  .hero .lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .empty {
    color: var(--ink-soft);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .section-block {
    margin-top: 2.4rem;
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 1rem;
  }
  .section-head .kicker {
    margin: 0 0 0.25rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: 0;
    margin: 0;
  }
  .section-head p:last-child {
    color: var(--ink-soft);
    margin: 0.45rem 0 0;
    line-height: 1.65;
  }
  /* The feature gets a row of its own and the other three share the next.
     It used to span three rows beside them, but three stacked cards (~1470px)
     are more than twice the feature's own content (~670px), so the feature
     card stretched with an ~800px band between its description and tags. Its
     horizontal layout lives in ArticleCard (`.feature`). */
  .featured-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  .featured-grid :global(.feature) {
    grid-column: 1 / -1;
  }
  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hero {
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-size: 2rem;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .hero .lead {
      font-size: 0.98rem;
      line-height: 1.65;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }
    .section-block {
      margin-top: 1.8rem;
    }
    .section-head.compact {
      display: block;
    }
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }
  }
</style>
