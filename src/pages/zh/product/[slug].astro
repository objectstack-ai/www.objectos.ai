---
import Base from '../../../layouts/Base.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { getUsedProducts } from '../../../lib/posts';
import { productLabel, type ProductSlug } from '../../../lib/products';
import { ui } from '../../../lib/i18n';

export async function getStaticPaths() {
  const items = await getUsedProducts();
  return items.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: ProductSlug };
const label = productLabel(slug, 'zh-Hans');
---

<Base
  title={`${label} · ${ui['zh-Hans'].siteName}`}
  description={`${label} —— 构建 AI-native 软件的文章。`}
  locale="zh-Hans"
  enHref={`/product/${slug}`}
  zhHref={`/zh/product/${slug}`}>
  <ArticleList locale="zh-Hans" activeProduct={slug} />
</Base>
