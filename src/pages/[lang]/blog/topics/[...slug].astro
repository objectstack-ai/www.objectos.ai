---
import Base from '../../../../layouts/Base.astro';
import ArticleList from '../../../../components/ArticleList.astro';
import { getAllUsedTerms } from '../../../../lib/posts';
import { termBySlug, termSlugPath, termHref, type Term } from '../../../../lib/terms';
import { ui, localeSeg, LOCALES, type Locale } from '../../../../lib/i18n';

export async function getStaticPaths() {
  // Group each used term by the locales it has content in.
  const byTerm = new Map<string, { term: Term; locales: Locale[] }>();
  for (const locale of LOCALES) {
    for (const term of await getAllUsedTerms(locale)) {
      const e = byTerm.get(term.slug) ?? { term, locales: [] };
      e.locales.push(locale);
      byTerm.set(term.slug, e);
    }
  }
  const paths = [];
  for (const { term, locales } of byTerm.values()) {
    const alternates = Object.fromEntries(
      locales.map((l) => [l, termHref(l, term)])
    );
    for (const locale of locales) {
      paths.push({
        params: { lang: localeSeg(locale), slug: termSlugPath(term) },
        props: { group: term.group, slug: term.slug, locale, alternates },
      });
    }
  }
  return paths;
}

const { group, slug, locale, alternates } = Astro.props;
const term = termBySlug(slug)!;
const t = ui[locale];
---

<Base
  title={`${term.label[locale]} · ${t.siteName}`}
  description={term.label[locale]}
  {locale}
  {alternates}>
  <ArticleList {locale} filter={{ group, slug }} />
</Base>
