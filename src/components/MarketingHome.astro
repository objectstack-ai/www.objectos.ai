---
import { Image } from 'astro:assets';
import demoPoster from '../assets/objectos-home-demo-poster.png';
import demoVideo from '../assets/objectos-home-demo.mp4';
import demoScript from '../assets/objectos-home-demo.js?url&no-inline';
import { getPostsInLocale } from '../lib/posts';
import { darkCover } from '../lib/cover-variant';
import { blogPath, formatDate, postPath, pricingPath, securityPath, ui, type Locale } from '../lib/i18n';
import { s2t } from '../lib/zhconvert';
import { homeCopy } from '../lib/home';
import { CLOUD_SIGNUP_URL, heroLineJoin, OBJECTSTACK_URL, positioning, YOUTUBE_CHANNEL_URL } from '../lib/positioning';
import { CONTACT_URL } from '../lib/contact';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { clusterCopy } from '../lib/cluster-i18n';
import { marketingPagePath } from '../content-pages/registry';
import VideoEmbed from './VideoEmbed.astro';

// The 90-second overview. Same video and same channel as the docs site
// homepage — these URLs are identical in every locale.
const OVERVIEW_VIDEO_ID = 'CX_FlOoOtr0';
// The words on the video poster, drawn as HTML over the artwork (see
// VideoEmbed.astro). The title is this locale's video caption, which every
// locale already has, split after the product name: "ObjectStack" over "in 90
// Seconds", "90 秒总览", "を 90 秒で" (a leading particle stays on line one).
// The eyebrow and the sub-line are this locale's `videoPosterEyebrow` and
// `videoPosterNote` from `homeCopy` (see the interface note there).

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
// The one protocol link on the page: E1 names the three ObjectOS editions in
// the editions block (#411), and this link, right under E1, says what they are
// built on and sends the developer to objectstack.ai. Nothing else on the home
// page links that site.
const protocolLink = positioning[locale].protocol;
const posterSplit = copy.videoCaption.match(/^(ObjectStack(?: [\u3040-\u309f]+)?) (.+)$/u);
const posterTitle: [string, string] = posterSplit ? [posterSplit[1], posterSplit[2]] : [copy.videoCaption, ''];
// The H1 is T1 on one line, its full stop dropped and its trailing phrase
// emphasised; `positioning.ts` asserts the two parts rejoin to T1 minus that
// stop with exactly this joiner, so the rule lives there and nowhere here.
const lineJoin = heroLineJoin(locale);
// Headings in zh and ja carry a <wbr> between phrases (scripts/lib/cjk-phrases.mjs)
// and break nowhere else; the copy itself is unchanged.
const ph = (text: string): string => phraseHtml(text, locale);
const productTourHref = marketingPagePath(locale, 'product-tour');
const templatesHref = `${marketingPagePath(locale, 'templates')}#catalog`;
const agentDeveloperHref = marketingPagePath(locale, 'agent-developer');
const securityHref = securityPath(locale);
const ontologyHref = marketingPagePath(locale, 'ontology');
const compareHref = marketingPagePath(locale, 'compare');
const mcpHref = marketingPagePath(locale, 'mcp');
const pricingHref = pricingPath(locale);

// Capability and AI cards deep-link into the capability pages. Index-based:
// every locale translates the same arrays in the same order. The two
// capability cards (business model, federation) both land on /data-modeling/;
// the AI cards land on the AI page's Ask section (Ask, and the record edits
// Ask proposes) and its Build section.
const capabilityCardHrefs = [marketingPagePath(locale, 'data-modeling'), marketingPagePath(locale, 'data-modeling')];
const aiHref = marketingPagePath(locale, 'ai');
const aiCardHrefs = [`${aiHref}#ask`, `${aiHref}#ask`, `${aiHref}#build`];
for (const [name, cards, hrefs] of [
  ['capabilities', copy.capabilities, capabilityCardHrefs],
  ['aiItems', copy.aiItems, aiCardHrefs],
] as const) {
  if (cards.length !== hrefs.length) {
    throw new Error(`homeCopy[${locale}].${name} has ${cards.length} cards; MarketingHome links ${hrefs.length}`);
  }
}
// `coverDark`: an SVG cover's dark variant (src/lib/cover-variant.ts); the
// card then draws both images, lazy, one shown per theme.
const posts = (await getPostsInLocale(locale))
  .filter((post) => post.entry.data.status !== 'archived')
  .slice(0, 3)
  .map((post) => ({ ...post, coverDark: darkCover(post.entry.filePath, post.entry.data.cover) }));

// The three scenario cards, in `homeCopy.useCases` order: service, finance &
// procurement, sales — the /use-cases/ sections whose scenarios have both a
// post and a template or guide behind them (#359 ruling).
const useCasesHref = marketingPagePath(locale, 'use-cases');
const useCaseHrefs = ['service', 'finance-procurement', 'sales'].map((id) => `${useCasesHref}#${id}`);
if (useCaseHrefs.length !== copy.useCases.length) {
  throw new Error(`homeCopy[${locale}].useCases has ${copy.useCases.length} cards; MarketingHome links ${useCaseHrefs.length}`);
}
// The topic hubs in the insights row. `crm` and `manufacturing` are not here:
// the row also carries the five guides (CLUSTERS), and "CRM & case
// management" and "Manufacturing AI" are among them (#411).
const insightTerms = ['app-building', 'integration-data', 'governance']
  .map((slug) => termBySlug(slug))
  .filter(Boolean);
// The three "vs" chips land on the comparison page's product-by-product
// section, where each named product has its post; the section's text link
// goes to the page itself.
const compareInDepthHref = `${compareHref}#in-depth`;

// A raster post cover is served as WebP at the card's width, not as the
// 1.5-1.9 MB original: one of three columns (about 345px) on a desktop, one of
// two at 641-900px, the full column on a phone. The widest candidate covers
// the phone column at 3x. An SVG cover is a few KB and is served as is.
const ARTICLE_WIDTHS = [360, 540, 720, 1080];
const ARTICLE_SIZES = '(max-width: 640px) calc(100vw - 2rem), (max-width: 900px) calc(50vw - 2rem), 360px';
// The 30-second run recording at the foot of the "how it connects" block: one definition
// boots, an agent creates a record over MCP, a read-only identity is refused.
// It is the objectstack README's own recording
// (objectstack-ai/objectstack `docs/screenshots/readme-demo.gif`, git blob
// 2575202e, 1200x675, 486 KiB), re-encoded rather than shipped as a GIF:
//   ffmpeg -i readme-demo.gif -an -vf "fps=25,crop=1200:674:0:0,format=yuv420p" \
//     -c:v libx264 -preset veryslow -tune animation -crf 34 -g 250 \
//     -profile:v high -movflags +faststart -map_metadata -1 objectos-home-demo.mp4
// H.264 needs an even height, so the GIF's last (background) row is cropped.
// The MP4 is 250 KiB; VP9 WebM at the same legibility came out larger
// (264 KiB at crf 46), so there is no WebM source. The poster is the GIF's
// beat-three frame (the refusal), cropped the same way.
//
// Neither image nor video is fetched until it nears the viewport: the poster is a
// lazy WebP <Image> under the video, and `objectos-home-demo.js`
// gives the video its source and plays it only once it is near the viewport
// and the reader allows motion. Under `prefers-reduced-motion: reduce` the
// video is never loaded and the poster is what shows; the toggle still lets
// the reader start it. The box is the recording's own 1200:674, as width and
// height attributes and as a CSS aspect ratio, so nothing moves when it loads.
// It is at most 850px wide (the positioning column), the page width less the
// gutters on a phone.
const DEMO_WIDTH = 1200;
const DEMO_HEIGHT = 674;
const DEMO_POSTER_WIDTHS = [480, 720, 960, 1200];
const DEMO_POSTER_SIZES = '(min-width: 898px) 850px, calc(100vw - 2.4rem)';
// The recording's text alternative, and the toggle's two labels. Spelled here
// rather than in `homeCopy` (src/lib/home.ts) only because this change is
// scoped to this component; zh-Hant is generated from zh-Hans, as homeCopy
// does it. The three beats follow the README's alt text for the GIF.
const DEMO_COPY_HANS = {
  alt: '一段 30 秒的真实运行录屏，分三步。一：Team 对象的类型化定义在一个全新数据库上启动，Console 列出已有团队。二：一个 Agent 用管理员的 API Key 通过 MCP 调用 create_record，新的 Data Guild 记录出现在 Console 中，创建人是 Dev Admin。三：同一个调用改用只读的 Auditor Key 发送，被权限错误拒绝，Console 里仍然只有三行。',
  pause: '暂停录屏',
  play: '播放录屏',
};
const DEMO_COPY: Record<Locale, { alt: string; pause: string; play: string }> = {
  en: {
    alt: "A 30-second recording of a real run, in three beats. One: the Team object's typed definition boots on a fresh database, and the Console lists its teams. Two: an agent sends an MCP create_record call with the admin's API key; the new Data Guild record appears in the Console, created by Dev Admin. Three: the same call, sent with a read-only Auditor key, is refused with a permission error, and the Console still shows three rows.",
    pause: 'Pause the recording',
    play: 'Play the recording',
  },
  'zh-Hans': DEMO_COPY_HANS,
  'zh-Hant': { alt: s2t(DEMO_COPY_HANS.alt), pause: s2t(DEMO_COPY_HANS.pause), play: s2t(DEMO_COPY_HANS.play) },
  ja: {
    alt: '実際の実行を収めた 30 秒の録画で、3 つの場面からなります。1：Team オブジェクトの型付き定義が新しいデータベース上で起動し、Console にチームが一覧表示されます。2：エージェントが管理者の API キーで MCP の create_record を呼び出し、新しい Data Guild レコードが Dev Admin の作成として Console に表示されます。3：同じ呼び出しを読み取り専用の Auditor キーで送ると権限エラーで拒否され、Console は 3 行のままです。',
    pause: '録画を一時停止',
    play: '録画を再生',
  },
  de: {
    alt: 'Eine 30-Sekunden-Aufnahme eines echten Laufs in drei Schritten. Eins: Die typisierte Definition des Team-Objekts startet auf einer frischen Datenbank, und die Console listet die Teams. Zwei: Ein Agent sendet mit dem API-Schlüssel des Admins einen MCP-Aufruf create_record; der neue Datensatz Data Guild erscheint in der Console, erstellt von Dev Admin. Drei: Derselbe Aufruf mit einem schreibgeschützten Auditor-Schlüssel wird mit einem Berechtigungsfehler abgelehnt, und die Console zeigt weiterhin drei Zeilen.',
    pause: 'Aufnahme anhalten',
    play: 'Aufnahme abspielen',
  },
  es: {
    alt: 'Una grabación de 30 segundos de una ejecución real, en tres pasos. Uno: la definición tipada del objeto Team arranca sobre una base de datos nueva y la Console lista sus equipos. Dos: un agente envía una llamada MCP create_record con la clave de API del administrador; el nuevo registro Data Guild aparece en la Console, creado por Dev Admin. Tres: la misma llamada, enviada con una clave de Auditor de solo lectura, se rechaza con un error de permisos y la Console sigue mostrando tres filas.',
    pause: 'Pausar la grabación',
    play: 'Reproducir la grabación',
  },
  fr: {
    alt: 'Un enregistrement de 30 secondes d’une exécution réelle, en trois temps. Un : la définition typée de l’objet Team démarre sur une base de données neuve et la Console liste ses équipes. Deux : un agent envoie un appel MCP create_record avec la clé d’API de l’administrateur ; le nouvel enregistrement Data Guild apparaît dans la Console, créé par Dev Admin. Trois : le même appel, envoyé avec une clé Auditor en lecture seule, est refusé avec une erreur de permission, et la Console affiche toujours trois lignes.',
    pause: 'Mettre l’enregistrement en pause',
    play: 'Lire l’enregistrement',
  },
  ko: {
    alt: '실제 실행을 담은 30초 녹화로, 세 단계로 구성됩니다. 하나: Team 객체의 타입 정의가 새 데이터베이스에서 부팅되고 Console에 팀 목록이 표시됩니다. 둘: 에이전트가 관리자의 API 키로 MCP create_record 호출을 보내면, 새 Data Guild 레코드가 Dev Admin이 만든 것으로 Console에 나타납니다. 셋: 같은 호출을 읽기 전용 Auditor 키로 보내면 권한 오류로 거부되고, Console에는 여전히 세 행만 남습니다.',
    pause: '녹화 일시정지',
    play: '녹화 재생',
  },
};
const demoCopy = DEMO_COPY[locale];
---

<div class:list={['home', `lang-${locale}`]}>
  {/* One flat flex column, deliberately: the video, the lead and the CTA row
      have to be siblings for the phone layout to order them with CSS `order`
      alone. Duplicating the hero markup per breakpoint would be a worse
      defect than the one the reorder fixes.

      The first screen is one sentence and one action: eyebrow (the three
      editions' short name), h1 (T1), the category line (#392: what the
      product is, in a business reader's words), lead (T2), the CTA row; then
      the video, then the proof chips. E1 and the protocol link that sat under the CTA
      row moved to the editions block (#411). Before the hero split (#335)
      the lead ran T2, T4 and E1 together (523 characters in en) and the CTA
      row started at 619px on a 1366×625 laptop and at 1114px on a 390px
      phone. */}
  <section class="hero">
    <p class="eyebrow"><span></span> <Fragment set:html={ph(copy.eyebrow)} /></p>
    <h1><span set:html={ph(copy.hero[0])} />{lineJoin}<strong set:html={ph(copy.hero[1])} /></h1>
    <p class="hero-category" set:html={ph(copy.heroCategory)} />
    {/* The lead takes the headings' phrase <wbr> in zh and ja: at 17px,
        centred, one to two lines, a break inside a word (运/行时, ひと/つ)
        read as an error where body text would not. */}
    <p class="hero-lead" set:html={ph(copy.heroLead)} />
    <div class="hero-actions">
      <a class="btn btn-primary" href={CLOUD_SIGNUP_URL}>{copy.primaryCta} <span>→</span></a>
      <a class="btn btn-secondary" href={productTourHref}>{copy.secondaryCta}</a>
    </div>
    <figure class="hero-video">
      <VideoEmbed
        videoId={OVERVIEW_VIDEO_ID}
        title={copy.videoCaption}
        poster="/images/objectstack-overview-poster-art.svg"
        playLabel={copy.videoPlayLabel}
        posterText={{
          eyebrow: copy.videoPosterEyebrow,
          title: posterTitle,
          note: copy.videoPosterNote,
        }}
      />
      <figcaption>
        <span class="video-name">{copy.videoCaption}</span>
        <a class="btn btn-ghost" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
          {copy.videoMoreLink} <span aria-hidden="true">→</span>
        </a>
      </figcaption>
    </figure>
    <dl class="proof">
      {copy.proof.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}
    </dl>
  </section>

  {/* "How business teams use it" (#359): the block that held three template
      cards now holds three scenario cards, each landing on its team's section
      of /use-cases/; the templates catalog stays one link away, under the
      cards. The old #templates anchor is kept on the section for existing
      deep links. */}
  <section class="solution-section" id="templates">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.useCasesKicker}</p>
        <h2><span class="title-line" set:html={ph(copy.useCasesTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.useCasesTitle[1])} /></h2>
      </div>
      <a class="btn btn-ghost" href={useCasesHref}>{copy.useCasesLink} <span>→</span></a>
    </div>
    <div class="solution-grid">
      {copy.useCases.map((useCase, index) => (
        <a class="solution card card-link" href={useCaseHrefs[index]}>
          <span class="solution-mark"></span>
          <h3>{useCase.title}</h3>
          <p>{useCase.copy}</p>
          <span class="solution-link">{copy.useCaseCardLink}&nbsp;→</span>
        </a>
      ))}
    </div>
    <p class="solution-more"><a class="btn btn-ghost" href={templatesHref}>{copy.useCasesTemplatesLink} <span>→</span></a></p>
  </section>

  {/* AI in the product (#411): three cards in business terms, one note
      carrying the Enterprise preview label (#410), and MCP as the block's
      one developer link rather than a card. */}
  <section class="ai-section" id="ai">
    <div class="ai-copy">
      <p class="section-kicker">{copy.aiKicker}</p>
      <h2><span class="title-line" set:html={ph(copy.aiTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.aiTitle[1])} /></h2>
      <p class="ai-note">{copy.aiNote}</p>
      <a class="btn btn-ghost" href={mcpHref}>{copy.aiDeveloperLink} <span aria-hidden="true">→</span></a>
    </div>
    <div class="ai-grid">
      {copy.aiItems.map((item, index) => (
        <div class="ai-card card card-link">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={aiCardHrefs[index] ?? productTourHref}>
              {item.title}&nbsp;<span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  {/* How it connects to what you run (#411): the positioning block, the
      definition-layer diagram, capability cards 01–02 and the run recording,
      merged. The positioning copy is the one statement of the mechanism; the
      diagram has no body text, and the cards that restated it are gone. The
      id is the old capability section's, kept for existing deep links. */}
  <section class="workflow connect" id="capabilities" aria-labelledby="connect-title">
    <div class="workflow-intro">
      <p class="section-kicker">{copy.connectKicker}</p>
      <h2 id="connect-title"><span class="title-line" set:html={ph(copy.positioningTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.positioningTitle[1])} /></h2>
      <p class="positioning-copy">{copy.positioningCopy}</p>
      <a class="btn btn-ghost positioning-link" href={ontologyHref}>{copy.positioningLink} <span aria-hidden="true">→</span></a>
    </div>
    <div class="workflow-map card" aria-label={copy.connectKicker}>
      <div class="map-row">
        <span class="map-label">{copy.existingSystems}</span>
        <div class="map-items">
          {copy.systemLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
      <div class="connector"><span></span><b>{copy.connectModel}</b><span></span></div>
      <div class="object-layer">
        <small>OBJECTSTACK DEFINITION LAYER</small>
        <strong>{copy.objectLayer}</strong>
      </div>
      <div class="connector"><span></span><b>{copy.secureExecution}</b><span></span></div>
      <div class="map-row outputs">
        <span class="map-label">{copy.outcomes}</span>
        <div class="map-items">
          {copy.outcomeLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
    </div>
    <ol class="capability-list">
      {copy.capabilities.map((item, index) => (
        <li>
          <span class="cap-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={capabilityCardHrefs[index] ?? productTourHref}>
              {item.title}&nbsp;<span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
    {/* The run recording. The overview video is the page's first visual, so
        this sits at the foot of this block, showing the definition layer it
        describes working. The poster image carries the text alternative; the video over it is
        the same content in motion, so it is hidden from assistive tech. The
        pause/play toggle sits beside the caption, not over the recording,
        and stays `hidden` until the script runs (no script, no video). */}
    <figure class="hero-media" data-demo>
      <div class="demo-frame">
        <Image
          src={demoPoster}
          alt={demoCopy.alt}
          widths={DEMO_POSTER_WIDTHS}
          sizes={DEMO_POSTER_SIZES}
          format="webp"
          loading="lazy"
          decoding="async"
        />
        <video
          width={DEMO_WIDTH}
          height={DEMO_HEIGHT}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          data-src={demoVideo}
          aria-hidden="true"
          tabindex="-1"
        ></video>
      </div>
      <figcaption class="demo-bar">
        <button type="button" class="demo-toggle" data-pause-label={demoCopy.pause} data-play-label={demoCopy.play} aria-label={demoCopy.play} hidden>
          <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M8 5.14v13.72a1 1 0 0 0 1.52.86l11.14-6.86a1 1 0 0 0 0-1.72L9.52 4.28A1 1 0 0 0 8 5.14Z" fill="currentColor" />
          </svg>
          <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" />
          </svg>
        </button>
        <span class="media-note">
          <span class="live-dot"></span>
          <span><strong>{copy.imageNoteTitle}</strong>{copy.imageNote}</span>
        </span>
      </figcaption>
    </figure>
  </section>

  <section class="security-section" id="security">
    <div class="security-copy">
      <p class="section-kicker">{copy.securityKicker}</p>
      <h2><span class="title-line" set:html={ph(copy.securityTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.securityTitle[1])} /></h2>
      <p>{copy.securityCopy}</p>
      <a class="btn btn-ghost" href={securityHref}>{copy.securityLink} <span>→</span></a>
    </div>
    <div class="security-grid card-grid">
      {copy.securityItems.map((item) => (
        <div class="security-item">
          <span></span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  {/* Editions and comparison (#411): E1, the one place it is on the page,
      with the pricing link and the protocol link under it, then the three
      comparison cards. id="compare" is the home page's own comparison section. Nav contract: the
      header's "Why ObjectOS" item points at /compare/, the full comparison page
      (five comparisons, the not-for list and the FAQ), not at this anchor; the
      id stays for in-page links and for the existing /#compare deep links. */}
  <section class="solution-section" id="compare">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.compareKicker}</p>
        <h2><span class="title-line" set:html={ph(copy.compareTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.compareTitle[1])} /></h2>
      </div>
      <a class="btn btn-ghost" href={compareHref}>{copy.compareLink} <span>→</span></a>
    </div>
    {/* E1 and the protocol link beside it (src/lib/positioning.ts): the
        three editions, then what they are built on. Nothing else on the
        home page links objectstack.ai. */}
    <div class="editions">
      <p class="editions-copy">{copy.editionsCopy}</p>
      <p class="editions-links">
        <a class="btn btn-ghost" href={pricingHref}>{copy.editionsPricingLink} <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={OBJECTSTACK_URL}>{protocolLink} <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <div class="solution-grid">
      {copy.comparisons.map((c) => (
        <a class="solution card card-link" href={compareInDepthHref}>
          <span class="solution-mark"></span>
          <h3>{c.title}</h3>
          <p>{c.copy}</p>
          <span class="solution-link">{copy.compareLink}&nbsp;→</span>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="articles">
      <div class="section-head">
        <div>
