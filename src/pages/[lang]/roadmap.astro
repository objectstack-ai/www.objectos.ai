---
import Base from '../../layouts/Base.astro';
import RoadmapPage from '../../components/RoadmapPage.astro';
import { roadmapCopy, roadmapSnapshot } from '../../lib/roadmap';
import { fallbackRoute, sourceLocaleByIdentity } from '../../lib/fallback';
import { LOCALES, roadmapPath, segToLocale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = roadmapCopy[locale];
// ja/de/es/fr/ko render the English copy: noindexed, canonical to
// /en/roadmap/, and absent from hreflang (src/lib/fallback.ts). The footer's
// Resources column links it after Changelog; the header does not (maintainer
// ruling on cloud#3887, 2026-11-08).
const route = fallbackRoute(locale, sourceLocaleByIdentity(roadmapCopy), roadmapPath);
---

<Base
  title={copy.title}
  description={copy.description}
  {locale}
  contentLocale={route.sourceLocale}
  canonical={route.canonical}
  noindex={route.isFallback}
  alternates={route.alternates}
  navAlternates={route.navAlternates}>
  <RoadmapPage {copy} locale={route.sourceLocale} snapshot={roadmapSnapshot} />
</Base>
