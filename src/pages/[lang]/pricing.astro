---
import Base from '../../layouts/Base.astro';
import Pricing from '../../components/Pricing.astro';
import { fallbackRoute, sourceLocaleByIdentity } from '../../lib/fallback';
import { LOCALES, segToLocale, pricingPath, refundsPath } from '../../lib/i18n';
import { pricingCopy } from '../../lib/pricing';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = pricingCopy[locale];
// ja/de/es/fr/ko render the English copy: noindexed, canonical to /en/pricing/,
// and absent from hreflang (src/lib/fallback.ts).
const route = fallbackRoute(locale, sourceLocaleByIdentity(pricingCopy), pricingPath);
---

<Base
  title={`${copy.title} · ObjectOS`}
  description={copy.description}
  {locale}
  contentLocale={route.sourceLocale}
  canonical={route.canonical}
  noindex={route.isFallback}
  alternates={route.alternates}
  navAlternates={route.navAlternates}>
  <Pricing {copy} refundsHref={refundsPath(locale)} />
</Base>
