---
import Base from '../../layouts/Base.astro';
import SecurityPage from '../../components/SecurityPage.astro';
import { LOCALES, securityPath, segToLocale } from '../../lib/i18n';
import { securityCopy } from '../../lib/security';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = securityCopy[locale];
const alternates = Object.fromEntries(LOCALES.map((language) => [language, securityPath(language)]));
---

<Base title={copy.title} description={copy.description} {locale} {alternates}>
  <SecurityPage {copy} {locale} />
</Base>
