---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getUsedProducts } from '../../lib/posts';
import { productLabel, type ProductSlug } from '../../lib/products';
import { ui } from '../../lib/i18n';

export async function getStaticPaths() {
  const items = await getUsedProducts();
  return items.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: ProductSlug };
const label = productLabel(slug, 'en');
---

<Base
  title={`${label} · ${ui.en.siteName}`}
  description={`${label} — articles on building AI-native software.`}
  locale="en"
  enHref={`/product/${slug}`}
  zhHref={`/zh/product/${slug}`}>
  <ArticleList locale="en" activeProduct={slug} />
</Base>
