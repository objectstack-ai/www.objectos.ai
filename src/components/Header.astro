---
import {
  ui,
  blogPath,
  homePath,
  pricingPath,
  securityPath,
  LOCALES,
  LANG_NATIVE,
  type Locale,
} from '../lib/i18n';
import { getUsedTerms } from '../lib/posts';
import { termHref, groupMeta, type TermGroup } from '../lib/terms';
import { marketingPagePath } from '../content-pages/registry';
import { glossaryIndexPath } from '../glossary/registry';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { clusterCopy } from '../lib/cluster-i18n';
import {
  CLOUD_SIGNIN_URL,
  CLOUD_SIGNUP_URL,
  GITHUB_REPO_URL,
  OBJECTSTACK_URL,
  YOUTUBE_CHANNEL_URL,
} from '../lib/positioning';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  /** Real per-locale equivalents — the hreflang set. */
  alternates?: Partial<Record<Locale, string>>;
  /**
   * Where the language switcher should send a reader, which is not the same
   * question as hreflang. A page type with a fallback design (marketing,
   * glossary) has real URLs in every locale — they render English content,
   * canonicalized and noindexed — and the switcher should take the reader to
   * the same page in the locale they picked. hreflang must still list only the
   * authored locales, so the two maps differ. Defaults to `alternates`, which
   * is right for page types with no fallback (blog, topics).
   */
  navAlternates?: Partial<Record<Locale, string>>;
  /**
   * A blog article. Its browse row (All articles / Topics / Audience / Industry)
   * scrolls away with the page instead of sticking under the bar: on an
   * article it filters nothing, and sticking cost a 390x844 phone 47px of
   * reading height on top of the bar's 59.
   */
  article?: boolean;
}

const { locale, alternates = {}, navAlternates, article = false } = Astro.props;
const switcherTargets = navAlternates ?? alternates;
const t = ui[locale];
const pathname = Astro.url.pathname;

const homeHref = homePath(locale);
const blogHref = blogPath(locale);
const pricingHref = pricingPath(locale);
const ontologyHref = marketingPagePath(locale, 'ontology');
const productTourHref = marketingPagePath(locale, 'product-tour');
const platformHref = marketingPagePath(locale, 'platform');
const aiHref = marketingPagePath(locale, 'ai');
const mcpHref = marketingPagePath(locale, 'mcp');
const dataModelingHref = marketingPagePath(locale, 'data-modeling');
const appUiHref = marketingPagePath(locale, 'app-ui');
const automationHref = marketingPagePath(locale, 'automation');
const approvalsHref = marketingPagePath(locale, 'approvals');
const permissionsHref = marketingPagePath(locale, 'permissions');
const analyticsHref = marketingPagePath(locale, 'analytics');
const trustCenterHref = marketingPagePath(locale, 'trust-center');
const agentGuideHref = marketingPagePath(locale, 'agent-developer');
const templatesHref = marketingPagePath(locale, 'templates');
const storiesHref = marketingPagePath(locale, 'customer-stories');
const useCasesHref = marketingPagePath(locale, 'use-cases');
const aiAdoptionHref = marketingPagePath(locale, 'enterprise-ai-adoption');
const glossaryHref = glossaryIndexPath(locale);
const compareHref = marketingPagePath(locale, 'compare');
const securityHref = securityPath(locale);

// Two documentation sites, labelled by role: docs.objectos.ai documents the
// product, objectstack.ai (`OBJECTSTACK_URL`) is the developer site — the open
// protocol, SDK, CLI and docs that every ObjectOS edition is built on.
const DOCS_URL = 'https://docs.objectos.ai';
const DEVELOPERS_URL = OBJECTSTACK_URL;

const inBlog = pathname.startsWith(`/${locale}/blog`);
const onBlogHome = pathname === blogHref;
const inPricing = pathname === pricingHref;
const inGlossary = pathname.startsWith(glossaryHref);

// `aria-current` for an active link: "page" when the link is this very page,
// "true" when it is the section the page sits in (a glossary term under
// Glossary, a paged topic hub under its topic).
const current = (active: boolean, href: string) =>
  active ? (pathname === href ? 'page' : 'true') : undefined;

// Language switcher targets. A blog page that names its per-locale equivalents
// but has none in some locale (an article not translated into it) sends the
// reader to that locale's blog, not its home page, and marks the option
// unavailable. Every other page type either names all eight locales (its
// fallback design) or names none (the 404s), and keeps the home-page fallback.
const namesAlternates = Object.keys(switcherTargets).length > 0;
const langOptions = LOCALES.map((l) => {
  const href = switcherTargets[l];
  const unavailable = !href && inBlog && namesAlternates && l !== locale;
  return {
    locale: l,
    href: href ?? (unavailable ? blogPath(l) : homePath(l)),
    unavailable,
    note: unavailable ? t.siteNav.langUnavailable(LANG_NATIVE[l]) : undefined,
  };
});

// Primary nav model — one source of truth for both the desktop dropdowns and
// the mobile drawer, so they can never drift apart. A group with more than one
// section renders as a multi-column mega panel on desktop and as labeled
// subsections inside the drawer accordion.
type NavItem = { label: string; href: string; external?: boolean; active: boolean };
type NavSection = { label?: string; items: NavItem[] };
type NavGroup = { id: string; label: string; active: boolean; sections: NavSection[] };

// An entry is active on its own page (`aria-current="page"`) and on the pages
// folded under it (`aria-current="true"`, the section the page sits in): the
// Capabilities list went from eight entries to five, so app interfaces folds
// under data & apps and approvals under automation & approvals; permissions,
// like the trust center, is a sub-section of the security hub. A folded page
// keeps its URL and is linked from its parent page and from the footer.
const under = (parent: string, ...folded: string[]) =>
  pathname === parent || folded.includes(pathname);

const evaluateItems: NavItem[] = [
  { label: t.siteNav.ontology, href: ontologyHref, active: pathname === ontologyHref },
  { label: t.siteNav.productTour, href: productTourHref, active: pathname === productTourHref },
  { label: t.siteNav.platform, href: platformHref, active: pathname === platformHref },
];

// Why ObjectOS: the evaluation pages. The comparison page (not the home
// page's `#compare` section: from any other page that anchor landed a reader
// seven screens down the home page); the one trust entry (/security/ is the
// hub; the trust center and the permissions page are its sub-sections,
// SecurityPage.astro links both); the reference stories; the use cases by
// business team (#359: a fourth item here, not a sixth top-level item, which
// overlapped the bar's controls at 1100px in de, es and fr); and the
// organisation-level adoption page (#369: a fifth item — the panel is an
// absolute dropdown, so an item adds panel height, never bar width).
const whyItems: NavItem[] = [
  { label: t.siteNav.compareFit, href: compareHref, active: pathname === compareHref },
  { label: t.siteNav.security, href: securityHref, active: under(securityHref, trustCenterHref, permissionsHref) },
  { label: t.siteNav.referenceStories, href: storiesHref, active: pathname === storiesHref },
  { label: t.siteNav.useCases, href: useCasesHref, active: pathname === useCasesHref },
  { label: t.siteNav.aiAdoption, href: aiAdoptionHref, active: pathname === aiAdoptionHref },
];

// The five pillar guides: the labelled second column of the Resources panel.
// They have no index page, so the label is a label, not a link.
const guideItems: NavItem[] = CLUSTERS.map((cluster) => {
  const href = clusterPath(locale, cluster.slug);
  return { label: clusterCopy(cluster, locale).shortTitle, href, active: pathname === href };
});

const capabilityItems: NavItem[] = [
  { label: t.siteNav.capDataApps, href: dataModelingHref, active: under(dataModelingHref, appUiHref) },
  { label: t.siteNav.capAutomationApprovals, href: automationHref, active: under(automationHref, approvalsHref) },
  { label: t.siteNav.aiBuildAsk, href: aiHref, active: pathname === aiHref },
  { label: t.siteNav.toolsMcp, href: mcpHref, active: pathname === mcpHref },
  { label: t.siteNav.capAnalytics, href: analyticsHref, active: pathname === analyticsHref },
];

const groups: NavGroup[] = [
  {
    id: 'product',
    label: t.siteNav.product,
    active: evaluateItems.some((it) => it.active) || capabilityItems.some((it) => it.active),
    sections: [
      { label: t.siteNav.groupEvaluate, items: evaluateItems },
      { label: t.siteNav.groupCapabilities, items: capabilityItems },
    ],
  },
  {
    id: 'why',
    label: t.siteNav.whyObjectOs,
    active: whyItems.some((it) => it.active),
    sections: [{ items: whyItems }],
  },
  {
    id: 'developers',
    label: t.siteNav.developers,
    active: pathname === agentGuideHref || pathname === templatesHref,
    sections: [
      {
        items: [
          { label: t.siteNav.startWithAgent, href: agentGuideHref, active: pathname === agentGuideHref },
          { label: t.siteNav.productDocs, href: DOCS_URL, external: true, active: false },
          { label: t.siteNav.developerDocs, href: DEVELOPERS_URL, external: true, active: false },
          { label: t.siteNav.templates, href: templatesHref, active: pathname === templatesHref },
          // The brand name is not translated.
          { label: 'GitHub', href: GITHUB_REPO_URL, external: true, active: false },
        ],
      },
    ],
  },
  {
    id: 'resources',
    label: t.siteNav.resources,
    // The blog (its index, hubs and articles), the glossary and the guides.
    active: inBlog || inGlossary || guideItems.some((it) => it.active),
    sections: [
      {
        items: [
          { label: t.siteNav.blog, href: blogHref, active: inBlog },
          { label: t.siteNav.glossary, href: glossaryHref, active: inGlossary },
          { label: t.siteNav.videos, href: YOUTUBE_CHANNEL_URL, external: true, active: false },
        ],
      },
      { label: t.siteNav.guides, items: guideItems },
    ],
  },
];

// Blog browse axes (in-page filter, blog context only). Solution axis is
// intentionally omitted — that area is not ready to surface in navigation.
const AXES: TermGroup[] = ['topic', 'role', 'industry'];
const menus = (
  await Promise.all(
    AXES.map(async (group) => {
      const terms = (await getUsedTerms(group, locale)).filter((term) => !term.parent);
      const active = terms.some((term) => pathname.startsWith(termHref(locale, term)));
      return { group, terms, active };
    })
  )
).filter((m) => m.terms.length > 0);
---

<header class:list={['site-header', { 'blog-context': inBlog }]}>
  <div class="bar">
    <a class="wordmark" href={homeHref}>
      <Logo size={22} class="logo" />
      <span class="name" translate="no">{t.siteName}</span>
    </a>

    <nav class="site-nav" aria-label={t.siteNav.primaryNav}>
      {
        groups.map((g) => (
          <div class="menu" data-menu>
            <button
              type="button"
              class:list={['menu-trigger', { active: g.active }]}
              aria-expanded="false"
              aria-controls={`menu-${g.id}`}
              data-menu-trigger>
              {g.label}
              <span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class:list={['menu-panel', { mega: g.sections.length > 1 }]} id={`menu-${g.id}`}>
              {g.sections.map((s) => (
                <div class="menu-col">
                  {s.label && <span class="menu-col-label">{s.label}</span>}
                  {s.items.map((it) => (
                    <a
                      class:list={['menu-item', { active: it.active }]}
                      href={it.href}
                      aria-current={current(it.active, it.href)}
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}>
                      {it.label}
                      {it.external && <span class="ext" aria-hidden="true">↗</span>}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <a class:list={['navlink', { active: inPricing }]} href={pricingHref} aria-current={inPricing ? 'page' : undefined}>
        {t.footer.pricing}
      </a>
    </nav>

    <div class="bar-right">
      <button
        type="button"
        class="iconbtn bar-desktop"
        data-theme-toggle
        aria-label={t.siteNav.toggleTheme}
        title={t.siteNav.toggleTheme}>
        <span class="moon" aria-hidden="true">☾</span>
        <span class="sun" aria-hidden="true">☀</span>
      </button>

      <div class="menu langmenu bar-desktop" data-menu>
        <button
          type="button"
          class="lang-trigger"
          aria-expanded="false"
          aria-controls="menu-lang"
          aria-label={`${t.siteNav.languagePrefix}${LANG_NATIVE[locale]}`}
          title={`${t.siteNav.languagePrefix}${LANG_NATIVE[locale]}`}
          data-menu-trigger>
          <span class="globe" aria-hidden="true">🌐</span>
          <span class="lang-cur native">{LANG_NATIVE[locale]}</span>
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="menu-panel lang-panel" id="menu-lang">
          {
            langOptions.map((o) => (
              <a
                class:list={['menu-item', { active: o.locale === locale, unavailable: o.unavailable }]}
                href={o.href}
                aria-label={o.note}
                title={o.note}
                data-lang={o.locale}>
                {LANG_NATIVE[o.locale]}
              </a>
            ))
          }
        </div>
      </div>

      <a class="signin bar-desktop" href={CLOUD_SIGNIN_URL}>{t.signIn}</a>

      <a class="cta btn btn-primary btn-sm" href={CLOUD_SIGNUP_URL}>{t.getStarted}</a>

      <button
        type="button"
        class="iconbtn hamburger"
        aria-label={t.siteNav.menu}
        aria-expanded="false"
        aria-controls="site-drawer"
        data-drawer-open>
        <svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <line x1="3" y1="6" x2="17" y2="6" />
          <line x1="3" y1="10" x2="17" y2="10" />
          <line x1="3" y1="14" x2="17" y2="14" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- The blog browse row is the header's sibling, not its child, so that it can
     stick under the bar on the blog index and hubs (where it filters the list)
     and scroll away on an article (where it filters nothing). -->
{
  inBlog && menus.length > 0 && (
    <nav class:list={['blognav', { sticky: !article }]} aria-label={t.siteNav.browseNav}>
      <div class="mainnav-inner">
        <a
          class:list={['nav-link', { active: onBlogHome }]}
          href={blogHref}
          aria-current={onBlogHome ? 'page' : undefined}>
          {t.backToList}
        </a>
        {menus.map((m) => (
          <div class="menu" data-menu>
            <button
              type="button"
              class:list={['menu-trigger', { active: m.active }]}
              aria-expanded="false"
              aria-controls={`menu-axis-${m.group}`}
              data-menu-trigger>
              {groupMeta(m.group).label[locale]}
              <span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class="menu-panel" id={`menu-axis-${m.group}`}>
              {m.terms.map((term) => (
                <a
                  class:list={[
                    'menu-item',
                    { active: pathname.startsWith(termHref(locale, term)) },
                  ]}
                  href={termHref(locale, term)}
                  aria-current={current(pathname.startsWith(termHref(locale, term)), termHref(locale, term))}>
                  {term.label[locale]}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </nav>
  )
}

<!-- Mobile drawer: every destination lives here, so nothing is unreachable on
     small screens (including the primary sections from a blog article). -->
<div class="drawer" id="site-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label={t.siteNav.menu}>
    <div class="drawer-head">
      <span class="drawer-title">{t.siteNav.menu}</span>
      <button type="button" class="iconbtn drawer-close" aria-label={t.siteNav.close} data-drawer-close>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <line x1="5" y1="5" x2="15" y2="15" />
          <line x1="15" y1="5" x2="5" y2="15" />
        </svg>
      </button>
    </div>

    <nav class="drawer-nav" aria-label={t.siteNav.mobileNav}>
      {
        groups.map((g) => (
          <details class="drawer-group" open={g.active}>
            <summary>
              {g.label}
              <span class="caret" aria-hidden="true">▾</span>
            </summary>
            <div class="drawer-links">
              {g.sections.map((s) => (
                <>
                  {s.label && <span class="drawer-sec-label">{s.label}</span>}
                  {s.items.map((it) => (
                    <a
                      class:list={['drawer-link', { active: it.active }]}
                      href={it.href}
                      aria-current={current(it.active, it.href)}
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}>
                      {it.label}
                      {it.external && <span class="ext" aria-hidden="true">↗</span>}
                    </a>
                  ))}
                </>
              ))}
            </div>
          </details>
        ))
      }
      <a
        class:list={['drawer-flat', { active: inPricing }]}
        href={pricingHref}
        aria-current={inPricing ? 'page' : undefined}>
        {t.footer.pricing}
      </a>
    </nav>

    <a class="drawer-cta btn btn-primary" href={CLOUD_SIGNUP_URL}>{t.getStarted}</a>
    <a class="drawer-signin" href={CLOUD_SIGNIN_URL}>{t.signIn}</a>

    <div class="drawer-foot">
      <div class="drawer-langs">
        {
          langOptions.map((o) => (
            <a
              class:list={['drawer-lang', { active: o.locale === locale, unavailable: o.unavailable }]}
              href={o.href}
              aria-label={o.note}
              title={o.note}
              data-lang={o.locale}>
              {LANG_NATIVE[o.locale]}
            </a>
          ))
        }
      </div>
      <div class="drawer-utils">
        <button type="button" class="drawer-util" data-theme-toggle>
          <span class="moon" aria-hidden="true">☾</span>
          <span class="sun" aria-hidden="true">☀</span>
          <span class="theme-label">{t.siteNav.theme}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Remember the reader's language choice so `/` redirects there next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', a.dataset.lang || 'en');
      } catch {
        /* ignore */
      }
    });
  });

  // Dark-mode toggle (persisted; default comes from the inline head script).
  // querySelectorAll: there is a toggle in the bar and one in the drawer.
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* ignore */
      }
    });
  });

  // Dropdown menus (nav groups + axes + language) are disclosure widgets, not
  // ARIA menus: a button with aria-expanded/aria-controls shows a panel of
  // plain links, which Tab walks in order. Click to open, single-open; an
  // outside click, focus leaving the menu, or Escape closes it, and Escape
  // hands focus back to the trigger.
  const menus = document.querySelectorAll<HTMLElement>('[data-menu]');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  // A blog-axis panel is position:fixed on a phone (it has to escape the
  // row's horizontal scroller), so it is placed from its trigger. Returns
  // false when the trigger has scrolled up under the bar.
  function placeAxisPanel(menu: HTMLElement): boolean {
    if (!menu.closest('.blognav')) return true;
    const trigger = menu.querySelector('[data-menu-trigger]');
    if (!trigger) return true;
    const bottom = trigger.getBoundingClientRect().bottom;
    if (bottom < (siteHeader?.getBoundingClientRect().bottom ?? 0)) return false;
    menu.style.setProperty('--axis-panel-top', `${Math.round(bottom + 4)}px`);
    return true;
  }
  function closeMenu(m: HTMLElement) {
    m.classList.remove('open');
    m.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
  }
  function closeAll(except?: HTMLElement) {
    menus.forEach((m) => {
      if (m !== except) closeMenu(m);
    });
  }
  menus.forEach((menu) => {
    const trigger = menu.querySelector('[data-menu-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeAll(menu);
      if (open) placeAxisPanel(menu);
    });
    menu.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !menu.contains(next)) closeMenu(menu);
    });
  });
  document.addEventListener('click', () => closeAll());
  // On an article the browse row scrolls with the page: an open axis panel
  // follows its trigger, and closes once the trigger goes under the bar.
  window.addEventListener(
    'scroll',
    () => {
      document.querySelectorAll<HTMLElement>('.blognav:not(.sticky) [data-menu].open').forEach((m) => {
        if (!placeAxisPanel(m)) closeMenu(m);
      });
    },
    { passive: true }
  );

  // Mobile drawer: a modal dialog. Opening moves focus to its close button,
  // makes everything behind it inert, and keeps Tab inside it; closing
  // returns focus to the menu button.
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('.drawer-panel');
  const openBtn = document.querySelector<HTMLElement>('[data-drawer-open]');
  let drawerOpen = false;
  const tabbables = (): HTMLElement[] =>
    panel
      ? [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary')].filter(
          (el) => el.getClientRects().length > 0
        )
      : [];
  function setDrawer(open: boolean, returnFocus = true) {
    if (!drawer || open === drawerOpen) return;
    drawerOpen = open;
    drawer.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    for (const el of document.body.children) {
      if (el !== drawer) (el as HTMLElement).inert = open;
    }
    if (open) tabbables()[0]?.focus();
    else if (returnFocus) openBtn?.focus();
  }
  openBtn?.addEventListener('click', () => setDrawer(true));
  document.querySelectorAll('[data-drawer-close]').forEach((el) =>
    el.addEventListener('click', () => setDrawer(false))
  );
  // Following a link closes the sheet; focus goes where the link leads.
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setDrawer(false, false))
  );
  drawer?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const list = tabbables();
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    const at = document.activeElement;
    if (e.shiftKey && (at === first || !panel?.contains(at))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (at === last || !panel?.contains(at))) {
      e.preventDefault();
      first.focus();
    }
  });
  // The drawer only exists below the desktop breakpoint; widening the window
  // past it must not leave an invisible modal holding the page inert. Keep
  // this width in step with the `max-width: 1099px` query in the styles.
  matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
    if (e.matches) setDrawer(false, false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (drawerOpen) {
      setDrawer(false);
      return;
    }
    const open = [...menus].find((m) => m.classList.contains('open'));
    if (!open) return;
    closeMenu(open);
    if (open.contains(document.activeElement)) {
      open.querySelector<HTMLElement>('[data-menu-trigger]')?.focus();
    }
  });
</script>

