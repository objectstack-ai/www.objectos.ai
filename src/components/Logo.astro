---
// ObjectOS mark — sourced from objectos/apps/docs/public/logo.svg.
// Inlined so it's crisp, needs no extra request, and renders in both themes
// (it carries its own indigo background).
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 44 44"
  fill="none"
  role="img"
  aria-label="ObjectOS">
  <rect width="44" height="44" rx="12" fill="#4F46E5"></rect>
  <g
    transform="translate(10 10)"
    stroke="white"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none">
    <path d="M12 2 2 7l10 5 10-5-10-5Z"></path>
    <path d="m2 17 10 5 10-5"></path>
    <path d="m2 12 10 5 10-5"></path>
  </g>
</svg>
