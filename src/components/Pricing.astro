---
import type { Locale } from '../lib/i18n';
import { planHref, type PricingCopy } from '../lib/pricing';
import { marketingPagePath } from '../content-pages/registry';

interface Props {
  copy: PricingCopy;
  locale: Locale;
  refundsHref: string;
}

const { copy, locale, refundsHref } = Astro.props;

// Two tabs, both in the static HTML, switched by CSS alone — the site CSP
// (public/_headers) admits no new inline script. The switch is two links to
// the empty targets at the top of the section: `#self-hosted` (and only it)
// shows the Self-hosted panel through `:target ~` sibling selectors; any other
// fragment, or none, shows the Cloud panel. So `/pricing/#self-hosted` deep
// links, Back returns to the previous tab, and it works with JavaScript off.
// The targets sit above the title so following a tab link keeps the title in
// view. ARIA tab roles are left out on purpose: `aria-selected` cannot follow a
// CSS-only switch, and a stale state is worse than none. The hidden panel is
// `display: none`, so assistive technology reads only the visible one, and each
// panel opens with a heading naming its tab.
// A feature name too long for one desktop line (about 90 columns, a CJK
// character counting two) may wrap; every other row stays on one line, so
// a long name does not squeeze the column and wrap the rest.
const columns = (text: string): number =>
  [...text].reduce((n, ch) => n + (/[\u2e80-\u9fff\uff00-\uffef]/.test(ch) ? 2 : 1), 0);
const longFeature = (text: string): boolean => columns(text) > 90;

const panels = [
  { key: 'cloud', tab: copy.tabs.cloud },
  { key: 'self', tab: copy.tabs.selfHosted },
] as const;
---

<section class="pricing">
  <span id="cloud" class="tab-target target-cloud"></span>
  <span id="self-hosted" class="tab-target target-self"></span>

  <header>
    <h1>{copy.title}</h1>
  </header>

  {copy.promo && <p class="promo">{copy.promo}</p>}

  <nav class="switch" aria-label={copy.switchLabel}>
    <a class="switch-link switch-cloud" href="#cloud">{copy.tabs.cloud.label}</a>
    <a class="switch-link switch-self" href="#self-hosted">{copy.tabs.selfHosted.label}</a>
  </nav>

  {
    panels.map(({ key, tab }) => (
      <section class:list={['panel', `panel-${key}`]} aria-labelledby={`pricing-${key}-heading`}>
        <h2 class="visually-hidden" id={`pricing-${key}-heading`}>
          {tab.label}
        </h2>
        <p class="intro">{tab.intro}</p>
        <div class:list={['plans', { pair: tab.plans.length === 2 }]}>
          {tab.plans.map((plan) => (
            <article class:list={['plan', 'card', { highlight: plan.highlight }]}>
              <h3>{plan.name}</h3>
              <p class="tagline">{plan.tagline}</p>
              <div class="price-block">
                <p class="price">
                  <span class="amount">{plan.price}</span>
                </p>
                {plan.cadence && <p class="cadence">{plan.cadence}</p>}
                {plan.billedNote && <p class="billed">{plan.billedNote}</p>}
                {plan.altPrice && <p class="alt">{plan.altPrice}</p>}
              </div>
              <div class="cta-block">
                <a class:list={['cta', 'btn', plan.highlight ? 'btn-primary' : 'btn-secondary']} href={planHref(plan, locale)}>
                  {plan.cta}
                </a>
                {plan.secondaryLink && (
                  <a class="secondary-link" href={plan.secondaryLink.href}>
                    {plan.secondaryLink.label}
                  </a>
                )}
              </div>
              <ul>
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <p class="note">{tab.billingNote}</p>
        {tab.comparison && (
          <section class="compare" aria-labelledby={`pricing-${key}-compare`}>
            <h3 class="compare-title" id={`pricing-${key}-compare`}>
              {tab.comparison.title}
            </h3>
            <div class="compare-wrap" tabindex="0" role="group" aria-labelledby={`pricing-${key}-compare`}>
              <table>
                <thead>
                  <tr>
                    <th scope="col">{tab.comparison.featureHeader}</th>
                    <th scope="col">{tab.comparison.communityHeader}</th>
                    <th scope="col">{tab.comparison.enterpriseHeader}</th>
                  </tr>
                </thead>
                {tab.comparison.groups.map((group) => (
                  <tbody>
                    {group.heading && (
                      <tr class="group-heading">
                        <th scope="colgroup" colspan="3">
                          {group.heading}
                        </th>
                      </tr>
                    )}
                    {group.rows.map((row) => (
                      <tr data-row={row.id}>
                        <th scope="row" class:list={{ 'feature-long': longFeature(row.feature) }}>
                          {row.link ? <a href={marketingPagePath(locale, row.link)}>{row.feature}</a> : row.feature}
                        </th>
                        {[row.community, row.enterprise].map((cell) => (
                          <td>
                            {cell.mark === 'yes' && (
                              <>
                                <span class="mark mark-yes" aria-hidden="true">✓</span>
                                <span class="visually-hidden">{tab.comparison!.yesLabel}</span>
                              </>
                            )}
                            {cell.mark === 'no' && (
                              <>
                                <span class="mark mark-no" aria-hidden="true">—</span>
                                <span class="visually-hidden">{tab.comparison!.noLabel}</span>
                              </>
                            )}
                            {cell.mark === 'dev' && <span class="chip">{tab.comparison!.devLabel}</span>}
                            {cell.text && <span class="cell-text">{cell.text}</span>}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
            <h3 class="compare-title roadmap-title" id={`pricing-${key}-roadmap`}>
              {tab.comparison.roadmap.title}
            </h3>
            <div class="compare-wrap roadmap-wrap" tabindex="0" role="group" aria-labelledby={`pricing-${key}-roadmap`}>
              <table>
                <thead>
                  <tr>
                    <th scope="col">{tab.comparison.featureHeader}</th>
                    <th scope="col">{tab.comparison.enterpriseHeader}</th>
                  </tr>
                </thead>
                <tbody>
                  {tab.comparison.roadmap.rows.map((row) => (
                    <tr data-row={row.id}>
                      <th scope="row">{row.feature}</th>
                      <td>
                        <span class="chip">{row.status === 'soon' ? tab.comparison!.soonLabel : tab.comparison!.devLabel}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="compare-footer">
              {tab.comparison.footer} <a href={tab.comparison.footerHref}>{tab.comparison.footerLinkLabel}</a>
            </p>
          </section>
        )}
      </section>
    ))
  }

  <p class="mor">
    {copy.morNote} <a href={refundsHref}>{copy.refundsLabel}</a>.
  </p>
</section>

<style>
  .pricing {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  header {
    text-align: center;
    max-width: var(--measure-lead);
    margin: 0 auto 1.75rem;
  }
  /* The switch's fragment targets: empty, at the top of the section. Their
     scroll margin is taller than the page header above them, so following a
     tab link (or a #self-hosted deep link) scrolls to the very top, with the
     title and the switch in view, instead of jumping by a few pixels. */
  .tab-target {
    display: block;
    height: 0;
    scroll-margin-top: 100vh;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Display face for the page title, as on every page (Base.astro
     --font-display); plan names are card titles and stay in the text face. */
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* The Cloud / Self-hosted switch: a pill of two links on the surface, the
     buttons' type (--fs-14, 700). The active tab takes the brand chip's
     colours (--brand on --brand-soft, Base.astro .chip-brand), the
     site's mark for a selected facet; focus keeps the global --ring. */
  .switch {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.75rem;
    padding: var(--sp-1);
    gap: var(--sp-1);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
  }
  .switch-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.4rem 1.1rem;
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    font-size: var(--fs-14);
    font-weight: 700;
    line-height: var(--lh-ui);
    text-align: center;
    text-decoration: none;
    transition: color 0.16s ease, background 0.16s ease;
  }
  /* Hover changes only the colour to --brand, which the active tab already
     has, so hovering it changes nothing. */
  .switch-link:hover {
    color: var(--brand);
  }
  /* Active tab: Cloud unless the Self-hosted target is the URL fragment. */
  .switch-cloud,
  .target-self:target ~ .switch .switch-self {
    color: var(--brand);
    background: var(--brand-soft);
  }
  .target-self:target ~ .switch .switch-cloud {
    color: var(--ink-soft);
    background: transparent;
  }
  .target-self:target ~ .switch .switch-cloud:hover {
    color: var(--brand);
  }
  .panel-self,
  .target-self:target ~ .panel-cloud {
    display: none;
  }
  .target-self:target ~ .panel-self {
    display: block;
  }
  .intro {
    max-width: var(--measure-lead);
    margin: 0 auto 2rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--fs-17);
  }
  .promo {
    margin: 0 auto 1.75rem;
    max-width: var(--measure-lead);
    text-align: center;
    padding: 0.7rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--brand-soft);
    color: var(--brand);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    font-size: var(--fs-14);
    font-weight: 600;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  /* Both tabs hold two plans: the pair is held to the wide measure, so two
     cards do not each stretch to half the page. */
  .plans.pair {
    max-width: var(--measure-wide);
    margin: 0 auto;
  }
  /* Each card's five parts (name, tagline, price, CTA, features) sit on the
     row's shared tracks, so they start at the same height in every card of a
     row however each card's copy wraps. The fixed min-heights this replaces
     guessed at the longest tagline and price and were outgrown, leaving one
     price 22px low and the CTAs at four different heights. */
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 1.5rem;
  }
  /* The recommended plan: a 2px brand edge, and the badge the copy carries. */
  .plan.highlight {
    border-width: 2px;
    border-color: var(--brand);
    padding: calc(1.5rem - 1px);
  }
  .plan h3 {
    margin: 0;
    font-size: var(--fs-18);
  }
  .tagline {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  /* Tabular figures: the plans' prices sit side by side. */
  .price-block {
    margin: 1rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  .price {
    margin: 0;
  }
  .price .amount {
    font-size: var(--fs-36);
    font-weight: 700;
    letter-spacing: 0;
  }
  .cadence {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .billed {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .alt {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: var(--fs-13);
  }
  /* The CTA row: the button, and an optional text link under it (the
     free Developer Edition on the Enterprise card). */
  .cta-block {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    margin: 1.1rem 0 0;
  }
  .cta {
    display: flex;
  }
  .secondary-link {
    justify-self: center;
    color: var(--brand);
    font-size: var(--fs-14);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .secondary-link:hover {
    color: var(--ink);
  }
  /* The recommended plan's button is the primary (ink) with the brand
     outline, ruled on #340; it was a solid indigo of its own. */
  .plan.highlight .cta {
    border-width: 2px;
    border-color: var(--brand);
  }
  .plan ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* The list's row is as tall as the longest list in the card row. */
    align-content: start;
    gap: 0.55rem;
  }
  .plan li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .note {
    margin: 1.75rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-14);
  }
  /* The Community | ObjectOS Enterprise comparison and the Enterprise
     roadmap under it (Self-hosted tab). Rows are short by ruling (one line
     each at desktop width), so the columns size to their content. Each wrap
     is the only thing that may scroll sideways: at a phone width cells wrap
     inside a 6.5rem floor per column, so three columns fit a 360px phone,
     and if a table ever outgrows its wrap the wrap scrolls, never the page.
     The wraps are focusable and named by their headings, so a keyboard user
     can scroll them too. */
  .compare {
    max-width: 62rem;
    margin: 2.75rem auto 0;
  }
  .compare-title {
    margin: 0 0 1rem;
    font-size: var(--fs-18);
    text-align: center;
  }
  .roadmap-title {
    margin-top: 2.25rem;
    font-size: var(--fs-16);
  }
  .compare-wrap {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .roadmap-wrap {
    max-width: var(--measure-prose);
    margin: 0 auto;
  }
  .compare table {
    width: 100%;
    border-collapse: collapse;
  }
  .compare th,
  .compare td {
    box-sizing: border-box;
    min-width: 6.5rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
    overflow-wrap: break-word;
  }
  .compare thead th {
    color: var(--muted);
    font-size: var(--fs-13);
    font-weight: 700;
  }
  .compare tbody th {
    color: var(--ink);
    font-weight: 600;
  }
  .compare td {
    color: var(--ink-soft);
  }
  .compare tbody:last-child tr:last-child > * {
    border-bottom: none;
  }
  .compare tbody th a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .compare tbody th a:hover {
    color: var(--brand);
  }
  .mark {
    display: inline-block;
    min-width: 1.1em;
    font-weight: 700;
  }
  .mark-yes {
    color: var(--green);
  }
  .mark-no {
    color: var(--muted);
  }
  .mark + .visually-hidden + .cell-text {
    margin-left: 0.25rem;
  }
  /* A group's sub-heading row: "In both editions", "Enterprise adds". */
  .group-heading th {
    padding-top: 0.9rem;
    padding-bottom: 0.45rem;
    background: var(--surface-sunk);
    color: var(--muted);
    font-size: var(--fs-13);
    font-weight: 700;
  }
  /* The grey status chip (Base.astro .chip) may wrap in a narrow column
     rather than poke out of its cell. */
  .compare .chip {
    white-space: normal;
  }
  .compare-footer {
    margin: 1rem auto 0;
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-13);
  }
  /* Desktop: every row on one line, as ruled; the section takes the page's
     full measure to make room. Only a feature name marked long (see
     longFeature above) may wrap, so the table never scrolls on desktop. */
  @media (min-width: 1200px) {
    .compare {
      max-width: var(--maxw);
    }
    .compare th,
    .compare td {
      padding-right: 0.6rem;
      padding-left: 0.6rem;
    }
    .compare th,
    .compare td {
      white-space: nowrap;
    }
    .compare th.feature-long {
      white-space: normal;
    }
  }
  @media (max-width: 640px) {
    .compare th,
    .compare td {
      padding: 0.55rem 0.55rem;
      font-size: var(--fs-13);
    }
    /* On a phone the feature names get the widest column of the main
       table, so they wrap less than the short ✓ / — cells beside them. */
    .compare-wrap:not(.roadmap-wrap) thead th:first-child {
      width: 44%;
    }
  }
  .mor {
    margin: 2.5rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-13);
  }
</style>
