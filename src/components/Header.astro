---
import {
  ui,
  blogPath,
  homePath,
  pricingPath,
  securityPath,
  LOCALES,
  LANG_LABEL,
  LANG_NATIVE,
  type Locale,
} from '../lib/i18n';
import { getUsedTerms } from '../lib/posts';
import { termHref, groupMeta, type TermGroup } from '../lib/terms';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = ui[locale];
const pathname = Astro.url.pathname;
const homeHref = homePath(locale);
const blogHref = blogPath(locale);
const securityHref = securityPath(locale);
const pricingHref = pricingPath(locale);
const onBlogHome = pathname === blogHref;
const inBlog = pathname.startsWith(`/${locale}/blog`);
const inSecurity = pathname === securityHref;
const inPricing = pathname === pricingHref;

// One dropdown per axis (only terms that have content in THIS locale).
const AXES: TermGroup[] = ['topic', 'solution', 'role', 'industry'];
const menus = (
  await Promise.all(
    AXES.map(async (group) => {
      const terms = (await getUsedTerms(group, locale)).filter((term) => !term.parent);
      const active = terms.some((term) =>
        pathname.startsWith(termHref(locale, term))
      );
      return { group, terms, active };
    })
  )
).filter((m) => m.terms.length > 0);
---

<header class:list={['site-header', { 'blog-context': inBlog }]}>
  <div class="bar">
    <a class="wordmark" href={homeHref}>
      <Logo size={22} class="logo" />
      <span class="name" translate="no">{t.siteName}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <a href={`${homeHref}#capabilities`}>{t.siteNav.platform}</a>
      <a href={`${homeHref}#ai`}>{t.siteNav.ai}</a>
      <a href={`${homeHref}#templates`}>{t.siteNav.solutions}</a>
      <a class:list={{ active: inSecurity }} href={securityHref} aria-current={inSecurity ? 'page' : undefined}>{t.siteNav.security}</a>
      <a class:list={{ active: inBlog }} href={blogHref} aria-current={inBlog ? 'page' : undefined}>{t.siteNav.articles}</a>
      <a
        href="https://docs.objectos.ai"
        target="_blank"
        rel="noopener">
        {t.siteNav.docs}
      </a>
    </nav>

    <div class="bar-right">
      <button
        type="button"
        class="iconbtn"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode">
        <span class="moon" aria-hidden="true">☾</span>
        <span class="sun" aria-hidden="true">☀</span>
      </button>

      <div class="menu langmenu" data-menu>
        <button
          type="button"
          class="lang-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={`Language: ${LANG_NATIVE[locale]}`}
          title={`Language: ${LANG_NATIVE[locale]}`}
          data-menu-trigger>
          <span class="globe" aria-hidden="true">🌐</span>
          <span class="lang-cur native">{LANG_NATIVE[locale]}</span>
          <span class="lang-cur short">{LANG_LABEL[locale]}</span>
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="menu-panel lang-panel" role="menu">
          {
            LOCALES.map((l) => (
              <a
                class:list={['menu-item', { active: l === locale }]}
                href={alternates[l] ?? homePath(l)}
                data-lang={l}
                role="menuitem">
                {LANG_NATIVE[l]}
              </a>
            ))
          }
        </div>
      </div>
      <a class:list={['top-link', { active: inPricing }]} href={pricingHref} aria-current={inPricing ? 'page' : undefined}>{t.footer.pricing}</a>
      <a class="cta" href={pricingHref}>{t.getStarted}</a>
    </div>
  </div>

  {
    inBlog && menus.length > 0 && (
      <nav class="blognav" aria-label="Browse">
        <div class="mainnav-inner">
          <a
            class:list={['nav-link', { active: onBlogHome }]}
            href={blogHref}
            aria-current={onBlogHome ? 'page' : undefined}>
            {t.all}
          </a>
          {menus.map((m) => (
            <div class="menu" data-menu>
              <button
                type="button"
                class:list={['menu-trigger', { active: m.active }]}
                aria-expanded="false"
                aria-haspopup="true"
                data-menu-trigger>
                {groupMeta(m.group).label[locale]}
                <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="menu-panel" role="menu">
                {m.terms.map((term) => (
                  <a
                    class:list={[
                      'menu-item',
                      { active: pathname.startsWith(termHref(locale, term)) },
                    ]}
                    href={termHref(locale, term)}
                    role="menuitem">
                    {term.label[locale]}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </nav>
    )
  }
</header>

<script>
  // Remember the reader's language choice so `/` redirects there next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', a.dataset.lang || 'en');
      } catch {
        /* ignore */
      }
    });
  });

  // Dark-mode toggle (persisted; default comes from the inline head script).
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* ignore */
    }
  });

  // Dropdown menus (axes + language): click to open, single-open, close on
  // outside-click / Escape.
  const menus = document.querySelectorAll<HTMLElement>('[data-menu]');
  function closeAll(except?: HTMLElement) {
    menus.forEach((m) => {
      if (m === except) return;
      m.classList.remove('open');
      m.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
    });
  }
  menus.forEach((menu) => {
    const trigger = menu.querySelector('[data-menu-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeAll(menu);
    });
  });
  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface-glass);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    box-shadow: 0 10px 28px -26px rgba(var(--shadow), 0.55);
    backdrop-filter: saturate(1.35) blur(18px);
  }
  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    height: 64px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
    transition: transform 0.16s ease;
  }
  .wordmark:hover {
    transform: translateY(-1px);
  }
  .logo {
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(0 8px 13px rgba(63, 91, 246, 0.22));
  }
  .name {
    font-weight: 760;
    letter-spacing: 0;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-right: auto;
    margin-left: 2.25rem;
  }
  .site-nav a {
    color: var(--ink-soft);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    padding: 0.43rem 0.72rem;
    border-radius: 6px;
    transition:
      color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }
  .site-nav a:hover,
  .site-nav a.active {
    color: var(--ink);
    background: var(--surface-sunk);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
  }

  .bar-right {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .top-link {
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    padding: 0.43rem 0.5rem;
    border-radius: 6px;
    white-space: nowrap;
    transition:
      color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }
  .top-link:hover,
  .top-link.active {
    color: var(--ink);
    background: var(--surface-sunk);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
  }

  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, var(--surface-sunk));
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    transition:
      color 0.15s,
      background 0.15s,
      transform 0.15s;
  }
  .iconbtn:hover {
    color: var(--ink);
    background: var(--surface);
    transform: translateY(-1px);
  }

  /* Language dropdown */
  .langmenu {
    position: relative;
  }
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--surface) 70%, var(--surface-sunk));
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.43rem 0.72rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }
  .lang-trigger:hover {
    color: var(--ink);
    background: var(--surface);
    transform: translateY(-1px);
  }
  .lang-trigger .globe {
    font-size: 0.85rem;
  }
  .lang-cur.short {
    display: none;
  }
  .lang-panel {
    left: auto;
    right: 0;
  }

  /* Primary CTA — pinned in the bar so it never scrolls away */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.82rem;
    font-weight: 680;
    color: var(--surface);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.46rem 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      opacity 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px -14px rgba(var(--shadow), 0.55);
    opacity: 0.95;
  }

  /* Grouped mega-menu (one dropdown per axis) */
  .blognav {
    border-top: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
  }
  .mainnav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.25rem;
    min-height: 46px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
  .nav-link,
  .menu-trigger {
    font-family: inherit;
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .nav-link:hover,
  .menu-trigger:hover {
    color: var(--ink);
    background: var(--surface-sunk);
  }
  .nav-link.active,
  .menu-trigger.active {
    color: var(--ink);
    font-weight: 600;
  }
  .caret {
    font-size: 0.6rem;
    opacity: 0.55;
    transition: transform 0.15s;
  }
  .menu {
    position: relative;
  }
  .menu.open .caret {
    transform: rotate(180deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 180px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 42px -22px rgba(var(--shadow), 0.45);
    padding: 0.45rem;
    display: none;
    flex-direction: column;
    gap: 1px;
    z-index: 20;
  }
  .menu.open .menu-panel {
    display: flex;
  }
  .menu-item {
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.48rem 0.68rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .menu-item:hover {
    background: var(--surface-sunk);
    color: var(--ink);
  }
  .menu-item.active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .site-nav {
      margin-left: 1rem;
    }
    .site-nav a {
      padding-right: 0.55rem;
      padding-left: 0.55rem;
    }
    .top-link {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .bar {
      height: auto;
      min-height: 58px;
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
      padding-top: 0.65rem;
      padding-bottom: 0.55rem;
    }
    .site-nav {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 0.05rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .site-nav a {
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      padding-left: 0.1rem;
      padding-right: 0.45rem;
      font-size: 0.78rem;
      white-space: nowrap;
    }
    .bar-right {
      margin-left: auto;
    }
    .mainnav-inner {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
    }
    .mainnav-inner > * {
      scroll-snap-align: start;
    }
    .nav-link,
    .menu-trigger {
      min-height: 40px;
      padding: 0.34rem 0.5rem;
      font-size: 0.78rem;
    }
    .iconbtn {
      width: 40px;
      height: 40px;
    }
    .lang-trigger {
      min-width: 44px;
      min-height: 40px;
      padding-right: 0.58rem;
      padding-left: 0.58rem;
      gap: 0.26rem;
    }
    .lang-cur.native,
    .lang-trigger .caret {
      display: none;
    }
    .lang-cur.short {
      display: inline;
    }
    .cta {
      min-height: 40px;
    }
    .menu-item {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .site-nav::-webkit-scrollbar,
    .mainnav-inner::-webkit-scrollbar {
      display: none;
    }
    .blog-context .site-nav {
      display: none;
    }
    .blognav .menu-panel {
      position: fixed;
      top: 105px;
      right: 1rem;
      left: 1rem;
      max-height: calc(100vh - 121px);
      overflow-y: auto;
    }
    .lang-panel {
      position: fixed;
      top: 104px;
      right: 1rem;
      left: 1rem;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
    }
    .blog-context .lang-panel {
      top: 58px;
      max-height: calc(100vh - 74px);
    }
  }
  @media (max-width: 420px) {
    .mainnav-inner {
      padding-right: 0.75rem;
      padding-left: 0.75rem;
      gap: 0.04rem;
    }
    .nav-link,
    .menu-trigger {
      min-height: 38px;
      padding-right: 0.34rem;
      padding-left: 0.34rem;
      gap: 0.18rem;
      font-size: 0.72rem;
    }
  }
  @media (max-width: 360px) {
    .bar {
      padding-right: 1rem;
      padding-left: 1rem;
    }
    .lang-cur.native {
      display: none;
    }
    .lang-cur.short {
      display: none;
    }
    .lang-trigger {
      width: 40px;
      min-width: 40px;
      padding-right: 0;
      padding-left: 0;
      justify-content: center;
    }
    .site-nav a {
      padding-right: 0.35rem;
      font-size: 0.76rem;
    }
  }
</style>
