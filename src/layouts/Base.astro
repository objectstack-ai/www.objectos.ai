---
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import { marketingPagePath } from '../content-pages/registry';
import { glossaryIndexPath } from '../glossary/registry';
import { htmlLang, pricingPath, privacyPath, rssPath, termsPath, ui, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Real per-locale equivalents of this page — the hreflang set. */
  alternates?: Partial<Record<Locale, string>>;
  /**
   * Where the language switcher sends a reader, when that differs from the
   * hreflang set. Page types with a fallback design (marketing, glossary)
   * render at every locale URL, so the switcher should offer the same page in
   * the chosen locale even where the content falls back to English; hreflang
   * must still name only the authored locales. Omit it and the switcher uses
   * `alternates`, which is correct for page types with no fallback.
   */
  navAlternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  locale,
  canonical,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  alternates,
  navAlternates,
} = Astro.props;
const t = ui[locale];

// Absolute URLs for hreflang (needs `site` in astro.config).
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
const canonicalUrl = canonical
  ? absoluteUrl(canonical)
  : site
    ? `${site}${Astro.url.pathname}`
    : Astro.url.href;
const imageUrl = image
  ? absoluteUrl(image)
  : absoluteUrl('/images/objectos-home-hero.png');
const hreflangs = Object.entries(alternates ?? {}).map(([l, href]) => ({
  hreflang: htmlLang(l as Locale),
  href: absoluteUrl(href),
}));
const xDefaultHref = alternates?.en ?? alternates?.[locale] ?? Object.values(alternates ?? {})[0];
const xDefault = xDefaultHref ? absoluteUrl(xDefaultHref) : null;
const jsonLdItems = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ObjectOS',
    legalName: 'ObjectStack AI LLC',
    url: absoluteUrl('/en/'),
    logo: absoluteUrl('/logo.svg'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ObjectOS',
    url: absoluteUrl('/en/'),
    inLanguage: htmlLang(locale),
    publisher: {
      '@type': 'Organization',
      name: 'ObjectStack AI LLC',
    },
  },
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const jsonLdHtml = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Set the theme before first paint (no flash). Manual choice wins,
      // else follow the system preference.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') {
            t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.articlesTitle} · ${t.siteName}`}
      href={absoluteUrl(rssPath(locale))}
    />
    <meta property="og:site_name" content="ObjectOS" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={htmlLang(locale).replace('-', '_')} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={jsonLdHtml(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skipToContent}</a>
    <Header {locale} {alternates} {navAlternates} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <span class="foot-brand" translate="no">
          <Logo size={14} /> ObjectStack AI LLC
          <span class="muted">© {new Date().getFullYear()}</span>
        </span>
        <div class="foot-links">
          <a href={marketingPagePath(locale, 'product-tour')}>Product tour</a>
          <a href={marketingPagePath(locale, 'platform')}>Platform</a>
          <a href={marketingPagePath(locale, 'ai')}>AI Build & Ask</a>
          <a href={marketingPagePath(locale, 'mcp')}>Tools & MCP</a>
          <a href={marketingPagePath(locale, 'templates')}>Templates</a>
          <a href={marketingPagePath(locale, 'agent-developer')}>Agent guide</a>
          <a href={marketingPagePath(locale, 'trust-center')}>Trust center</a>
          <a href={marketingPagePath(locale, 'customer-stories')}>Reference stories</a>
          <a href={glossaryIndexPath(locale)}>{t.siteNav.glossary}</a>
          <a href={pricingPath(locale)}>{t.footer.pricing}</a>
          <a href="https://docs.objectos.ai" target="_blank" rel="noopener">{t.siteNav.docs}</a>
          <a href="https://github.com/objectstack-ai/objectstack" target="_blank" rel="noopener">GitHub</a>
          <a href="/llms.txt" translate="no">llms.txt</a>
          <a href={rssPath(locale)}>RSS</a>
          <a href={privacyPath(locale)}>{t.footer.privacy}</a>
          <a href={termsPath(locale)}>{t.footer.terms}</a>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f3f7f2;
        --surface: #fffffb;
        --surface-glass: rgba(255, 255, 251, 0.78);
        --surface-sunk: #e9efe9;
        --ink: #151a17;
        --ink-soft: #515b55;
        --muted: #8b958f;
        --line: #dfe7df;
        --accent: #3f5bf6;
        --accent-soft: #eef2ff;
        --ring: rgba(63, 91, 246, 0.28);
        --shadow: 21, 26, 23;
        --maxw: 1120px;
        --font-display:
          'Iowan Old Style', 'Palatino Linotype', Palatino, 'Songti SC',
          'Noto Serif CJK SC', serif;
        --font-sans:
          'Avenir Next', Avenir, 'Trebuchet MS', -apple-system, BlinkMacSystemFont,
          'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
        --bg: #101713;
        --surface: #17201b;
        --surface-glass: rgba(23, 32, 27, 0.78);
        --surface-sunk: #202b25;
        --ink: #f4f7f2;
        --ink-soft: #aab6ad;
        --muted: #748077;
        --line: #2a3931;
        --accent: #91a3ff;
        --accent-soft: #202849;
        --ring: rgba(145, 163, 255, 0.3);
        --shadow: 0, 0, 0;
      }

      /* Dark-mode toggle icon swap (button markup lives in the header). */
      .iconbtn .sun {
        display: none;
      }
      .iconbtn .moon {
        display: inline;
      }
      :root[data-theme='dark'] .iconbtn .moon {
        display: none;
      }
      :root[data-theme='dark'] .iconbtn .sun {
        display: inline;
      }

      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
        scroll-padding-top: 96px;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(135deg, rgba(255, 255, 251, 0.58), rgba(228, 242, 235, 0.28) 42%, rgba(238, 242, 255, 0.2)),
          repeating-linear-gradient(90deg, rgba(21, 26, 23, 0.025) 0 1px, transparent 1px 72px),
          var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      :root[data-theme='dark'] body {
        background:
          linear-gradient(135deg, rgba(20, 30, 24, 0.76), rgba(25, 39, 35, 0.5) 46%, rgba(32, 40, 73, 0.22)),
          repeating-linear-gradient(90deg, rgba(244, 247, 242, 0.026) 0 1px, transparent 1px 72px),
          var(--bg);
      }
      main {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 4.25rem 1.5rem 4.5rem;
      }
      main:focus {
        outline: none;
      }
      a {
        color: var(--accent);
      }
      a,
      button {
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }
      :focus-visible {
        outline: 3px solid var(--ring);
        outline-offset: 3px;
      }
      img,
      svg,
      video {
        max-width: 100%;
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        transform: translateY(calc(-100% - 1rem));
        color: var(--surface);
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 8px;
        padding: 0.55rem 0.75rem;
        font-size: 0.86rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 18px 42px -24px rgba(var(--shadow), 0.6);
        transition: transform 0.16s ease;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
      }
      ::selection {
        color: var(--ink);
        background: color-mix(in srgb, var(--accent) 20%, transparent);
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.001ms !important;
        }
      }

      .site-footer {
        border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
        margin-top: 4rem;
      }
      .site-footer .inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }
      .site-footer .foot-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }
      .site-footer .foot-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
      }
      .site-footer a {
        color: var(--ink-soft);
        text-decoration: none;
      }
      .site-footer a:hover {
        color: var(--ink);
      }
      .site-footer .muted {
        color: var(--muted);
      }
      @media (max-width: 640px) {
        main {
          padding: 2.25rem 1rem 3.5rem;
        }
        .site-footer {
          margin-top: 2.5rem;
        }
        .site-footer .inner {
          padding: 1.25rem 1rem;
          align-items: flex-start;
          flex-direction: column;
          gap: 0.75rem;
        }
      }

      /* Shared status pill */
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--c, var(--muted));
        white-space: nowrap;
      }
      .pill::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
      }
    </style>
  </body>
</html>
