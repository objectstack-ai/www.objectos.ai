---
import Base from '../../../../layouts/Base.astro';
import ArticleList from '../../../../components/ArticleList.astro';
import {
  articleHasTerm,
  getAllUsedTerms,
  getPostsInLocale,
  MIN_INDEXABLE_HUB_POSTS,
} from '../../../../lib/posts';
import { termBySlug, termDescription, termSlugPath, termHref, type Term } from '../../../../lib/terms';
import { blogPath, postPath, ui, localeSeg, LOCALES, type Locale } from '../../../../lib/i18n';

export async function getStaticPaths() {
  // Group each used term by the locales it has content in, with the number of
  // posts its hub lists there.
  const byTerm = new Map<string, { term: Term; counts: Map<Locale, number> }>();
  for (const locale of LOCALES) {
    const posts = await getPostsInLocale(locale);
    for (const term of await getAllUsedTerms(locale)) {
      const e = byTerm.get(term.slug) ?? { term, counts: new Map() };
      e.counts.set(locale, posts.filter((post) => articleHasTerm(post.entry.data, term)).length);
      byTerm.set(term.slug, e);
    }
  }
  const paths = [];
  for (const { term, counts } of byTerm.values()) {
    const locales = [...counts.keys()];
    // hreflang names only the indexable hubs; the switcher offers every built one.
    const alternates = Object.fromEntries(
      locales
        .filter((l) => counts.get(l)! >= MIN_INDEXABLE_HUB_POSTS)
        .map((l) => [l, termHref(l, term)])
    );
    const navAlternates = Object.fromEntries(locales.map((l) => [l, termHref(l, term)]));
    for (const locale of locales) {
      paths.push({
        params: { lang: localeSeg(locale), slug: termSlugPath(term) },
        props: {
          group: term.group,
          slug: term.slug,
          locale,
          alternates,
          navAlternates,
          noindex: counts.get(locale)! < MIN_INDEXABLE_HUB_POSTS,
        },
      });
    }
  }
  return paths;
}

const { group, slug, locale, alternates, navAlternates, noindex } = Astro.props;
const term = termBySlug(slug)!;
const t = ui[locale];
const description = termDescription(term, locale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
const hubUrl = absoluteUrl(termHref(locale, term));
const posts = (await getPostsInLocale(locale)).filter((post) => articleHasTerm(post.entry.data, term));
// A child topic sits under its parent's hub, which is built wherever the child
// is: the parent hub aggregates its children's posts.
const parent = term.parent ? termBySlug(term.parent) : undefined;
// "CRM · Articles · ObjectOS", not "CRM · ObjectOS": the label alone collides
// with other pages of the same name (the Security & Governance hub and the
// security page shared one title) and does not say the page is a list of
// articles.
const title = `${term.label[locale]} · ${t.articlesTitle} · ${t.siteName}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: hubUrl,
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: t.articlesTitle, item: absoluteUrl(blogPath(locale)) },
      ...(parent ? [{ name: parent.label[locale], item: absoluteUrl(termHref(locale, parent)) }] : []),
      { name: term.label[locale], item: hubUrl },
    ].map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, ...crumb })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: term.label[locale],
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(postPath(locale, post.slug)),
      name: post.entry.data.title,
    })),
  },
];
---

<Base
  {title}
  description={description}
  jsonLd={jsonLd}
  {locale}
  {noindex}
  {alternates}
  {navAlternates}>
  <ArticleList {locale} filter={{ group, slug }} />
</Base>
