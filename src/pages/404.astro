---
// The top-level 404. Cloudflare Pages serves the nearest `404.html` to a
// missing URL, walking up to this one, and treats a deployment WITHOUT a
// top-level `404.html` as a single-page app: every unknown URL then answers
// 200 with the root language-redirect page, so broken links land silently on
// a home page and crawlers record soft 404s. This file is what turns that off.
//
// It answers for URLs outside every locale, so it is English (the x-default)
// and also lists each locale's home. Each locale has its own localized 404 at
// `/<locale>/404.html` (src/pages/[lang]/404.astro), which Pages prefers for
// missing URLs under that locale.
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import { ui } from '../lib/i18n';

const t = ui.en;
---

<Base
  title={`${t.notFound.title} · ${t.siteName}`}
  description={t.notFound.lead}
  locale="en"
  canonical={null}
  noindex>
  <NotFound locale="en" languages />
</Base>
