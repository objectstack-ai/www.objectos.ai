---
import { ui, homePath, type Locale } from '../lib/i18n';
import { getUsedTerms } from '../lib/posts';
import { termHref, groupMeta, type TermGroup } from '../lib/terms';

interface Props {
  locale: Locale;
  enHref: string;
  zhHref: string;
}

const { locale, enHref, zhHref } = Astro.props;
const t = ui[locale];
const pathname = Astro.url.pathname;
const homeHref = homePath(locale);
const onHome = pathname === homeHref;

// One dropdown per axis, in this order. Empty axes are dropped.
const AXES: TermGroup[] = ['topic', 'solution', 'role', 'industry'];
const menus = (
  await Promise.all(
    AXES.map(async (group) => {
      const terms = (await getUsedTerms(group)).filter((term) => !term.parent);
      const active = terms.some((term) =>
        pathname.startsWith(termHref(locale, term))
      );
      return { group, terms, active };
    })
  )
).filter((m) => m.terms.length > 0);
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={homeHref}>
      <span class="mark">◆</span>
      <span class="name">{t.siteName}</span>
      <span class="sep">/</span>
      <span class="nav">{t.nav}</span>
    </a>

    <nav class="lang" aria-label="Language">
      <a
        class:list={['seg', { active: locale === 'en' }]}
        href={enHref}
        aria-current={locale === 'en' ? 'true' : undefined}>EN</a
      >
      <a
        class:list={['seg', { active: locale === 'zh-Hans' }]}
        href={zhHref}
        aria-current={locale === 'zh-Hans' ? 'true' : undefined}>中文</a
      >
    </nav>
  </div>

  {
    menus.length > 0 && (
      <nav class="mainnav" aria-label="Browse">
        <div class="mainnav-inner">
          <a class:list={['nav-link', { active: onHome }]} href={homeHref}>
            {t.all}
          </a>
          {menus.map((m) => (
            <div class="menu" data-menu>
              <button
                type="button"
                class:list={['menu-trigger', { active: m.active }]}
                aria-expanded="false"
                aria-haspopup="true"
                data-menu-trigger>
                {groupMeta(m.group).label[locale]}
                <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="menu-panel" role="menu">
                {m.terms.map((term) => (
                  <a
                    class:list={[
                      'menu-item',
                      { active: pathname.startsWith(termHref(locale, term)) },
                    ]}
                    href={termHref(locale, term)}
                    role="menuitem">
                    {term.label[locale]}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </nav>
    )
  }
</header>

<script>
  const menus = document.querySelectorAll<HTMLElement>('[data-menu]');
  function closeAll(except?: HTMLElement) {
    menus.forEach((m) => {
      if (m === except) return;
      m.classList.remove('open');
      m.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
    });
  }
  menus.forEach((menu) => {
    const trigger = menu.querySelector('[data-menu-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeAll(menu);
    });
  });
  document.addEventListener('click', () => closeAll());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    height: 58px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .mark {
    color: var(--accent);
    font-size: 0.7rem;
    transform: translateY(-1px);
  }
  .name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .sep {
    color: var(--muted);
  }
  .nav {
    color: var(--ink-soft);
    font-weight: 450;
  }

  .lang {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .seg {
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
    transition:
      color 0.15s,
      background 0.15s;
  }
  .seg:hover {
    color: var(--ink);
  }
  .seg.active {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  /* Grouped mega-menu (one dropdown per axis) */
  .mainnav {
    border-top: 1px solid var(--line);
  }
  .mainnav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.25rem;
    min-height: 46px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
  .nav-link,
  .menu-trigger {
    font-family: inherit;
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .nav-link:hover,
  .menu-trigger:hover {
    color: var(--ink);
    background: var(--surface-sunk);
  }
  .nav-link.active,
  .menu-trigger.active {
    color: var(--ink);
    font-weight: 600;
  }
  .caret {
    font-size: 0.6rem;
    opacity: 0.55;
    transition: transform 0.15s;
  }
  .menu {
    position: relative;
  }
  .menu.open .caret {
    transform: rotate(180deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 200px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 14px 36px -14px rgba(28, 25, 23, 0.3);
    padding: 0.4rem;
    display: none;
    flex-direction: column;
    gap: 1px;
    z-index: 20;
  }
  .menu.open .menu-panel {
    display: flex;
  }
  .menu-item {
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    white-space: nowrap;
  }
  .menu-item:hover {
    background: var(--surface-sunk);
    color: var(--ink);
  }
  .menu-item.active {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
</style>
