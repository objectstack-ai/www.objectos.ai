---
import type { PricingCopy } from '../lib/pricing';

interface Props {
  copy: PricingCopy;
  refundsHref: string;
}

const { copy, refundsHref } = Astro.props;
---

<section class="pricing">
  <header>
    <h1>{copy.title}</h1>
    <p class="intro">{copy.intro}</p>
  </header>

  {copy.promo && <p class="promo">{copy.promo}</p>}

  <div class="plans">
    {
      copy.plans.map((plan) => (
        <article class:list={['plan', 'card', { highlight: plan.highlight }]}>
          <h2>{plan.name}</h2>
          <p class="tagline">{plan.tagline}</p>
          <div class="price-block">
            <p class="price">
              <span class="amount">{plan.price}</span>
            </p>
            {plan.cadence && <p class="cadence">{plan.cadence}</p>}
            {plan.billedNote && <p class="billed">{plan.billedNote}</p>}
            {plan.altPrice && <p class="alt">{plan.altPrice}</p>}
          </div>
          <a class:list={['cta', 'btn', plan.highlight ? 'btn-primary' : 'btn-secondary']} href={plan.ctaHref}>
            {plan.cta}
          </a>
          <ul>
            {plan.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="note">{copy.billingNote}</p>

  <p class="mor">
    {copy.morNote} <a href={refundsHref}>{copy.refundsLabel}</a>.
  </p>
</section>

<style>
  .pricing {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  header {
    text-align: center;
    max-width: var(--measure-lead);
    margin: 0 auto 2.5rem;
  }
  /* Display face for the page title, as on every page (Base.astro
     --font-display); plan names are card titles and stay in the text face. */
  h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-17);
  }
  .promo {
    margin: 0 auto 1.75rem;
    max-width: var(--measure-lead);
    text-align: center;
    padding: 0.7rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--brand-soft);
    color: var(--brand);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    font-size: var(--fs-14);
    font-weight: 600;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  /* Each card's five parts (name, tagline, price, CTA, features) sit on the
     row's shared tracks, so they start at the same height in every card of a
     row however each card's copy wraps. The fixed min-heights this replaces
     guessed at the longest tagline and price and were outgrown, leaving one
     price 22px low and the CTAs at four different heights. */
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 1.5rem;
  }
  /* The recommended plan: a 2px brand edge, and the badge the copy carries. */
  .plan.highlight {
    border-width: 2px;
    border-color: var(--brand);
    padding: calc(1.5rem - 1px);
  }
  .plan h2 {
    margin: 0;
    font-size: var(--fs-18);
  }
  .tagline {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  /* Tabular figures: the plans' prices sit side by side. */
  .price-block {
    margin: 1rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  .price {
    margin: 0;
  }
  .price .amount {
    font-size: var(--fs-36);
    font-weight: 700;
    letter-spacing: 0;
  }
  .cadence {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .billed {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .alt {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: var(--fs-13);
  }
  .cta {
    display: flex;
    margin: 1.1rem 0 0;
  }
  /* The recommended plan's button is the primary (ink) with the brand
     outline, ruled on #340; it was a solid indigo of its own. */
  .plan.highlight .cta {
    border-width: 2px;
    border-color: var(--brand);
  }
  .plan ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* The list's row is as tall as the longest list in the card row. */
    align-content: start;
    gap: 0.55rem;
  }
  .plan li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .note {
    margin: 1.75rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-14);
  }
  .mor {
    margin: 2.5rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-13);
  }
</style>
