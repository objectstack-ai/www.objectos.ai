---
import type { LegalPageCopy } from '../lib/legal';

interface Props {
  copy: LegalPageCopy;
}

const { copy } = Astro.props;
---

<article class="legal">
  <header>
    <h1>{copy.title}</h1>
    <p class="updated">{copy.updated}</p>
    <p class="intro">{copy.intro}</p>
  </header>

  <div class="sections">
    {
      copy.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {
            section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )
          }
        </section>
      ))
    }
  </div>
</article>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
  }
  header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: 0;
  }
  .updated {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .intro {
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .sections {
    display: grid;
    gap: 2rem;
    padding-top: 2.5rem;
  }
  section h2 {
    margin: 0 0 0.55rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  section p,
  section li {
    color: var(--ink-soft);
  }
  section p {
    margin: 0.65rem 0 0;
  }
  section ul {
    margin: 0.85rem 0 0;
    padding-left: 1.25rem;
  }
  section li + li {
    margin-top: 0.45rem;
  }
</style>
