    flex-direction: column;
    padding: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .solution-mark {
    width: 34px;
    height: 5px;
    margin-bottom: 1.6rem;
    background: var(--green);
    border-radius: var(--r-pill);
