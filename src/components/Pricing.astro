---
import type { PricingCopy } from '../lib/pricing';

interface Props {
  copy: PricingCopy;
  refundsHref: string;
}

const { copy, refundsHref } = Astro.props;
---

<section class="pricing">
  <header>
    <h1>{copy.title}</h1>
    <p class="intro">{copy.intro}</p>
  </header>

  {copy.promo && <p class="promo">{copy.promo}</p>}

  <div class="plans">
    {
      copy.plans.map((plan) => (
        <article class:list={['plan', { highlight: plan.highlight }]}>
          <h2>{plan.name}</h2>
          <p class="tagline">{plan.tagline}</p>
          <div class="price-block">
            <p class="price">
              <span class="amount">{plan.price}</span>
            </p>
            {plan.cadence && <p class="cadence">{plan.cadence}</p>}
            {plan.billedNote && <p class="billed">{plan.billedNote}</p>}
            {plan.altPrice && <p class="alt">{plan.altPrice}</p>}
          </div>
          <a class="cta" href={plan.ctaHref}>
            {plan.cta}
          </a>
          <ul>
            {plan.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="note">{copy.billingNote}</p>

  <p class="mor">
    {copy.morNote} <a href={refundsHref}>{copy.refundsLabel}</a>.
  </p>
</section>

<style>
  .pricing {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: 0;
  }
  .intro {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  .promo {
    margin: 0 auto 1.75rem;
    max-width: 640px;
    text-align: center;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .plan.highlight {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .plan h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .tagline {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    min-height: 2.4em;
  }
  .price-block {
    margin: 1rem 0 0;
    min-height: 6.25rem;
  }
  .price {
    margin: 0;
  }
  .price .amount {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .cadence {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .billed {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .alt {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .cta {
    display: block;
    margin: 1.1rem 0 0;
    padding: 0.6rem 1rem;
    text-align: center;
    border-radius: 10px;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .plan.highlight .cta {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .cta:hover {
    border-color: var(--accent);
  }
  .plan ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .plan li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .note {
    margin: 1.75rem auto 0;
    max-width: 720px;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .mor {
    margin: 2.5rem auto 0;
    max-width: 720px;
    text-align: center;
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>
