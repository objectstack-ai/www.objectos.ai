---
// The five topic-cluster (pillar) pages, linked from every page's footer.
//
// Before this row a cluster page's only in-site link was the home page's
// cluster strip in its own locale — /en/ai-native-app-platform/ had eight
// inbound links, seven of them language switchers. A pillar page that nothing
// links to is a page a crawler finds once and weighs as unimportant, and a
// reader on an article never learns the guide exists. Every page links all
// five here; each post a cluster lists as its reading path also links back to
// it (src/layouts/BlogPost.astro).
import { clusterCopy } from '../lib/cluster-i18n';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = ui[locale].siteNav.topicClusters;
---

<nav class="foot-clusters" aria-label={label}>
  <span class="label">{label}</span>
  <ul>
    {
      CLUSTERS.map((cluster) => (
        <li>
          <a href={clusterPath(locale, cluster.slug)}>{clusterCopy(cluster, locale).shortTitle}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .foot-clusters {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1.25rem 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .label {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .foot-clusters {
      padding: 1.25rem 1rem 0;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
