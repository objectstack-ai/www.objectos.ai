  .solution h3 {
    font-size: var(--fs-20);
    margin-bottom: 0.65rem;
  }
  .solution p {
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-prose);
    margin-bottom: 1.4rem;
  }
  /* The card's slack goes above the link, so titles sit under the mark and
     the links line up along the bottom of a row. */
  .solution-link {
    margin-top: auto;
    color: var(--green);
    font-size: var(--fs-13);
    font-weight: 700;
  }
  /* The templates catalog, one link under the cards: a ghost link at least
     24px from the cards above it, so its target clears the cards' (axe
     target-size). Two classes: `.home p` above resets margin-top. */
  .solution-section > .solution-more {
    margin: 2rem 0 0;
  }
  /* E1 and its two links (#411), between the section head and the
     comparison cards. */
  .editions {
    margin-bottom: 2.75rem;
  }
  .editions > .editions-copy {
    margin-bottom: 1.1rem;
  }
  .editions > .editions-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin: 0;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .insight-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: -1.7rem 0 2rem;
  }
  .article {
    color: var(--ink);
    text-decoration: none;
  }
  /* `height: auto` is load-bearing: the `height` attribute maps to a CSS
     height, which beats `aspect-ratio` and cut each 16:9 cover to a 344×500
     sliver. The box is the covers' own 16:9; `contain` letterboxes the odd
     16:10 cover instead of cropping its title. */
  .article img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface-sunk);
    box-shadow: var(--shadow-sm);
    filter: var(--cover-filter);
  }
  /* One cover per theme (src/lib/cover-variant.ts); the dark variant is drawn
     dark and takes no --cover-filter dimming. */
  :global(:root:not([data-theme='dark'])) .article .cover-dark,
  :global(:root[data-theme='dark']) .article .cover-light {
    display: none;
  }
  .article img.cover-dark {
    filter: none;
  }
  .article time {
    color: var(--muted);
    font: 600 var(--fs-12)/1 var(--font-mono);
  }
  .article h3 {
    font-size: var(--fs-18);
    line-height: var(--lh-ui);
    margin: 0.65rem 0 0.4rem;
    transition: color 0.16s ease;
  }
  .article:hover h3 {
    color: var(--brand);
  }
  .article p {
    color: var(--ink-soft);
    font-size: var(--fs-13);
    line-height: var(--lh-body);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .closing {
    margin-top: var(--space-section);
    padding: 5rem;
    background-image: repeating-linear-gradient(90deg, color-mix(in srgb, var(--on-panel) 8%, transparent) 0 1px, transparent 1px 64px);
  }
  /* The kicker is a <p> too, so it is named here: the panel's own rule for
     kickers (Base.astro .panel-dark) has less weight than this scoped `> p`. */
  .closing > p {
    color: var(--on-panel-soft);
  }
  .closing .section-kicker {
    color: var(--on-panel-accent);
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  /* The developer path, one text link under the buttons (#411). The ghost
     link is ink on ink here without this: it takes the panel's text tokens. */
  .closing > .closing-dev {
    margin: 1.75rem 0 0;
  }
  .closing .btn-ghost {
    color: var(--on-panel);
    border-color: color-mix(in srgb, var(--on-panel) 45%, transparent);
  }
  .closing .btn-ghost:hover {
    color: var(--on-panel-accent);
    border-color: var(--on-panel-accent);
  }
  /* On phones and small tablets (`max-width: 900px`) the hero's children are
     ordered explicitly: eyebrow, headline, category line, lead, CTAs,
     video, proof. Since
     E1 and the protocol link left the hero for the editions block (#411)
     that is also the source order; the explicit order stays so the phone
     layout does not depend on it.

     This rule used to move the video up to directly under the headline, ahead
     of the lead, when the lead ran T2, T4 and E1 together — about nine lines
     on a phone — which put the CTA row at 1114px on a 390px phone, 1.3
     screens down. With the lead one sentence the CTA row is in the first
     screen and the video follows it.

     A wide but short screen keeps the source order. This rule used to fire on
     `max-height: 1040px` too, to get the video into a laptop's first screen,
     and that put the primary CTA under a 529px frame: its bottom was at
     1207px on a 1366x625 laptop and 1256px at 1920x945. The CTA is the
     screen's job. */
  @media (max-width: 900px) {
    .hero > .eyebrow {
      order: 1;
    }
    .hero > h1 {
      order: 2;
    }
    .hero > .hero-category {
      order: 3;
    }
    .hero > .hero-lead {
      order: 4;
    }
    .hero > .hero-actions {
      order: 5;
    }
    .hero-video {
      order: 6;
      margin-top: 1.75rem;
      margin-bottom: 0;
    }
    .hero > .proof {
      order: 7;
    }
  }
  @media (max-width: 900px) {
    .hero {
      padding-top: 1.5rem;
    }
    .hero > .eyebrow,
    .hero > h1 {
      max-width: var(--measure-prose);
    }
    .workflow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .ai-section,
    .security-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
    .solution:last-child {
      grid-column: span 2;
    }
    /* Four chips in two rows of two: at tablet widths four columns would be
       ~150px each, which breaks the longer titles onto two lines. */
    .proof {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .home.lang-de .hero h1,
  .home.lang-fr .hero h1,
  .home.lang-es .hero h1 {
    font-size: var(--fs-h1);
  }
  /* A Japanese heading breaks only between phrases, and a phrase keeps its
     particle (オペレーションを、 is nine characters), so the section headings
     are sized for the narrowest column they sit in: the workflow column is
     372px at 1366, which held 6.5 characters at 3.55rem and broke inside
     オペレーション. 2.5rem holds nine. Phones keep 2rem. */
  .home.lang-ja .section-head h2,
  .home.lang-ja .ai-copy h2,
  .home.lang-ja .workflow-intro h2,
  .home.lang-ja .security-copy h2,
  .home.lang-ja .closing h2 {
    font-size: var(--fs-30);
  }
  @media (max-width: 640px) {
    /* The two CTAs share one row and grow to fill it. A locale whose labels
       do not fit side by side (French below about 400px) wraps to two
       full-width rows rather than two ragged, centred buttons. */
    .hero-actions .btn {
      flex: 1 1 auto;
    }
    .home.lang-de .hero h1,
    .home.lang-fr .hero h1,
    .home.lang-es .hero h1 {
      font-size: var(--fs-36);
    }
    /* The trailing phrase, ソフトウェアである, is one phrase of nine
       characters: at the hero floor it was wider than a 390px phone's column
       and broke inside it. At 30px it fits the 312px column of a 360px phone. */
    .home.lang-ja .hero h1 {
      font-size: var(--fs-30);
    }
    .media-note {
      flex: 1 1 auto;
      max-width: none;
    }
    .demo-frame::before {
      inset: -10px 12px 18px -10px;
    }
    /* One column on phones. Two columns survive down here only by getting
       narrower than their own content: at 390px each column is ~175px,
       which breaks the longer titles (`de`, `fr`) onto two lines and runs
       the `dd` to three. The value below is a row gap separating four
       stacked entries.

       640px is this file's existing phone breakpoint rather than a new
       number. The strip is the last child in both the source order and the
       phone reorder, so this moves nothing above it — the video included. */
    .proof {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .ai-section,
    .workflow,
    .security-section,
    .solution-section,
    .articles {
      padding: var(--sp-8) 0;
    }
    .section-head {
      display: block;
    }
    .section-head .btn-ghost {
      margin-top: 1.25rem;
    }
    .capability-list {
      grid-template-columns: 1fr;
    }
    .capability-list li,
    .capability-list li:nth-child(odd),
    .capability-list li:nth-child(even) {
      padding: 1.5rem 0;
      border-right: none;
    }
    .workflow-map {
      padding: 1rem;
    }
    .security-grid {
      grid-template-columns: 1fr;
    }
    .security-item {
      min-height: auto;
    }
    .map-items {
      grid-template-columns: repeat(2, 1fr);
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }
    .solution,
    .solution:last-child {
      grid-column: auto;
    }
    .closing {
      margin: var(--sp-8) -0.5rem 0;
      padding: 2.2rem 1.5rem;
    }
  }
  @media (max-width: 360px) {
    .home.lang-de .hero h1,
    .home.lang-fr .hero h1,
    .home.lang-es .hero h1 {
      font-size: var(--fs-30);
    }
  }
</style>

