                post.coverDark ? (
                  <>
                    <img
                      class="cover-light"
                      src={post.entry.data.cover.src}
                      alt={post.entry.data.title}
                      width={post.entry.data.cover.width}
                      height={post.entry.data.cover.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <img
