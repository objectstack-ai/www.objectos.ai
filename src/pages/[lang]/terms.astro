---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { LOCALES, segToLocale, termsPath } from '../../lib/i18n';
import { termsCopy } from '../../lib/legal';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = termsCopy[locale];
const alternates = Object.fromEntries(LOCALES.map((language) => [language, termsPath(language)]));
---

<Base title={`${copy.title} · ObjectOS`} description={copy.description} {locale} {alternates}>
  <LegalPage {copy} />
</Base>
