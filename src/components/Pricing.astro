---
import type { PricingCopy } from '../lib/pricing';

interface Props {
  copy: PricingCopy;
  refundsHref: string;
}

const { copy, refundsHref } = Astro.props;

// Two tabs, both in the static HTML, switched by CSS alone — the site CSP
// (public/_headers) admits no new inline script. The switch is two links to
// the empty targets at the top of the section: `#self-hosted` (and only it)
// shows the Self-hosted panel through `:target ~` sibling selectors; any other
// fragment, or none, shows the Cloud panel. So `/pricing/#self-hosted` deep
// links, Back returns to the previous tab, and it works with JavaScript off.
// The targets sit above the title so following a tab link keeps the title in
// view. ARIA tab roles are left out on purpose: `aria-selected` cannot follow a
// CSS-only switch, and a stale state is worse than none. The hidden panel is
// `display: none`, so assistive technology reads only the visible one, and each
// panel opens with a heading naming its tab.
const panels = [
  { key: 'cloud', tab: copy.tabs.cloud },
  { key: 'self', tab: copy.tabs.selfHosted },
] as const;
---

<section class="pricing">
  <span id="cloud" class="tab-target target-cloud"></span>
  <span id="self-hosted" class="tab-target target-self"></span>

  <header>
    <h1>{copy.title}</h1>
  </header>

  {copy.promo && <p class="promo">{copy.promo}</p>}

  <nav class="switch" aria-label={copy.switchLabel}>
    <a class="switch-link switch-cloud" href="#cloud">{copy.tabs.cloud.label}</a>
    <a class="switch-link switch-self" href="#self-hosted">{copy.tabs.selfHosted.label}</a>
  </nav>

  {
    panels.map(({ key, tab }) => (
      <section class:list={['panel', `panel-${key}`]} aria-labelledby={`pricing-${key}-heading`}>
        <h2 class="visually-hidden" id={`pricing-${key}-heading`}>
          {tab.label}
        </h2>
        <p class="intro">{tab.intro}</p>
        <div class:list={['plans', { pair: tab.plans.length === 2 }]}>
          {tab.plans.map((plan) => (
            <article class:list={['plan', 'card', { highlight: plan.highlight }]}>
              <h3>{plan.name}</h3>
              <p class="tagline">{plan.tagline}</p>
              <div class="price-block">
                <p class="price">
                  <span class="amount">{plan.price}</span>
                </p>
                {plan.cadence && <p class="cadence">{plan.cadence}</p>}
                {plan.billedNote && <p class="billed">{plan.billedNote}</p>}
                {plan.altPrice && <p class="alt">{plan.altPrice}</p>}
              </div>
              <a class:list={['cta', 'btn', plan.highlight ? 'btn-primary' : 'btn-secondary']} href={plan.ctaHref}>
                {plan.cta}
              </a>
              <ul>
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <p class="note">{tab.billingNote}</p>
      </section>
    ))
  }

  <p class="mor">
    {copy.morNote} <a href={refundsHref}>{copy.refundsLabel}</a>.
  </p>
</section>

<style>
  .pricing {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  header {
    text-align: center;
    max-width: var(--measure-lead);
    margin: 0 auto 1.75rem;
  }
  /* The switch's fragment targets: empty, at the top of the section. Their
     scroll margin is taller than the page header above them, so following a
     tab link (or a #self-hosted deep link) scrolls to the very top, with the
     title and the switch in view, instead of jumping by a few pixels. */
  .tab-target {
    display: block;
    height: 0;
    scroll-margin-top: 100vh;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Display face for the page title, as on every page (Base.astro
     --font-display); plan names are card titles and stay in the text face. */
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* The Cloud / Self-hosted switch: a pill of two links on the surface, the
     buttons' type (--fs-14, 700). The active tab takes the brand chip's
     colours (--brand on --brand-soft, Base.astro .chip-brand), the
     site's mark for a selected facet; focus keeps the global --ring. */
  .switch {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.75rem;
    padding: var(--sp-1);
    gap: var(--sp-1);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
  }
  .switch-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.4rem 1.1rem;
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    font-size: var(--fs-14);
    font-weight: 700;
    line-height: var(--lh-ui);
    text-align: center;
    text-decoration: none;
    transition: color 0.16s ease, background 0.16s ease;
  }
  /* Hover changes only the colour to --brand, which the active tab already
     has, so hovering it changes nothing. */
  .switch-link:hover {
    color: var(--brand);
  }
  /* Active tab: Cloud unless the Self-hosted target is the URL fragment. */
  .switch-cloud,
  .target-self:target ~ .switch .switch-self {
    color: var(--brand);
    background: var(--brand-soft);
  }
  .target-self:target ~ .switch .switch-cloud {
    color: var(--ink-soft);
    background: transparent;
  }
  .target-self:target ~ .switch .switch-cloud:hover {
    color: var(--brand);
  }
  .panel-self,
  .target-self:target ~ .panel-cloud {
    display: none;
  }
  .target-self:target ~ .panel-self {
    display: block;
  }
  .intro {
    max-width: var(--measure-lead);
    margin: 0 auto 2rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--fs-17);
  }
  .promo {
    margin: 0 auto 1.75rem;
    max-width: var(--measure-lead);
    text-align: center;
    padding: 0.7rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--brand-soft);
    color: var(--brand);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent);
    font-size: var(--fs-14);
    font-weight: 600;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  /* Both tabs hold two plans: the pair is held to the wide measure, so two
     cards do not each stretch to half the page. */
  .plans.pair {
    max-width: var(--measure-wide);
    margin: 0 auto;
  }
  /* Each card's five parts (name, tagline, price, CTA, features) sit on the
     row's shared tracks, so they start at the same height in every card of a
     row however each card's copy wraps. The fixed min-heights this replaces
     guessed at the longest tagline and price and were outgrown, leaving one
     price 22px low and the CTAs at four different heights. */
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 1.5rem;
  }
  /* The recommended plan: a 2px brand edge, and the badge the copy carries. */
  .plan.highlight {
    border-width: 2px;
    border-color: var(--brand);
    padding: calc(1.5rem - 1px);
  }
  .plan h3 {
    margin: 0;
    font-size: var(--fs-18);
  }
  .tagline {
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  /* Tabular figures: the plans' prices sit side by side. */
  .price-block {
    margin: 1rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  .price {
    margin: 0;
  }
  .price .amount {
    font-size: var(--fs-36);
    font-weight: 700;
    letter-spacing: 0;
  }
  .cadence {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .billed {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
  }
  .alt {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: var(--fs-13);
  }
  .cta {
    display: flex;
    margin: 1.1rem 0 0;
  }
  /* The recommended plan's button is the primary (ink) with the brand
     outline, ruled on #340; it was a solid indigo of its own. */
  .plan.highlight .cta {
    border-width: 2px;
    border-color: var(--brand);
  }
  .plan ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    /* The list's row is as tall as the longest list in the card row. */
    align-content: start;
    gap: 0.55rem;
  }
  .plan li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
  }
  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green);
    font-weight: 700;
  }
  .note {
    margin: 1.75rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-14);
  }
  .mor {
    margin: 2.5rem auto 0;
    max-width: var(--measure-prose);
    text-align: center;
    color: var(--muted);
    font-size: var(--fs-13);
  }
</style>
