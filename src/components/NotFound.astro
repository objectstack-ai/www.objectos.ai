---
import { blogPath, homePath, pricingPath, ui, LOCALES, LANG_NATIVE, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /**
   * The root 404 answers for URLs outside every locale, so it cannot know the
   * reader's language: it also offers each locale's home page.
   */
  languages?: boolean;
}

const { locale, languages = false } = Astro.props;
const t = ui[locale].notFound;
// Root-relative on purpose: a 404 page is served at whatever URL was missing,
// so a relative link would resolve against the mistyped address.
const links = [
  { href: homePath(locale), label: t.home },
  { href: blogPath(locale), label: t.blog },
  { href: pricingPath(locale), label: t.pricing },
];
---

<section class="not-found" aria-labelledby="not-found-title">
  <p class="code">404 · {t.title}</p>
  <h1 id="not-found-title">{t.heading}</h1>
  <p class="lead">{t.lead}</p>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a href={link.href}>{link.label}&nbsp;<span aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul>
  {languages && (
    <ul class="languages">
      {LOCALES.filter((l) => l !== locale).map((l) => (
        <li>
          <a href={homePath(l)} lang={l} hreflang={l}>{LANG_NATIVE[l]}</a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .not-found {
    max-width: 720px;
    padding: 2.5rem 0 1rem;
  }
  .not-found::before {
    content: '';
    display: block;
    width: 78px;
    height: 5px;
    margin-bottom: 1.4rem;
    background: linear-gradient(90deg, #057a58, var(--accent), #b7791f);
    border-radius: 999px;
  }
  .code {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font: 700 0.78rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: 0;
  }
  .lead {
    margin: 0 0 2rem;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
  .links,
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 18px 42px -34px rgba(var(--shadow), 0.52);
    transition: border-color 0.16s ease, color 0.16s ease;
  }
  .links a:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }
  .links span {
    color: var(--accent);
  }
  .languages {
    gap: 0.4rem 1rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
  }
  .languages a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .languages a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .not-found {
      padding-top: 1rem;
    }
    h1 {
      font-size: 2rem;
      line-height: 1.2;
    }
    .lead {
      font-size: 0.98rem;
    }
  }
</style>
