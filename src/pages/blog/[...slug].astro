---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostGroups, parseId } from '../../lib/posts';
import { homePath, postPath } from '../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const groups = await getPostGroups();
  const groupBySlug = new Map(groups.map((g) => [g.slug, g]));

  return posts.map((post) => {
    const { slug, locale } = parseId(post.id);
    const group = groupBySlug.get(slug)!;
    const en = group.langs['en'];
    const zh = group.langs['zh-Hans'];
    return {
      params: { slug: post.id },
      props: {
        post,
        locale,
        // Toggle targets: sibling translation if it exists, else that
        // language's article list.
        enHref: en ? postPath(en.id) : homePath('en'),
        zhHref: zh ? postPath(zh.id) : homePath('zh-Hans'),
      },
    };
  });
}

const { post, locale, enHref, zhHref } = Astro.props;
const { Content } = await render(post);
---

<BlogPost data={post.data} {locale} {enHref} {zhHref}>
  <Content />
</BlogPost>
