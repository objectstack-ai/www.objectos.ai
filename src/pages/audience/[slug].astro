---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getUsedAudiences } from '../../lib/posts';
import { audienceLabel, type AudienceSlug } from '../../lib/audiences';
import { ui } from '../../lib/i18n';

export async function getStaticPaths() {
  const items = await getUsedAudiences();
  return items.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: AudienceSlug };
const label = audienceLabel(slug, 'en');
---

<Base
  title={`${label} · ${ui.en.siteName}`}
  description={`${label} — articles on building AI-native software.`}
  locale="en"
  enHref={`/audience/${slug}`}
  zhHref={`/zh/audience/${slug}`}>
  <ArticleList locale="en" activeAudience={slug} />
</Base>
