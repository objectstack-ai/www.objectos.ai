---
import { getPostsInLocale } from '../lib/posts';
import { postPath } from '../lib/i18n';
import { termBySlug, termHref } from '../lib/terms';

const locale = 'zh-Hans';
const posts = (await getPostsInLocale(locale))
  .filter((post) => post.entry.data.status !== 'archived')
  .slice(0, 3);

const topicLink = (slug: string) => {
  const term = termBySlug(slug);
  return term ? termHref(locale, term) : `/${locale}/`;
};

const capabilities = [
  {
    index: '01',
    title: '让 AI 理解你的业务对象',
    copy: '把客户、订单、设备、工单等业务概念变成统一对象，让 Agent 能准确读取、关联和操作。',
  },
  {
    index: '02',
    title: '连接现有系统，不必推倒重来',
    copy: '在已有数据库、ERP、CRM 和自研系统之上增加统一 API、权限与智能能力。',
  },
  {
    index: '03',
    title: '从需求直接生成可运行应用',
    copy: '用声明式元数据描述业务，快速生成界面、流程、权限和接口，并持续演进。',
  },
  {
    index: '04',
    title: '把治理内置到每一次操作',
    copy: '复用企业身份、权限与审计体系，让 AI Agent 的每一次访问和修改都有边界。',
  },
];

const solutions = [
  {
    title: '智能 CRM',
    copy: '让客户信息、跟进记录与业务动作成为 AI 可以理解和执行的统一上下文。',
    href: topicLink('crm'),
    tone: 'green',
  },
  {
    title: '案件与工单管理',
    copy: '快速搭建可配置、可追踪、可自动分派的复杂业务流程。',
    href: topicLink('case-management'),
    tone: 'blue',
  },
  {
    title: '系统现代化',
    copy: '保留稳定运行的核心系统，在其上逐步叠加现代应用体验和 AI 能力。',
    href: topicLink('modernization'),
    tone: 'amber',
  },
];

const coverSrc = (cover: unknown): string =>
  typeof cover === 'string'
    ? cover
    : (cover as { src?: string })?.src ?? '';
---

<div class="home">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> AI-native 企业应用平台</p>
      <h1>让 AI 进入<br /><strong>企业业务系统</strong></h1>
      <p class="hero-lead">
        ObjectOS 把现有数据、业务对象、权限和流程连接成统一运行层，
        让团队与 AI Agent 更快构建并持续改进企业应用。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#capabilities">了解平台能力 <span>→</span></a>
        <a class="button secondary" href={topicLink('app-building')}>查看构建方法</a>
      </div>
      <dl class="proof">
        <div><dt>连接</dt><dd>现有系统与数据</dd></div>
        <div><dt>构建</dt><dd>可运行企业应用</dd></div>
        <div><dt>治理</dt><dd>AI 与业务操作</dd></div>
      </dl>
    </div>
    <div class="hero-media">
      <img
        src="/images/objectos-home-hero.png"
        alt="ObjectOS 连接业务数据、应用和 AI Agent 的产品示意图"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="media-note">
        <span class="live-dot"></span>
        <span><strong>统一业务对象层</strong>正在连接应用、数据与 Agent</span>
      </div>
    </div>
  </section>

  <section class="positioning" aria-label="平台定位">
    <p class="section-kicker">不是另一个需要迁移的平台</p>
    <h2>保留已经有效的系统，<br />补上面向 AI 的业务运行层。</h2>
    <p>
      企业真正需要的不是一次重建，而是一种让旧系统、新应用和 AI
      能够共同工作的方式。ObjectOS 从真实业务对象出发，把变化控制在可理解、可治理的范围内。
    </p>
  </section>

  <section class="capability-section" id="capabilities">
    <div class="section-head">
      <div>
        <p class="section-kicker">平台能力</p>
        <h2>从业务结构出发，<br />而不是从空白代码开始</h2>
      </div>
      <a class="text-link" href={topicLink('ai-agents')}>阅读 AI 与 Agent 文章 <span>→</span></a>
    </div>
    <ol class="capability-list">
      {capabilities.map((item) => (
        <li>
          <span class="cap-index">{item.index}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="workflow">
    <div class="workflow-intro">
      <p class="section-kicker">工作方式</p>
      <h2>把复杂业务压缩成<br />AI 可以可靠处理的结构</h2>
      <p>
        ObjectOS 用统一元数据描述对象、关系、权限和动作。Agent
        不需要猜测散落在代码里的业务规则，而是在清晰边界内完成工作。
      </p>
    </div>
    <div class="workflow-map" aria-label="ObjectOS 工作流程">
      <div class="map-row">
        <span class="map-label">你的现有系统</span>
        <div class="map-items">
          <span>CRM</span><span>ERP</span><span>数据库</span><span>自研系统</span>
        </div>
      </div>
      <div class="connector"><span></span><b>连接与建模</b><span></span></div>
      <div class="object-layer">
        <small>OBJECTOS BUSINESS OBJECT LAYER</small>
        <strong>对象 · 权限 · 流程 · API · 审计</strong>
      </div>
      <div class="connector"><span></span><b>安全执行</b><span></span></div>
      <div class="map-row outputs">
        <span class="map-label">持续产生价值</span>
        <div class="map-items">
          <span>业务应用</span><span>AI Agent</span><span>自动化</span>
        </div>
      </div>
    </div>
  </section>

  <section class="solution-section">
    <div class="section-head">
      <div>
        <p class="section-kicker">典型场景</p>
        <h2>先解决一个真实问题，<br />再逐步连接整个业务</h2>
      </div>
    </div>
    <div class="solution-grid">
      {solutions.map((solution) => (
        <a class:list={['solution', solution.tone]} href={solution.href}>
          <span class="solution-mark"></span>
          <h3>{solution.title}</h3>
          <p>{solution.copy}</p>
          <span class="solution-link">探索相关内容 →</span>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="articles">
      <div class="section-head">
        <div>
          <p class="section-kicker">最新洞察</p>
          <h2>关于 AI-native 软件的实践思考</h2>
        </div>
        <a class="text-link" href={`/${locale}/blog/topics/ai-agents`}>浏览 AI 与 Agent 文章 <span>→</span></a>
      </div>
      <div class="article-grid">
        {posts.map((post) => (
          <a class="article" href={postPath(locale, post.slug)}>
            {post.entry.data.cover && (
              <img
                src={coverSrc(post.entry.data.cover)}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <time>{post.entry.data.date.toISOString().slice(0, 10)}</time>
              <h3>{post.entry.data.title}</h3>
              <p>{post.entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="closing">
    <p class="section-kicker">下一步</p>
    <h2>从你最熟悉的一套业务数据开始。</h2>
    <p>连接一个现有系统，定义关键业务对象，让第一个 AI-native 应用真正运行起来。</p>
    <a class="button light" href={topicLink('integration-data')}>了解如何连接现有系统 <span>→</span></a>
  </section>
</div>

<style>
  .home {
    --home-green: #087f5b;
    --home-blue: #2563eb;
    --home-amber: #b45309;
  }
  .home :global(h1),
  .home :global(h2),
  .home :global(h3),
  .home :global(p) {
    margin-top: 0;
  }
  .hero {
    min-height: min(760px, calc(100vh - 104px));
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(460px, 1.1fr);
    gap: 2.5rem;
    align-items: center;
    padding: 1rem 0 4rem;
  }
  .eyebrow,
  .section-kicker {
    color: var(--home-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.35rem;
  }
  .eyebrow span {
    width: 26px;
    height: 1px;
    background: currentColor;
  }
  .hero h1 {
    font-size: clamp(3.15rem, 5vw, 4.65rem);
    line-height: 1.04;
    letter-spacing: 0;
    margin-bottom: 1.4rem;
    font-weight: 750;
  }
  .hero h1 strong {
    display: block;
    color: var(--home-green);
    font-weight: inherit;
    font-size: 0.9em;
    white-space: nowrap;
  }
  .hero-lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
    max-width: 35rem;
    margin-bottom: 1.8rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
  }
  .button:hover {
    transform: translateY(-1px);
  }
  .button.primary {
    color: white;
    background: #1c1917;
  }
  .button.secondary {
    border-color: var(--line);
    background: var(--surface);
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .proof div {
    display: flex;
    flex-direction: column;
  }
  .proof dt {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .proof dd {
    color: var(--muted);
    font-size: 0.75rem;
    margin: 0.1rem 0 0;
  }
  .hero-media {
    position: relative;
  }
  .hero-media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 30px 80px -46px rgba(19, 78, 58, 0.7);
  }
  .media-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    max-width: 250px;
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.75rem 0.85rem;
    color: #292524;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 6px;
    box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.4);
    font-size: 0.72rem;
    line-height: 1.5;
    backdrop-filter: blur(12px);
  }
  .media-note strong {
    display: block;
    font-size: 0.78rem;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    margin-top: 0.3rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.13);
  }
  .positioning {
    max-width: 850px;
    padding: 7rem 0 8rem;
  }
  .positioning h2,
  .section-head h2,
  .workflow-intro h2,
  .closing h2 {
    font-size: clamp(2rem, 4.2vw, 3.55rem);
    line-height: 1.18;
    letter-spacing: 0;
    margin-bottom: 1.3rem;
  }
  .positioning > p:last-child,
  .workflow-intro > p:last-child,
  .closing > p {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.9;
  }
  .capability-section,
  .workflow,
  .solution-section,
  .articles {
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .text-link {
    flex: 0 0 auto;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
  }
  .capability-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .capability-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0 1rem;
    padding: 2rem 1.5rem 2.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .capability-list li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .capability-list li:nth-child(even) {
    padding-left: 1.5rem;
  }
  .cap-index {
    grid-row: span 2;
    color: var(--home-green);
    font: 700 0.72rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .capability-list h3 {
    font-size: 1.12rem;
    line-height: 1.45;
    margin-bottom: 0.55rem;
  }
  .capability-list p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .workflow {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(440px, 1.25fr);
    gap: 5rem;
    align-items: center;
  }
  .workflow-map {
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .map-row {
    display: grid;
    gap: 0.8rem;
  }
  .map-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .map-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }
  .map-items span {
    display: grid;
    min-height: 54px;
    place-items: center;
    color: var(--ink-soft);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 650;
    text-align: center;
  }
  .outputs .map-items {
    grid-template-columns: repeat(3, 1fr);
  }
  .outputs .map-items span {
    color: var(--home-green);
    background: color-mix(in srgb, var(--home-green) 8%, var(--surface));
    border-color: color-mix(in srgb, var(--home-green) 25%, var(--line));
  }
  .connector {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.7rem;
    align-items: center;
    margin: 1rem 0;
    color: var(--muted);
  }
  .connector span {
    height: 1px;
    background: var(--line);
  }
  .connector b {
    font-size: 0.64rem;
    font-weight: 650;
  }
  .object-layer {
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem;
    color: white;
    background: #12352c;
    border-radius: 4px;
    text-align: center;
  }
  .object-layer small {
    color: #8ee3c2;
    font: 650 0.58rem/1.4 var(--font-mono);
  }
  .object-layer strong {
    font-size: 0.88rem;
  }
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .solution {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .solution:hover {
    transform: translateY(-3px);
    border-color: var(--tone);
  }
  .solution.green { --tone: var(--home-green); }
  .solution.blue { --tone: var(--home-blue); }
  .solution.amber { --tone: var(--home-amber); }
  .solution-mark {
    width: 34px;
    height: 5px;
    margin-bottom: auto;
    background: var(--tone);
  }
  .solution h3 {
    font-size: 1.35rem;
    margin-bottom: 0.65rem;
  }
  .solution p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 1.4rem;
  }
  .solution-link {
    color: var(--tone);
    font-size: 0.76rem;
    font-weight: 700;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .article {
    color: var(--ink);
    text-decoration: none;
  }
  .article img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: 1rem;
    border-radius: 4px;
    background: var(--surface-sunk);
  }
  .article time {
    color: var(--muted);
    font: 600 0.68rem/1 var(--font-mono);
  }
  .article h3 {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0.65rem 0 0.4rem;
  }
  .article p {
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .closing {
    margin-top: 7rem;
    padding: 5rem;
    color: white;
    background: #172b26;
    border-radius: 6px;
  }
  .closing .section-kicker {
    color: #8ee3c2;
  }
  .closing > p {
    color: #bdc9c5;
  }
  .button.light {
    margin-top: 1rem;
    color: #172b26;
    background: white;
  }
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
    }
    .hero-copy {
      max-width: 680px;
    }
    .workflow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
    .solution:last-child {
      grid-column: span 2;
      min-height: 240px;
    }
  }
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2.7rem;
    }
    .hero-media img {
      aspect-ratio: 4 / 3;
    }
    .media-note {
      display: none;
    }
    .proof {
      gap: 0.5rem;
    }
    .positioning,
    .capability-section,
    .workflow,
    .solution-section,
    .articles {
      padding: 4.5rem 0;
    }
    .section-head {
      display: block;
    }
    .section-head .text-link {
      display: inline-block;
      margin-top: 1.25rem;
    }
    .capability-list {
      grid-template-columns: 1fr;
    }
    .capability-list li,
    .capability-list li:nth-child(even) {
      padding: 1.5rem 0;
      border-right: none;
    }
    .workflow-map {
      padding: 1rem;
    }
    .map-items {
      grid-template-columns: repeat(2, 1fr);
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }
    .solution,
    .solution:last-child {
      grid-column: auto;
      min-height: 260px;
    }
    .closing {
      margin: 4rem -0.5rem 0;
      padding: 2.2rem 1.5rem;
    }
  }
</style>
