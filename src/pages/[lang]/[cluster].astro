---
import Base from '../../layouts/Base.astro';
import ClusterPage from '../../components/ClusterPage.astro';
import MarketingEvidencePage from '../../components/MarketingEvidencePage.astro';
import {
  getMarketingPages,
  getMarketingPageSourceLocale,
  marketingPageAlternates,
  marketingPageNavTargets,
  marketingPagePath,
} from '../../content-pages/registry';
import type { MarketingPage } from '../../content-pages/types';
import { clusterCopy } from '../../lib/cluster-i18n';
import { CLUSTERS, clusterPath, type Cluster } from '../../lib/clusters';
import { getPostsInLocale, type LocalePost } from '../../lib/posts';
import { htmlLang, homePath, LOCALES, postPath, segToLocale, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const cluster of CLUSTERS) {
      paths.push({
        params: { lang: locale, cluster: cluster.slug },
        props: { kind: 'cluster', cluster, locale },
      });
    }
    for (const page of getMarketingPages(locale)) {
      paths.push({
        params: { lang: locale, cluster: page.slug },
        props: { kind: 'marketing', page, locale },
      });
    }
  }
  return paths;
}

type Props =
  | { kind: 'cluster'; cluster: Cluster; locale: Locale }
  | { kind: 'marketing'; page: MarketingPage; locale: Locale };

const props = Astro.props as Props;
const currentLocale = segToLocale(Astro.params.lang!)!;
const posts = await getPostsInLocale(currentLocale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();

let title: string;
let description: string;
let canonical: string | undefined;
let noindex = false;
let alternates: Partial<Record<Locale, string>>;
// Only set where the switcher's targets differ from the hreflang set — i.e.
// marketing pages, which are built in every locale but authored in some.
let navAlternates: Partial<Record<Locale, string>> | undefined;
let jsonLd: Record<string, unknown>[];
let relatedPosts: LocalePost[] = [];

if (props.kind === 'marketing') {
  const page = props.page;
  const pagePath = marketingPagePath(currentLocale, page.slug);
  const sourceLocale = getMarketingPageSourceLocale(currentLocale, page.slug) ?? currentLocale;
  const canonicalPath =
    sourceLocale === currentLocale ? pagePath : marketingPagePath(sourceLocale, page.slug);
  const pageUrl = absoluteUrl(pagePath);
  title = `${page.title} · ObjectOS`;
  description = page.description;
  canonical = canonicalPath;
  noindex = sourceLocale !== currentLocale;
  alternates = marketingPageAlternates(page.slug);
  navAlternates = marketingPageNavTargets(page.slug);
  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: page.title,
      description: page.description,
      url: pageUrl,
      inLanguage: htmlLang(sourceLocale),
      isPartOf: {
        '@type': 'WebSite',
        name: 'ObjectOS',
        url: absoluteUrl(homePath(currentLocale)),
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'ObjectOS',
          item: absoluteUrl(homePath(currentLocale)),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: page.navLabel,
          item: pageUrl,
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ];
} else {
  const cluster = props.cluster;
  const copy = clusterCopy(cluster, currentLocale);
  const bySlug = new Map(posts.map((post) => [post.slug, post]));
  relatedPosts = cluster.articleSlugs
    .map((slug) => bySlug.get(slug))
    .filter((post): post is LocalePost => Boolean(post));
  const pagePath = clusterPath(currentLocale, cluster.slug);
  const pageUrl = absoluteUrl(pagePath);
  title = `${copy.title} · ObjectOS`;
  description = copy.description;
  alternates = Object.fromEntries(
    LOCALES.map((language) => [language, clusterPath(language, cluster.slug)])
  );
  jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: copy.title,
      description: copy.description,
      url: pageUrl,
      inLanguage: htmlLang(currentLocale),
      isPartOf: {
        '@type': 'WebSite',
        name: 'ObjectOS',
        url: absoluteUrl(homePath(currentLocale)),
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'ObjectOS',
          item: absoluteUrl(homePath(currentLocale)),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: copy.title,
          item: pageUrl,
        },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: copy.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: `${copy.title} reading path`,
      itemListElement: relatedPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteUrl(postPath(currentLocale, post.slug)),
        name: post.entry.data.title,
      })),
    },
  ];
}
---

<Base
  {title}
  {description}
  locale={currentLocale}
  {canonical}
  {noindex}
  {alternates}
  {navAlternates}
  jsonLd={jsonLd}>
  {
    props.kind === 'marketing' ? (
      <MarketingEvidencePage page={props.page} locale={currentLocale} />
    ) : (
      <ClusterPage cluster={props.cluster} locale={currentLocale} posts={relatedPosts} />
    )
  }
</Base>
