  /* A two-part heading is two block lines, each balanced on its own. A forced
     <br> between them kept the desktop shape but, once a part wrapped on a
     phone, left one word of it alone on a line ("model,", "agents."). */
  .title-line {
    display: block;
  }
  /* zh and ja headings break only at the <wbr> between phrases, so a word
     such as ソフトウェア or 网络 is never split across lines; a phrase wider
     than the line still breaks, as a last resort. ko breaks at its own
     spaces, so keep-all alone keeps 시스템 whole; no <wbr>. The ko card
     titles (h3) take it too: they carry no <wbr>, so zh and ja h3 cannot. */
  .home :global(h1:lang(zh)),
  .home :global(h1:lang(ja)),
  .home :global(h1:lang(ko)),
  .home :global(h2:lang(zh)),
  .home :global(h2:lang(ja)),
  .home :global(h2:lang(ko)),
  .home :global(h3:lang(ko)),
  .hero-lead:is(:lang(zh), :lang(ja)),
  .hero-category:is(:lang(zh), :lang(ja)) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* Single column since the overview video took over as the page's opening
     visual: the copy block runs full width and the video sits directly under
     it. No `min-height` floor here on purpose — the old one reserved a
     viewport's worth of space for the side image and would now do nothing but
     push the video below the fold. */
  /* Flex column so the phone breakpoint can reorder these six children with
     `order` alone. Centred, like the docs site hero: left-aligned copy in a
     single column left ~680px of a 1440px viewport empty where the side image
     used to be, and put the text on a different axis from the video. */
  .hero {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0 2.5rem;
    text-align: center;
  }
  .hero > .eyebrow,
  .hero > h1 {
    width: 100%;
    max-width: var(--measure-wide);
    margin-inline: auto;
  }
  /* No `justify-content` for the eyebrow: it is inline content now (see the
     `.eyebrow` rule below), centred by the hero's own `text-align: center`. */
  .hero > .hero-category,
  .hero > .hero-lead {
    margin-inline: auto;
  }
  .hero > .hero-actions {
    justify-content: center;
  }
  /* Wider than the copy column, and the gap the old separate video section
     used to get from the hero's bottom padding. */
  .hero-video,
  .hero > .proof {
    width: 100%;
    max-width: var(--measure-media);
    margin-inline: auto;
  }
  .hero-video {
    margin-top: 2rem;
    margin-bottom: 0;
  }
  /* The rule is a lead-in glued to the first word, not a column of its own.
     As a flex row the rule and the text were two flex items: the text item
     took all the remaining width and centred itself inside it, so the moment
     the eyebrow wrapped — every locale at ≤390px, measured — the rule was
     stranded at the far left, 37-55px from the nearest word and floating at
     the vertical middle of the two lines, reading as a stray mark rather than
     a lead-in. Laid out as inline content instead, the rule stays on the
     first line immediately before the first word, wherever `text-align:
     center` puts that line.

     This is deliberately not a phone-only override. At ≥414px, where the
     eyebrow is a single line in every locale, inline flow reproduces the flex
     row's geometry: same 8.8px gap (`margin-right` replaces the `gap`), rule
     centred on the line to within 0.06px, and the eyebrow box the same height
     — which is what keeps the video below it from moving. */
  .eyebrow {
    display: block;
    margin-bottom: 1.35rem;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .eyebrow span {
    display: inline-block;
    width: 26px;
    height: 1px;
    margin-right: 0.55rem;
    vertical-align: middle;
    background: currentColor;
  }
  .hero h1 {
    /* Sized by whichever axis is tighter. The headline was sized off width
       alone, so a 1366x768 laptop got a 74px two-line headline — ~216px, the
       single largest thing between the top of the page and the video. The
       `8vh` term is self-limiting: 8vh reaches the 5rem ceiling at 1000px of
       viewport height, so a tall desktop computes exactly what it computed
       before, and the size meets the old value continuously rather than
       stepping at a breakpoint.
       (`vh` is the large viewport height, so a collapsing mobile URL bar does
       not resize it — and phones take the fixed 2.7rem below anyway.) */
    font-size: var(--fs-hero);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    margin-bottom: 0.9rem;
    /* The single-column hero gives the headline a wider measure than the old
       two-column one did, which left a one-word orphan on its second line. */
    text-wrap: balance;
  }
  /* The emphasis stays inline (#360): the headline is one line on a desktop
