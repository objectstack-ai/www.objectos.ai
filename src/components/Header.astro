---
import { ui, homePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  enHref: string;
  zhHref: string;
}

const { locale, enHref, zhHref } = Astro.props;
const t = ui[locale];
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={homePath(locale)}>
      <span class="mark">◆</span>
      <span class="name">{t.siteName}</span>
      <span class="sep">/</span>
      <span class="nav">{t.nav}</span>
    </a>

    <nav class="lang" aria-label="Language">
      <a
        class:list={['seg', { active: locale === 'en' }]}
        href={enHref}
        aria-current={locale === 'en' ? 'true' : undefined}>EN</a
      >
      <a
        class:list={['seg', { active: locale === 'zh-Hans' }]}
        href={zhHref}
        aria-current={locale === 'zh-Hans' ? 'true' : undefined}>中文</a
      >
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    height: 58px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .mark {
    color: var(--accent);
    font-size: 0.7rem;
    transform: translateY(-1px);
  }
  .name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .sep {
    color: var(--muted);
  }
  .nav {
    color: var(--ink-soft);
    font-weight: 450;
  }

  .lang {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .seg {
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s, background 0.15s;
  }
  .seg:hover {
    color: var(--ink);
  }
  .seg.active {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
</style>
