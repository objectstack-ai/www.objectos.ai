---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { LOCALES, segToLocale, refundsPath } from '../../lib/i18n';
import { refundsCopy } from '../../lib/legal';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = refundsCopy[locale];
const alternates = Object.fromEntries(LOCALES.map((language) => [language, refundsPath(language)]));
---

<Base title={`${copy.title} · ObjectOS`} description={copy.description} {locale} {alternates}>
  <LegalPage {copy} />
</Base>
