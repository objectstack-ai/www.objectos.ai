---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { ui, homePath, STATUS_COLOR, type Locale } from '../lib/i18n';
import { termBySlug, termHref, termLabel } from '../lib/terms';

interface Props {
  data: CollectionEntry<'blog'>['data'];
  locale: Locale;
  enHref: string;
  zhHref: string;
}

const { data, locale, enHref, zhHref } = Astro.props;
const t = ui[locale];
const dateStr = data.date.toISOString().slice(0, 10);
---

<Base
  title={data.title}
  description={data.description}
  canonical={data.canonical_url}
  {locale}
  {enHref}
  {zhHref}>
  <article>
    <a class="back" href={homePath(locale)}>← {t.backToList}</a>

    <header class="post-head">
      <div class="meta">
        <a class="cat topic" href={termHref(locale, termBySlug(data.topic)!)}>
          {termLabel(data.topic, locale)}
        </a>
        <a class="cat" href={termHref(locale, termBySlug(data.audience)!)}>
          {termLabel(data.audience, locale)}
        </a>
        {
          (data.solutions ?? []).map((slug) => (
            <a class="cat" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        {
          (data.industries ?? []).map((slug) => (
            <a class="cat" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        <span class="pill" style={`--c:${STATUS_COLOR[data.status]}`}>
          {t.status[data.status]}
        </span>
        <span class="dot">·</span>
        <time>{dateStr}</time>
        <span class="dot">·</span>
        <span>{t.by} {data.author}</span>
      </div>

      <h1>{data.title}</h1>
      {data.description && <p class="lead">{data.description}</p>}

      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      {
        data.channels.length > 0 && (
          <div class="channels">
            <span class="channels-label">{t.alsoOn}</span>
            {data.channels.map((c) => (
              <a href={c.url} target="_blank" rel="noopener">
                {c.platform}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <style>
    .back {
      display: inline-block;
      margin-bottom: 2rem;
      font-size: 0.85rem;
      color: var(--ink-soft);
      text-decoration: none;
    }
    .back:hover {
      color: var(--ink);
    }
    .post-head {
      padding-bottom: 2rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--line);
    }
    .meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: var(--ink-soft);
      margin-bottom: 1.1rem;
    }
    .cat {
      font-size: 0.78rem;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.15rem 0.55rem;
      border-radius: 5px;
      text-decoration: none;
    }
    .cat:hover {
      background: color-mix(in srgb, var(--accent) 16%, var(--surface));
    }
    .dot {
      color: var(--muted);
    }
    h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin: 0 0 0.8rem;
    }
    .lead {
      font-size: 1.15rem;
      line-height: 1.55;
      color: var(--ink-soft);
      margin: 0;
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      padding: 0;
      margin: 1.4rem 0 0;
    }
    .tags li {
      font-size: 0.74rem;
      color: var(--ink-soft);
      background: var(--surface-sunk);
      border-radius: 5px;
      padding: 0.15rem 0.55rem;
    }
    .channels {
      margin-top: 1.2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.85rem;
    }
    .channels-label {
      color: var(--muted);
    }
    .channels a {
      text-decoration: none;
      background: var(--accent-soft);
      padding: 0.1rem 0.5rem;
      border-radius: 5px;
    }
  </style>

  <style is:global>
    .prose {
      font-size: 1.06rem;
      line-height: 1.75;
      color: #292524;
    }
    .prose > :first-child {
      margin-top: 0;
    }
    .prose h2 {
      font-size: 1.5rem;
      letter-spacing: -0.01em;
      margin: 2.6rem 0 1rem;
      line-height: 1.25;
    }
    .prose h3 {
      font-size: 1.2rem;
      margin: 2rem 0 0.75rem;
    }
    .prose p {
      margin: 0 0 1.25rem;
    }
    .prose a {
      color: var(--accent);
      text-underline-offset: 2px;
    }
    .prose strong {
      color: var(--ink);
      font-weight: 650;
    }
    .prose ul,
    .prose ol {
      padding-left: 1.4rem;
      margin: 0 0 1.25rem;
    }
    .prose li {
      margin: 0.4rem 0;
    }
    .prose blockquote {
      margin: 1.5rem 0;
      padding: 0.4rem 0 0.4rem 1.2rem;
      border-left: 3px solid var(--line);
      color: var(--ink-soft);
    }
    .prose blockquote p {
      margin: 0;
    }
    .prose hr {
      border: none;
      border-top: 1px solid var(--line);
      margin: 2.5rem 0;
    }
    .prose img {
      max-width: 100%;
      border-radius: 8px;
      display: block;
      margin: 1.5rem auto;
    }
    .prose :not(pre) > code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: var(--surface-sunk);
      padding: 0.12em 0.4em;
      border-radius: 4px;
    }
    .prose pre {
      margin: 1.5rem 0;
      padding: 1rem 1.15rem;
      border-radius: 10px;
      overflow-x: auto;
      font-size: 0.86rem;
      line-height: 1.6;
      border: 1px solid var(--line);
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.95rem;
    }
    .prose th,
    .prose td {
      border: 1px solid var(--line);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }
    .prose th {
      background: var(--surface-sunk);
    }
  </style>
</Base>
