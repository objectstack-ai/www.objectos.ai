---
import { getPostGroups, entryFor } from '../lib/posts';
import { ui, postPath, STATUS_COLOR, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const groups = await getPostGroups();
---

<section class="hero">
  <h1>{t.articlesTitle}</h1>
  <p class="lead">{t.articlesLead(groups.length)}</p>
</section>

{
  groups.length === 0 ? (
    <p class="empty">{t.empty}</p>
  ) : (
    <ul class="list">
      {groups.map((g) => {
        const entry = entryFor(g, locale);
        const d = entry.data;
        return (
          <li>
            <a class="card" href={postPath(entry.id)}>
              <div class="top">
                <span class="pill" style={`--c:${STATUS_COLOR[d.status]}`}>
                  {t.status[d.status]}
                </span>
                <time>{d.date.toISOString().slice(0, 10)}</time>
              </div>
              <h2>{d.title}</h2>
              <p class="desc">{d.description}</p>
              {d.channels.length > 0 && (
                <div class="foot">
                  <span class="chcount">
                    {t.alsoOn} {d.channels.map((c) => c.platform).join(' · ')}
                  </span>
                </div>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .hero {
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
  }
  .hero .lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .empty {
    color: var(--ink-soft);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list > li + li {
    margin-top: 0.75rem;
  }
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.35rem 1.5rem;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    box-shadow: 0 6px 24px -12px rgba(28, 25, 23, 0.25);
    transform: translateY(-1px);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .top time {
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .card h2 {
    font-size: 1.3rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 0.4rem;
    transition: color 0.18s ease;
  }
  .card:hover h2 {
    color: var(--accent);
  }
  .desc {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .chcount {
    color: var(--ink-soft);
  }
</style>
