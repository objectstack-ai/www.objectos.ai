---
import Base from '../../layouts/Base.astro';
import MarketingHome from '../../components/MarketingHome.astro';
import { segToLocale, homePath, LOCALES } from '../../lib/i18n';
import { homeCopy } from '../../lib/home';
import { ORGANIZATION_ID } from '../../lib/organization';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = homeCopy[locale];
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
// No `offers` on the SoftwareApplication yet: the headline price is pending a
// maintainer ruling (www#214 — $20/$45 billed annually here vs $24/$54 monthly
// on docs), and structured data must not assert either price until then.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: copy.title,
    description: copy.description,
    url: absoluteUrl(homePath(locale)),
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ObjectOS',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: copy.description,
    url: absoluteUrl(homePath(locale)),
    publisher: {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: 'ObjectStack AI LLC',
    },
  },
];
---

<Base
  title={copy.title}
  description={copy.description}
  jsonLd={jsonLd}
  {locale}
  {alternates}>
  <MarketingHome {locale} />
</Base>
