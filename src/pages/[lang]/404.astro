---
// The localized 404 for each locale. Astro emits this route as
// `<locale>/404/index.html` (only the top-level `/404` gets a `404.html` name);
// the `locale-404` integration in astro.config.mjs moves it to
// `<locale>/404.html`, the name Cloudflare Pages looks for when it walks up
// from a missing URL to the nearest 404 page. See src/pages/404.astro.
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { LOCALES, localeSeg, ui, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: localeSeg(locale) }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---

<Base
  title={`${t.notFound.title} · ${t.siteName}`}
  description={t.notFound.lead}
  {locale}
  canonical={null}
  noindex>
  <NotFound {locale} />
</Base>
