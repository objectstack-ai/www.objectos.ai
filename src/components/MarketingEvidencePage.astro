---
import { Image } from 'astro:assets';
import heroImage from '../assets/objectos-home-hero.png';
import { getMarketingPage, getMarketingPages, marketingPagePath } from '../content-pages/registry';
import { clusterBySlug, clusterPath } from '../lib/clusters';
import { clusterCopy } from '../lib/cluster-i18n';
import { SCENARIO_READINESS, type MarketingPage } from '../content-pages/types';
import { marketingPageUi } from '../content-pages/ui';
import { cardSpans } from '../lib/card-rows';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import { postPath, pricingPath, securityPath, type Locale } from '../lib/i18n';
import { getPostsInLocale } from '../lib/posts';

interface Props {
  page: MarketingPage;
  locale: Locale;
}

const { page, locale } = Astro.props;
const pages = getMarketingPages(locale);
const ui = marketingPageUi(locale);
const relatedPages = pages.filter((item) => item.slug !== page.slug);
const marketingSlugs = new Set(pages.map((item) => item.slug));
// Blog posts are built only for the locales that have a file, so a post link
// is localized only where that locale's post exists; otherwise the English
// post is the right target, not a 404. Same rule as content-lint's
// cross-locale check and gen-zh-hant's link rewrite.
const localePostSlugs = new Set((await getPostsInLocale(locale)).map((post) => post.slug));
const localizeHref = (href: string): string => {
  const post = href.match(/^\/en\/blog\/([^/#]+)\/?(#.*)?$/);
  if (post) {
    const [, slug, hash = ''] = post;
    return localePostSlugs.has(slug) ? `${postPath(locale, slug)}${hash}` : href;
  }
  const match = href.match(/^\/en\/([^/#]+)\/?(#.*)?$/);
  if (!match) return href;
  const [, slug, hash = ''] = match;
  if (marketingSlugs.has(slug)) return `${marketingPagePath(locale, slug)}${hash}`;
  if (slug === 'security') return securityPath(locale);
  if (slug === 'pricing') return pricingPath(locale);
  return href;
};
// Scenario cards (/use-cases/) summarize existing posts and point at existing
// templates and guides; a card whose post, template or guide does not exist
// fails `astro build` here rather than shipping a dead or invented link. The
// post is checked against English, where every post has its source; the
// template against this locale's /templates/ catalog ids.
const englishPostSlugs = new Set((await getPostsInLocale('en')).map((post) => post.slug));
const templateIds = new Set(
  (getMarketingPage(locale, 'templates')?.sections ?? [])
    .flatMap((section) => section.items)
    .map((item) => item.id)
    .filter(Boolean)
);
const templateAnchor = (name: string): string => `template-${name}`;
for (const section of page.sections) {
  for (const item of section.items) {
    const scenario = item.scenario;
    if (!scenario) continue;
    const where = `${locale}/${page.slug} #${section.id} "${item.title}"`;
    if (!englishPostSlugs.has(scenario.post)) {
      throw new Error(`Scenario card ${where}: no post "${scenario.post}" in content/blog`);
    }
    if (scenario.template && !templateIds.has(templateAnchor(scenario.template))) {
      throw new Error(`Scenario card ${where}: no template "${scenario.template}" in the /templates/ catalog`);
    }
    if (scenario.guide && !clusterBySlug(scenario.guide)) {
      throw new Error(`Scenario card ${where}: no guide (cluster) "${scenario.guide}"`);
    }
    // Every card states how far it is from running (#370): exactly one of the
    // closed set, so a scenario cannot ship without a stated tier.
    if (!(SCENARIO_READINESS as readonly string[]).includes(scenario.readiness)) {
      throw new Error(
        `Scenario card ${where}: readiness "${scenario.readiness ?? ''}" is not one of ${SCENARIO_READINESS.join(' | ')}`
      );
    }
  }
}
const hasScenarios = page.sections.some((section) => section.items.some((item) => item.scenario));
const guideLink = (slug: string) => {
  const cluster = clusterBySlug(slug)!;
  return { href: clusterPath(locale, slug), label: clusterCopy(cluster, locale).shortTitle };
};
// The hero is served as WebP at the width its box needs instead of the 1.7 MB
// PNG. The box crops the 1.6:1 image with object-fit: cover, so the image is
// drawn wider than the box: 415x340 on a desktop needs 545px of image, a
// phone's 4:3 box about 1.2x its own width. It is in the first screen at
// every viewport (top at 172px on a desktop, the LCP element there; at
// 713-781px of an 800-844px phone), so it stays eager.
const HERO_WIDTHS = [400, 560, 840, 1200, 1586];
const HERO_SIZES = '(max-width: 640px) calc(120vw - 4.5rem), (max-width: 860px) calc(100vw - 5rem), 545px';
// Headings in zh and ja carry a <wbr> between phrases (scripts/lib/cjk-phrases.mjs)
// and break nowhere else; the copy itself is unchanged.
const ph = (text: string): string => phraseHtml(text, locale);
---

<article class="evidence-page">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 set:html={ph(page.heroTitle)} />
      <p class="lead">{page.lead}</p>
      <div class="actions">
        <a class="btn btn-primary" href={localizeHref(page.primary.href)}>{page.primary.label}</a>
        <a class="btn btn-secondary" href={localizeHref(page.secondary.href)}>{page.secondary.label}</a>
      </div>
    </div>
    <div class="hero-panel" aria-label={ui.loopLabel}>
      <Image
        class="hero-snapshot"
        src={heroImage}
        alt="ObjectOS product surface connecting business data, applications, and AI agents"
        widths={HERO_WIDTHS}
        sizes={HERO_SIZES}
        format="webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="loop-step write">
        <span>{ui.loop.writer.eyebrow}</span>
        <strong>{ui.loop.writer.title}</strong>
        <small>{ui.loop.writer.body}</small>
      </div>
      <div class="loop-line"></div>
      <div class="loop-step review">
        <span>{ui.loop.reviewer.eyebrow}</span>
        <strong>{ui.loop.reviewer.title}</strong>
        <small>{ui.loop.reviewer.body}</small>
      </div>
      <div class="loop-line"></div>
      <div class="loop-step runtime">
        <span>{ui.loop.runtime.eyebrow}</span>
        <strong>{ui.loop.runtime.title}</strong>
        <small>{ui.loop.runtime.body}</small>
      </div>
    </div>
  </section>

  <dl class="metrics card-grid">
    {page.metrics.map((metric) => (
      <div>
        <dt>{metric.value}</dt>
        <dd>{metric.label}</dd>
      </div>
    ))}
  </dl>

  {hasScenarios && (
    <p class="readiness-legend">
      <span>{ui.scenario.readinessLegend}</span>
      {SCENARIO_READINESS.map((tier) => (
        <span class:list={['chip', 'readiness-chip', `readiness-${tier}`]}>{ui.scenario.readiness[tier]}</span>
      ))}
    </p>
  )}

  <section class="artifact" aria-labelledby="artifact-title">
    <div>
      <p class="eyebrow">{page.artifact.eyebrow}</p>
      <h2 id="artifact-title" set:html={ph(page.artifact.title)} />
      <p>{page.artifact.body}</p>
    </div>
    {
      page.artifact.code ? (
        <pre tabindex="0" role="group" aria-labelledby="artifact-title"><code>{page.artifact.code}</code></pre>
      ) : (
        <ol>
          {page.artifact.steps?.map((step) => <li>{step}</li>)}
        </ol>
      )
    }
  </section>

  {page.sections.map((section) => (
    <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-head">
        <p class="eyebrow">{section.eyebrow}</p>
        <h2 id={`${section.id}-title`} set:html={ph(section.title)} />
        <p>{section.copy}</p>
      </div>
      <div class="item-grid">
        {section.items.map((item, index) => item.scenario ? (
          <div class:list={['item', 'scenario', `span-${cardSpans(section.items.length)[index]}`]} id={item.id}>
            <h3>{item.title}</h3>
            <p class="scenario-readiness">
              <span class:list={['chip', 'readiness-chip', `readiness-${item.scenario.readiness}`]}>{ui.scenario.readiness[item.scenario.readiness]}</span>
            </p>
            <dl>
              <div>
                <dt>{ui.scenario.today}</dt>
                <dd>{item.body}</dd>
              </div>
              <div>
                <dt>{ui.scenario.withAi}</dt>
                <dd>{item.scenario.withAi}</dd>
              </div>
              <div>
                <dt>{ui.scenario.approves}</dt>
                <dd>{item.scenario.approves}</dd>
              </div>
            </dl>
            <div class="scenario-links">
              <a class="btn btn-ghost" href={localizeHref(`/en/blog/${item.scenario.post}/`)}>{ui.scenario.readPost}&nbsp;<span aria-hidden="true">→</span></a>
              {item.scenario.template && (
                <a class="chip" href={`${marketingPagePath(locale, 'templates')}#${templateAnchor(item.scenario.template)}`}>{ui.scenario.template} · {item.scenario.template}</a>
              )}
              {item.scenario.guide && (
                <a class="chip" href={guideLink(item.scenario.guide).href}>{ui.scenario.guide} · {guideLink(item.scenario.guide).label}</a>
              )}
            </div>
          </div>
        ) : (
          <div class:list={['item', `span-${cardSpans(section.items.length)[index]}`]} id={item.id}>
            {/* An item without a meta label still takes the meta row when a
                sibling has one, so every title in the grid starts at the same
                height. */}
            {item.meta ? (
              <span>{item.meta}</span>
            ) : (
              section.items.some((other) => other.meta) && <span aria-hidden="true">&nbsp;</span>
            )}
            <h3>
              {item.href ? (
                <a href={localizeHref(item.href)}>{item.title}&nbsp;<span class="item-arrow" aria-hidden="true">→</span></a>
              ) : (
                item.title
              )}
            </h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  {
    page.table && (
      <section class="table-section" aria-labelledby="table-title">
        <div class="section-head compact">
          <p class="eyebrow">{page.table.eyebrow ?? ui.decisionEyebrow}</p>
          <h2 id="table-title" set:html={ph(page.table.title ?? ui.decisionTitle)} />
        </div>
        <div class="table-wrap" tabindex="0" role="group" aria-labelledby="table-title">
          <table>
            <thead>
              <tr>
                {page.table.columns.map((column) => <th>{column}</th>)}
              </tr>
            </thead>
            <tbody>
              {page.table.rows.map((row) => (
                <tr>
                  {row.map((cell) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    page.checklist && (
      <section class="checklist" aria-labelledby="checklist-title">
        <div>
          <p class="eyebrow">{ui.checklistEyebrow}</p>
          <h2 id="checklist-title" set:html={ph(page.checklistTitle ?? '')} />
        </div>
        <ul>
          {page.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )
  }

  <section class="faq" aria-labelledby="faq-title">
    <div class="section-head compact">
      <p class="eyebrow">{ui.faqEyebrow}</p>
      <h2 id="faq-title" set:html={ph(ui.faqTitle)} />
    </div>
    <div class="faq-list">
      {page.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="next">
    <div>
      <p class="eyebrow">{ui.nextEyebrow}</p>
      <h2 set:html={ph(ui.nextTitle)} />
    </div>
    <div class="next-links">
      {relatedPages.slice(0, 4).map((item) => (
        <a href={marketingPagePath(locale, item.slug)}>
          <strong>{item.navLabel}</strong>
          <span>{item.description}</span>
        </a>
      ))}
    </div>
  </section>
</article>

<style>
  /* Colours, type and boxes are the Base.astro tokens: --green is the
     emphasis (eyebrows, step and card labels, list marks), --brand the
     interaction (arrows, card hover), --ink the action (buttons). */
  .evidence-page :global(h1),
  .evidence-page :global(h2),
  .evidence-page :global(h3),
  .evidence-page :global(p) {
    margin-top: 0;
  }
  /* The copy column is the wider one: at 0.95fr it was 572px at 1366, which
     ran the h1 to five lines and the longest lead to eight. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.75fr);
    gap: 2.5rem;
    align-items: start;
    padding: 1.25rem 0 4rem;
  }
  .hero > *,
  .artifact > *,
  .checklist > *,
  .next > * {
    min-width: 0;
  }
  /* Balanced: "What changes, who reviews it, what runs" left "runs" alone at
     every desktop width on all 15 pages. */
  h1,
  h2 {
    font-family: var(--font-display);
    letter-spacing: 0;
    text-wrap: balance;
  }
  /* zh and ja headings break only at the <wbr> between phrases, so a word
     such as 可投入 or 環境 is never split across lines; a phrase wider than
     the line still breaks, as a last resort. ko breaks at its own spaces;
     it needs no <wbr>. */
  h1:lang(zh),
  h1:lang(ja),
  h1:lang(ko),
  h2:lang(zh),
  h2:lang(ja),
  h2:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* Sized by whichever axis is tighter, as the home hero is. Off width alone
     a 1366x625 laptop got a 69.7px headline over three to five lines, and the
     primary CTA sat below the fold on 14 of 15 pages (bottom at 626-899px).
     7.4vh is 46px there, 55px at 1440x750 and 61px at 1512x830; it stops
     binding at 962px of viewport height, so a tall desktop is unchanged.
     Tablets keep the 2.9rem floor; phones take the fixed size below. */
  h1 {
    max-width: var(--measure-wide);
    margin: 0 0 1.35rem;
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
  }
  .lead {
    max-width: var(--measure-prose);
    color: var(--ink-soft);
    font-size: var(--fs-17);
    line-height: var(--lh-prose);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.7rem;
  }
  /* The rest of the fold budget, desktop only: with the two changes above the
     longest page (FDE, an eight-line lead) still ended at 650px at 1366x625. */
  @media (min-width: 861px) {
    .hero {
      padding-top: 0.25rem;
    }
    .lead {
      line-height: var(--lh-body);
    }
    .actions {
      margin-top: 1.4rem;
    }
  }
  .hero-panel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 88%, transparent), color-mix(in srgb, var(--brand-soft) 32%, transparent)),
      var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .hero-snapshot {
    display: block;
    grid-column: 1 / -1;
    width: 100%;
    height: clamp(240px, 28vw, 340px);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface-sunk);
  }
  /* Dark theme: the hero is a white product render, which stayed a glaring
     white block on the dark page. The image itself is dimmed (no dark variant
     of the render exists); the hues and the depth survive, the white does
     not dominate the panel. */
  :global(:root[data-theme='dark']) .hero-snapshot {
    filter: brightness(0.6) contrast(1.12);
  }
  .loop-step {
    min-height: 124px;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface);
  }
  /* The three step labels are one colour: the blue and amber they used to
     take were decoration, and amber is a status colour. */
  .loop-step span {
    display: inline-flex;
    margin-bottom: 0.42rem;
    color: var(--green);
    font: 700 var(--fs-12)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .loop-step strong {
    display: block;
    color: var(--ink);
    font-size: var(--fs-16);
    line-height: var(--lh-heading);
  }
  .loop-step small {
    display: block;
    margin-top: 0.24rem;
    color: var(--muted);
    font-size: var(--fs-13);
    line-height: var(--lh-ui);
  }
  .loop-line {
    display: none;
  }
  .metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 5rem;
  }
  .metrics div {
    min-height: 150px;
    padding: 1.2rem;
  }
  .metrics dt {
    color: var(--ink);
    font-size: var(--fs-30);
    font-weight: 700;
    line-height: var(--lh-display);
    font-variant-numeric: tabular-nums;
  }
  .metrics dd {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
  }
  .artifact,
  .section,
  .table-section,
  .checklist,
  .faq,
  .next {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 104px;
  }
  .artifact {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(420px, 1.25fr);
    gap: 3rem;
    align-items: start;
  }
  .artifact h2,
  .section-head h2,
  .checklist h2,
  .next h2 {
    margin: 0 0 0.9rem;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
  }
  .artifact p,
  .section-head p,
  .checklist p {
    color: var(--ink-soft);
    line-height: var(--lh-prose);
  }
  pre {
    margin: 0;
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--line) 84%, transparent);
    border-radius: var(--r-card);
    background: var(--panel-ink);
    color: var(--on-panel);
    padding: 1.15rem;
    box-shadow: var(--shadow-md);
  }
  code {
    font: var(--fs-13)/var(--lh-body) var(--font-mono);
  }
  .artifact ol,
  .checklist ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .artifact li,
  .checklist li {
    position: relative;
    padding: 0.85rem 0.95rem 0.85rem 2.45rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--ink-soft);
  }
  .artifact li::before,
  .checklist li::before {
    content: '';
    position: absolute;
    top: 1.18rem;
    left: 1rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: var(--r-pill);
    background: var(--green);
  }
  .section-head {
    max-width: var(--measure-prose);
    margin-bottom: 1.45rem;
  }
  .section-head.compact {
    max-width: var(--measure-wide);
  }
  /* Six tracks, so a row holds three cards (span 2) or two (span 3): the
     count decides the rows (src/lib/card-rows.ts), and no section ends on a
     lone card. A fixed three columns left one card with two-thirds of its
     row empty in every four-card section. */
  .item-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 861px) {
    .item.span-2 {
      grid-column: span 2;
    }
    .item.span-3 {
      grid-column: span 3;
    }
    .item.span-6 {
      grid-column: 1 / -1;
    }
  }
  .item {
    min-height: 210px;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  /* Child combinator: a descendant selector also caught the arrow inside a
     linked title, making those titles 38px tall against 22px for plain ones. */
  .item > span {
    display: inline-flex;
    margin-bottom: 1.2rem;
    color: var(--green);
    font: 700 var(--fs-12)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .item h3 {
    margin-bottom: 0.55rem;
    font-size: var(--fs-18);
    line-height: var(--lh-heading);
  }
  .item h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* A linked title covers its whole card, so the card is the tap target
     rather than the 19px title line; it is the card's only link. */
  .item {
    position: relative;
  }
  .item h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .item h3 a:hover {
    text-decoration: underline;
  }
  .item-arrow {
    color: var(--brand);
  }
  .item p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-prose);
  }
  /* Anchored items (the template catalog) land below the sticky header. */
  .item[id] {
    scroll-margin-top: 104px;
  }
  /* Scenario cards: three labelled rows and a link row at the bottom. The
     card holds two or three links, so the title is not stretched over it. */
  .scenario {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  /* Readiness (#370): a plain chip with a status dot, on each scenario card
     and in the legend under the metrics. The label carries the meaning; the
     dot only helps the eye match a card to the legend: green and amber are
     status colours, the rule tier a hollow ring (indigo stays interaction). */
  .metrics:has(+ .readiness-legend) {
    margin-bottom: 1.25rem;
  }
  .readiness-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 5rem;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
  }
  .readiness-chip {
    white-space: normal;
  }
  .readiness-chip::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--r-pill);
    background: var(--muted);
  }
  .readiness-today::before {
    background: var(--green);
  }
  .readiness-integration::before {
    background: var(--amber);
  }
  .readiness-rule::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--muted);
  }
  .scenario .scenario-readiness {
    margin: 0 0 0.9rem;
  }
  .scenario dl {
    display: grid;
    gap: 0.7rem;
    margin: 0 0 1.1rem;
