---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { OG_IMAGE, postShareImage } from '../../scripts/lib/og-image.mjs';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import { formatDate, ui, blogPath, postPath, STATUS_COLOR, type Locale } from '../lib/i18n';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { getPostsInLocale, isPublicPost } from '../lib/posts';
import { darkCover } from '../lib/cover-variant';
import { clusterCopy, clusterLabels } from '../lib/cluster-i18n';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { ORGANIZATION_ID } from '../lib/organization';

interface Props {
  data: CollectionEntry<'blog'>['data'];
  slug: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { data, slug, locale, alternates } = Astro.props;
const t = ui[locale];
const dateStr = data.date.toISOString().slice(0, 10);
const displayDate = formatDate(locale, data.date);
// `updated` is optional: most posts have never been revised. When it is absent
// the article's last modification IS its publication, which is what the
// structured data below must say — `dateModified` is not optional in
// schema.org's BlogPosting the way the frontmatter field is.
const updatedStr = data.updated ? data.updated.toISOString().slice(0, 10) : null;
const updatedDisplay = data.updated ? formatDate(locale, data.updated) : null;
const modifiedIso = (data.updated ?? data.date).toISOString();
// The header cover is the LCP element on a phone, so a raster cover is served
// as WebP at the width the column needs instead of the 1.5-1.9 MB original:
// the article is at most 860px wide, and the phone column is the viewport less
// the 1rem gutters. The widest candidate covers a 2x desktop screen; Astro
// caps the list at the file's own width. An SVG cover is already a few KB and
// scales itself, so it is served as is.
const COVER_WIDTHS = [480, 720, 960, 1280, 1600];
const COVER_SIZES = '(min-width: 908px) 860px, calc(100vw - 2rem)';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
const currentUrl = site ? `${site}${Astro.url.pathname}` : Astro.url.href;
// The share image (`og:image`, `twitter:image`, `BlogPosting.image`): a
// 1200x630 JPEG that scripts/og-images.mjs draws after `astro build`, one per
// locale page: this page's title, the cover's art on its ground and the
// ObjectOS mark (scripts/lib/og-composite.mjs). The networks draw no card for
// an SVG, and a cover under spec v2 carries no title. Its URL comes from the
// rule the renderer uses too (scripts/lib/og-image.mjs), which reads the cover
// path and the title from this locale's frontmatter: `data.cover` only carries
// the built asset, so the entry is looked up for its file. That script fails
// the build if a page names a file it did not render, or a size that is not
// the file's.
const entry = await getEntry('blog', locale === 'en' ? slug : `${slug}.${locale}`);
const share = entry?.filePath ? postShareImage(entry.filePath) : undefined;
if (data.cover && !share) {
  throw new Error(`BlogPost: ${locale}/${slug} has a cover, but its file could not be resolved`);
}
// The image is drawn from the frontmatter title, the page shows `data.title`:
// one string, or the card would show a title the page does not.
if (share && share.title !== data.title) {
  throw new Error(`BlogPost: ${locale}/${slug}: the share image's title "${share.title}" is not the page's "${data.title}"`);
}
// An SVG cover with a dark variant (src/lib/cover-variant.ts) is drawn twice,
// one image per theme. Both are lazy: a display:none image is only skipped
// when it is lazy, so the eager, high-priority pair would fetch both. The
// visible one sits in the first viewport and is requested at first layout.
const coverDark = darkCover(entry?.filePath, data.cover);
const shareImage = share
  ? { url: absoluteUrl(share.urlPath), width: OG_IMAGE.width, height: OG_IMAGE.height, alt: data.title }
  : undefined;
const topic = termBySlug(data.topic)!;
// Ties in the related score are broken by a stable hash of the (this post,
// candidate) pair, not by date. Newest-first sent every tie to the latest
// posts, so the posts published together on 2026-06-03/04/05/16 rarely
// appeared in a related list: in the build at `ea20640`, 15 of the 25
// least-linked English posts were from those days, and Search Console listed
// several of them as "Crawled - currently not indexed". A per-pair hash still
// gives each page a fixed list (no churn between builds) but spreads the
// inbound links across the corpus.
const pairRank = (other: string): number => {
  let h = 0x811c9dc5;
  for (const ch of `${slug}|${other}`) h = Math.imul(h ^ ch.charCodeAt(0), 0x01000193);
  return h >>> 0;
};
const relatedPosts = (await getPostsInLocale(locale))
  .filter((post) => post.slug !== slug && post.entry.data.status !== 'archived')
  .map((post) => {
    const d = post.entry.data;
    let score = 0;
    if (d.topic === data.topic) score += 4;
    if (d.audience === data.audience) score += 2;
    score += (d.solutions ?? []).filter((value) => (data.solutions ?? []).includes(value)).length * 2;
    score += (d.industries ?? []).filter((value) => (data.industries ?? []).includes(value)).length * 2;
    return { ...post, score };
  })
  .filter((post) => post.score > 0)
  .sort((a, b) => b.score - a.score || pairRank(a.slug) - pairRank(b.slug))
  .slice(0, 3);
// The pillar pages that list this post in their reading path. Each links the
// post; the post links back, so a reader who lands on one article from search
// finds the guide it belongs to, and the pillar is not an orphan that only the
// home page links (the footer's Resources column, src/layouts/Base.astro, has
// the other half).
// Titles only: outside English a cluster's description is one template with
// the name swapped, and five of them stacked under a post read as exactly that.
const readingPaths = CLUSTERS.filter((cluster) => cluster.articleSlugs.includes(slug)).map(
  (cluster) => ({ href: clusterPath(locale, cluster.slug), copy: clusterCopy(cluster, locale) })
);
const readingPathLabel = clusterLabels(locale).readingPath;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: modifiedIso,
    author: {
      '@type': 'Organization',
      name: data.author,
    },
    publisher: {
      '@type': 'Organization',
      '@id': ORGANIZATION_ID,
      name: 'ObjectStack AI LLC',
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl('/logo.svg'),
      },
    },
    mainEntityOfPage: currentUrl,
    url: currentUrl,
    image: shareImage?.url,
    articleSection: termLabel(data.topic, locale),
    keywords: data.tags,
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.articlesTitle,
        item: absoluteUrl(blogPath(locale)),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: termLabel(data.topic, locale),
        item: absoluteUrl(termHref(locale, topic)),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.title,
        item: slug ? absoluteUrl(postPath(locale, slug)) : currentUrl,
      },
    ],
  },
];

// The post body is MDX this layout does not author, so the attributes the
// article owes its body markup are added here, once, on the rendered HTML —
// not in every post × eight locales.
//   - A table is a scroll container on a phone (see the stylesheet), and a
//     scroll container a keyboard cannot reach is axe's
//     `scrollable-region-focusable`. It gets `tabindex="0"` and is named by
//     the heading of the section it sits in — the article title for a table
//     that comes before the first heading.
//   - A code block is a scroll container at every width. Shiki already gives
//     it `tabindex="0"`; it gets a name ("Code (bash)") so the focus stop
//     announces what it is. `aria-label` is not allowed on a bare `pre`, whose
//     role is generic, hence `role="group"` — not `region`: a region is a
//     landmark, and two "Code (bash)" landmarks on one page fail axe's
//     `landmark-unique`.
//   - A body image becomes a link to its own asset. A 1200-wide diagram fit
//     into a 328px column renders its smallest text at 3–4px; one tap opens
//     the asset in the browser, whose own pinch zoom takes that text past
//     legible. The link's accessible name is the image's alt text, so an
//     image without alt text (decorative) is left alone rather than turned
//     into a nameless link.
const CODE_LABEL: Record<Locale, string> = {
  en: 'Code',
  'zh-Hans': '代码',
  'zh-Hant': '程式碼',
  ja: 'コード',
  ko: '코드',
  de: 'Code',
  es: 'Código',
  fr: 'Code',
};
const PLAIN_LANGUAGES = new Set(['plaintext', 'plain', 'text', 'txt']);
const attrOf = (tag: string, name: string): string | undefined =>
  tag.match(new RegExp(`\\s${name}="([^"]*)"`))?.[1];
const withAttrs = (tag: string, attrs: Record<string, string>): string => {
  const added = Object.entries(attrs)
    .filter(([name]) => attrOf(tag, name) === undefined)
    .map(([name, value]) => ` ${name}="${value}"`)
    .join('');
  return tag.replace(/\s*\/?>$/, (end) => `${added}${end}`);
};
const annotateBody = (html: string): string => {
  let headingId = 'article-title';
  let linkDepth = 0;
  return html.replace(
    /<h[2-6]\b[^>]*>|<a\b[^>]*>|<\/a>|<table\b[^>]*>|<pre\b[^>]*>|<img\b[^>]*>/g,
    (tag) => {
      if (tag === '</a>') {
        linkDepth = Math.max(0, linkDepth - 1);
        return tag;
      }
      if (tag.startsWith('<a')) {
        linkDepth += 1;
        return tag;
      }
      if (tag.startsWith('<h')) {
        headingId = attrOf(tag, 'id') ?? headingId;
        return tag;
      }
      if (tag.startsWith('<table')) {
        const named = attrOf(tag, 'aria-label') ?? attrOf(tag, 'aria-labelledby');
        return withAttrs(tag, {
          tabindex: '0',
          ...(named === undefined ? { 'aria-labelledby': headingId } : {}),
        });
      }
      if (tag.startsWith('<pre')) {
        const lang = attrOf(tag, 'data-language');
        const name =
          lang && !PLAIN_LANGUAGES.has(lang) ? `${CODE_LABEL[locale]} (${lang})` : CODE_LABEL[locale];
        return withAttrs(tag, { tabindex: '0', role: 'group', 'aria-label': name });
      }
      const src = attrOf(tag, 'src');
      if (linkDepth > 0 || !src || !attrOf(tag, 'alt')?.trim()) return tag;
      return `<a class="figure-link" href="${src}">${tag}</a>`;
    }
  );
};
const bodyHtml = annotateBody(await Astro.slots.render('default'));
---

<Base
  title={data.title}
  description={data.description}
  canonical={data.canonical_url}
  image={shareImage?.url}
  imageAlt={shareImage?.alt}
  imageWidth={shareImage?.width}
  imageHeight={shareImage?.height}
  type="article"
  noindex={!isPublicPost(data)}
  publishedTime={data.date.toISOString()}
  modifiedTime={modifiedIso}
  author={data.author}
  jsonLd={jsonLd}
  {locale}
  {alternates}>
  <article>
    <a class="back" href={blogPath(locale)}>← {t.backToList}</a>

    <header class="post-head">
      <div class="meta">
        <a class="chip chip-topic" data-topic={data.topic} href={termHref(locale, topic)}>
          {termLabel(data.topic, locale)}
        </a>
        <a class="chip" href={termHref(locale, termBySlug(data.audience)!)}>
          {termLabel(data.audience, locale)}
        </a>
        {
          (data.solutions ?? []).map((slug) => (
            <a class="chip" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        {
          (data.industries ?? []).map((slug) => (
            <a class="chip" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        {
          data.status !== 'published' && (
            <span class="pill" style={`--c:${STATUS_COLOR[data.status]}`}>
              {t.status[data.status]}
            </span>
          )
        }
        <span class="dot">·</span>
        <time datetime={dateStr}>{displayDate}</time>
        {
          updatedStr && (
            <>
              <span class="dot">·</span>
              <time class="updated" datetime={updatedStr}>
                {t.updated} {updatedDisplay}
              </time>
            </>
          )
        }
        <span class="dot">·</span>
        <span>{t.by} {data.author}</span>
      </div>

      <h1 id="article-title" set:html={phraseHtml(data.title, locale)} />
      {data.description && <p class="lead">{data.description}</p>}

      {
        data.cover &&
          (data.cover.format === 'svg' ? (
            coverDark ? (
              <>
                <img
                  class="cover cover-light"
                  src={data.cover.src}
                  alt={data.title}
                  width={data.cover.width}
                  height={data.cover.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="high"
                />
                <img
                  class="cover cover-dark"
                  src={coverDark.src}
                  alt={data.title}
                  width={coverDark.width}
                  height={coverDark.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="high"
                />
              </>
            ) : (
              <img
                class="cover"
                src={data.cover.src}
                alt={data.title}
                width={data.cover.width}
                height={data.cover.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            )
          ) : (
            <Image
              class="cover"
              src={data.cover}
              alt={data.title}
              width={Math.min(COVER_WIDTHS.at(-1)!, data.cover.width)}
              widths={COVER_WIDTHS}
              sizes={COVER_SIZES}
              format="webp"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ))
      }

      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )
      }

      {
        data.channels.length > 0 && (
          <div class="channels">
            <span class="channels-label">{t.alsoOn}</span>
            {data.channels.map((c) => (
              <a class="chip chip-brand" href={c.url} target="_blank" rel="noopener">
                {c.platform}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Fragment set:html={bodyHtml} />
    </div>

    {
      readingPaths.length > 0 && (
        <aside class="reading-path" aria-labelledby="reading-path-title">
          <p class="reading-path-label" id="reading-path-title">{readingPathLabel}</p>
          <ul>
            {readingPaths.map((path) => (
              <li>
                <a href={path.href}>{path.copy.title} <span aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      relatedPosts.length > 0 && (
        <aside class="related" aria-labelledby="related-title">
          <h2 id="related-title" set:html={phraseHtml(t.relatedTitle, locale)} />
          <ul>
            {relatedPosts.map((post) => (
              <li class="card card-link">
                <a href={postPath(locale, post.slug)}>{post.entry.data.title}</a>
                <p>{post.entry.data.description}</p>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>

  <style>
    article {
      max-width: var(--measure-wide);
      min-width: 0;
      margin: 0 auto;
    }
    /* A 44px tap target (the text line is 22px). The box grows by 0.675rem
       each way and the margins give it back, so the text and the heading
       below stay where they were. */
    .back {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin: -0.675rem 0 1.325rem;
      font-size: var(--fs-14);
      color: var(--ink-soft);
      text-decoration: none;
      transition: color 0.16s ease, transform 0.16s ease;
    }
    .back:hover {
      color: var(--ink);
      transform: translateX(-2px);
    }
    .post-head {
      padding-bottom: 2.25rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--line);
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      font-size: var(--fs-14);
      color: var(--ink-soft);
      margin-bottom: 1.1rem;
    }
    .dot {
      color: var(--muted);
    }
    .updated {
      color: var(--ink-soft);
      font-weight: 600;
    }
    h1 {
      font-family: var(--font-display);
      font-size: var(--fs-h1);
      line-height: var(--lh-display);
      letter-spacing: -0.01em;
      margin: 0 0 1rem;
    }
    /* zh and ja: the title breaks only at the <wbr> between phrases
       (scripts/lib/cjk-phrases.mjs); a phrase wider than the line still
       breaks, as a last resort. The body's own headings get theirs from the
       markdown pipeline (rehypeCjkHeadingPhrases) and the rule below.
       ko: Korean puts a space between words, so keep-all alone breaks it at
       the spaces and never inside a word (없음 stays whole); no <wbr>. */
    h1:lang(zh),
    h1:lang(ja),
    h1:lang(ko),
    h2:lang(zh),
    h2:lang(ja),
    h2:lang(ko) {
      word-break: keep-all;
      overflow-wrap: anywhere;
      text-wrap: balance;
    }
    .lead {
      font-size: var(--fs-20);
      line-height: var(--lh-ui);
      color: var(--ink-soft);
      margin: 0;
    }
    .cover {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      margin-top: 1.75rem;
      border-radius: var(--r-card);
      border: 1px solid var(--line);
      background: var(--surface-sunk);
      box-shadow: var(--shadow-md);
      filter: var(--cover-filter);
    }
    /* One cover per theme (src/lib/cover-variant.ts); the dark variant is
       drawn dark and takes no --cover-filter dimming. */
    :global(:root:not([data-theme='dark'])) .cover-dark,
    :global(:root[data-theme='dark']) .cover-light {
      display: none;
    }
    .cover.cover-dark {
      filter: none;
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      padding: 0;
      margin: 1.4rem 0 0;
    }
    .channels {
      margin-top: 1.2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      font-size: var(--fs-14);
    }
    .channels-label {
      color: var(--muted);
    }
    .reading-path {
      margin-top: 3rem;
      padding: 1rem 1.1rem;
      border: 1px solid var(--line);
      border-left: 3px solid var(--green);
      border-radius: var(--r-card);
      background: var(--surface);
    }
    .reading-path-label {
      margin: 0 0 0.5rem;
      color: var(--ink-soft);
      font-size: var(--fs-12);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .reading-path ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.45rem;
    }
    .reading-path a {
      color: var(--ink);
      font-weight: 700;
      line-height: var(--lh-heading);
      text-decoration: none;
    }
    .reading-path a:hover {
      color: var(--brand);
    }
    .related {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }
    .related h2 {
      font-size: var(--fs-18);
      margin: 0 0 1rem;
      letter-spacing: 0;
    }
    .related ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.9rem;
    }
    .related li {
      padding: 0.95rem 1rem;
    }
    .related a {
      display: inline-block;
      color: var(--ink);
      font-weight: 700;
      line-height: var(--lh-heading);
      text-decoration: none;
    }
    .related a:hover {
      color: var(--brand);
    }
    .related p {
      margin: 0.35rem 0 0;
      color: var(--ink-soft);
      font-size: var(--fs-14);
      line-height: var(--lh-ui);
    }
  </style>

  <style is:global>
    .prose {
      min-width: 0;
      font-size: var(--fs-17);
      line-height: var(--lh-prose);
      color: var(--ink);
    }
    .prose > :first-child {
      margin-top: 0;
    }
    /* Measure. At the article's 860px a line ran about 95 characters in en
       and 47 in zh; text blocks stop at 44rem. Code blocks, tables and
       figures keep the full article width (each already has its own scroll
       container or scales down), and they start on the same left edge as
       the text, under the title. */
    .prose > * {
      max-width: var(--measure-prose);
    }
    .prose > :is(pre, table),
    .prose > p:has(> .figure-link, > img) {
      max-width: 100%;
    }
    .prose h2 {
      font-family: var(--font-display);
      font-size: var(--fs-30);
      letter-spacing: 0;
      margin: 2.6rem 0 1rem;
      line-height: var(--lh-heading);
      scroll-margin-top: 104px;
    }
    .prose h3 {
      font-size: var(--fs-20);
      margin: 2rem 0 0.75rem;
      scroll-margin-top: 104px;
    }
    /* zh and ja body headings carry a <wbr> between phrases, added at build
       time by rehypeCjkHeadingPhrases (scripts/lib/cjk-phrases.mjs), and break
       nowhere else. ko headings break at their own spaces. */
    .prose :is(h1, h2, h3, h4, h5, h6):is(:lang(zh), :lang(ja), :lang(ko)) {
      word-break: keep-all;
      overflow-wrap: anywhere;
      text-wrap: balance;
    }
    .prose p {
      margin: 0 0 1.25rem;
    }
    .prose a {
      color: var(--brand);
      text-underline-offset: 2px;
    }
    .prose strong {
      color: var(--ink);
      font-weight: 700;
    }
    .prose ul,
    .prose ol {
      padding-left: 1.4rem;
      margin: 0 0 1.25rem;
    }
    .prose li {
      margin: 0.4rem 0;
    }
    .prose blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1.2rem;
      border-left: 4px solid color-mix(in srgb, var(--brand) 42%, var(--line));
      border-radius: 0 var(--r-card) var(--r-card) 0;
      background: color-mix(in srgb, var(--surface) 64%, transparent);
      color: var(--ink-soft);
      overflow-wrap: anywhere;
    }
    .prose blockquote p {
      margin: 0;
    }
    .prose hr {
      border: none;
      border-top: 1px solid var(--line);
      margin: 2.5rem 0;
    }
    .prose img {
      width: 100%;
      height: auto;
      max-width: 100%;
      border-radius: var(--r-card);
      border: 1px solid var(--line);
      background: var(--surface);
      box-shadow: var(--shadow-sm);
      display: block;
      margin: 1.5rem auto;
    }
    /* A block box with no padding or border: the image's margins collapse
       through it, so the link adds a tap target and a focus ring without
       moving the image by a pixel at any width. */
    .prose .figure-link {
      display: block;
      cursor: zoom-in;
    }
    .prose :not(pre) > code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: var(--surface-sunk);
      padding: 0.12em 0.4em;
      border-radius: var(--r-control);
      border: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
      overflow-wrap: anywhere;
    }
    .prose pre {
      max-width: 100%;
      margin: 1.5rem 0;
      padding: 1rem 1.15rem;
      border-radius: var(--r-card);
      overflow-x: auto;
      font-size: var(--fs-14);
      line-height: var(--lh-body);
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface-sunk) 72%, var(--surface));
      box-shadow: var(--shadow-sm);
      overscroll-behavior-x: contain;
    }
    /* A code block scrolls sideways at every width, not only on a phone, so
       it carries the two scroll affordances the table carries (see the
       comments there) at every width. Shiki paints the block dark in both
       themes, so its scrollbar is drawn light. A block that fits draws no
       scrollbar and its scroll timeline is inactive, so it is unchanged. */
    .prose pre::-webkit-scrollbar {
      height: 6px;
    }
    .prose pre::-webkit-scrollbar-track {
      background: color-mix(in srgb, var(--on-panel) 8%, transparent);
      border-radius: var(--r-pill);
    }
    .prose pre::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--on-panel) 42%, transparent);
      border-radius: var(--r-pill);
    }
    @supports (animation-timeline: scroll(self inline)) {
      .prose pre {
        animation: prose-scroll-edge-fade linear both;
        animation-timeline: scroll(self inline);
      }
    }
    @keyframes prose-scroll-edge-fade {
      from {
        mask-image: linear-gradient(to right, #000 calc(100% - 34px), transparent);
      }
      to {
        mask-image: linear-gradient(to right, #000 100%, transparent);
      }
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: var(--fs-15);
    }
    /* Tabular figures, so the digits of one column line up row to row. */
    .prose th,
    .prose td {
      border: 1px solid var(--line);
      padding: 0.5rem 0.75rem;
      text-align: left;
      font-variant-numeric: tabular-nums;
    }
    .prose th {
      background: var(--surface-sunk);
    }
    /* An identifier in a table cell is never split. Under the inline-code
       rule above (`overflow-wrap: anywhere`) a column narrower than its token
       broke it at an arbitrary letter and added no hyphen: `beforeDelet` /
       `e` at 390, `crm_sales_us` / `er` at 1366. Here the code wraps only
       where it already may (a space, a hyphen), so a token sets its column's
       minimum width, and a table that outgrows its column scrolls inside
       itself (below), never the page. Code in running text keeps `anywhere`
       as the last resort for a path wider than the line. */
    .prose :is(th, td) code {
      overflow-wrap: normal;
    }
    /* The table itself is the scroll container, at every width (`display:
       block` + `overflow-x: auto`), so a wide table scrolls instead of
       clipping and the page keeps `documentElement.scrollWidth === viewport`.
       A desktop column is not wide enough for every table either: with whole
       identifiers the access-matrix table needs about 970px. What scrolling
       costs is the affordance: a phone draws an OVERLAY scrollbar, which is
       invisible until a gesture is already in progress, so a reader who never
       swipes never learns the right-hand columns exist. The cut-off column at
       the edge is indistinguishable from a clipped table. The two rules below
       are the signal, not the scrolling. */
    .prose table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      /* Keep a horizontal swipe that reaches the end of the table from
         chaining into the page/browser behind it. */
      overscroll-behavior-x: contain;
    }
    /* Affordance 1 — a scrollbar that is always drawn, not just mid-gesture.
       Styling ::-webkit-scrollbar opts the container out of overlay
       scrollbars on iOS Safari and Blink, which is the whole point.
       ⚠️ Do NOT add `scrollbar-width`/`scrollbar-color` to `.prose table`:
       Chrome 121+ drops ::-webkit-scrollbar customization entirely on any
       element that sets either one, which would silently give the overlay
       scrollbar back. A scrollbar only renders when the content overflows,
       so short tables are unaffected. */
    .prose table::-webkit-scrollbar {
      height: 6px;
    }
    .prose table::-webkit-scrollbar-track {
      background: color-mix(in srgb, var(--surface-sunk) 70%, transparent);
      border-radius: var(--r-pill);
    }
    .prose table::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--ink) 32%, transparent);
      border-radius: var(--r-pill);
    }
    /* Affordance 2 — fade the trailing edge while there is more table to the
       right. Driven by the container's own scroll position so it clears
       exactly at the end of the scroll: a fade that is always on is a false
       signal, and telling a reader there is more table when there is not is
       the same defect in the other direction.
       The fade lives ONLY in the keyframes, never in the base rule. When a
       table is narrow enough not to overflow, its scroll timeline is inactive
       and the effect is not applied at all (`mask-image` computes to `none`)
       — a fade declared in the base rule would instead be stuck on for every
       table that does not scroll. */
    @supports (animation-timeline: scroll(self inline)) {
      .prose table {
        animation: prose-scroll-edge-fade linear both;
        animation-timeline: scroll(self inline);
      }
    }
    /* `display: block` wraps the rows in an anonymous table that shrinks to
       its content, so a short table no longer spans the column as it does at
       `display: table; width: 100%`. Above the phone breakpoint an empty
       caption as wide as the table element (`100cqi`, the table being its
       own container) widens that anonymous table back to the column: the
       grid takes the same width and the same column widths as before, and a
       table that does not fit still scrolls. Phones keep shrink-to-fit. */
    @media (min-width: 641px) {
      .prose table {
        container-type: inline-size;
      }
      .prose table::after {
        content: '';
        display: table-caption;
        caption-side: bottom;
        inline-size: 100cqi;
      }
    }
    @media (max-width: 640px) {
      .back {
        margin-bottom: 0.675rem;
      }
      .post-head {
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      .meta {
        gap: 0.4rem;
        font-size: var(--fs-13);
      }
      .meta .chip {
        min-height: 32px;
      }
      .dot {
        display: none;
      }
      h1 {
        overflow-wrap: anywhere;
      }
      .lead {
        font-size: var(--fs-16);
        line-height: var(--lh-body);
      }
      .cover {
        margin-top: 1.25rem;
        border-radius: var(--r-control);
      }
      .prose {
        font-size: var(--fs-16);
        line-height: var(--lh-prose);
      }
      .prose h2 {
        margin-top: 2.25rem;
        font-size: var(--fs-24);
        overflow-wrap: anywhere;
      }
      .prose h3 {
        font-size: var(--fs-18);
        overflow-wrap: anywhere;
      }
      /* Latin-script titles and headings hyphenate a word wider than the
         column (by the <html lang> dictionary) instead of splitting it at an
         arbitrary letter: at 360 `overflow-wrap: anywhere` alone rendered
         `Produktionsdatenba` / `nk` and `Metadatengenerieru` / `ng`. It stays
         above as the last resort for a word with no hyphenation point.
         Only words of 12+ letters hyphenate, 5 kept on each side, so short
         words still wrap whole. zh, ja and ko keep their keep-all rules. */
      h1:is(:lang(en), :lang(de), :lang(fr), :lang(es)),
      .prose :is(h2, h3):is(:lang(en), :lang(de), :lang(fr), :lang(es)) {
        -webkit-hyphens: auto;
        hyphens: auto;
        hyphenate-limit-chars: 12 5 5;
      }
      /* An identifier in a heading must not gain a hyphen it does not have. */
      .prose :is(h2, h3) code {
        -webkit-hyphens: manual;
        hyphens: manual;
      }
      .prose pre {
        margin-right: -0.25rem;
        margin-left: -0.25rem;
        padding: 0.85rem;
        border-radius: var(--r-control);
        font-size: var(--fs-13);
      }
      .prose table {
        font-size: var(--fs-13);
      }
      /* Cells wrap; each column keeps a floor. Unwrapped (`nowrap`), a row of
         prose cells ran as long as its longest sentence: 2,035px on a 328px
         column, seven screens of swiping per row. 6.5rem (104px, padding
         included) is the widest floor at which three columns still fit the
         328px column of a 360px phone (3 × 104 = 312), so a two- or
         three-column table of prose needs no sideways scroll at 360 or 390;
         four to six columns scroll. `overflow-wrap: anywhere` keeps a column
         of prose at its floor. It does not reach inline code (the rule above
         the media query): an identifier wider than its column widens the
         column instead of splitting, and the table scrolls further. */
      .prose th,
      .prose td {
        box-sizing: border-box;
        min-width: 6.5rem;
        padding-right: 0.6rem;
        padding-left: 0.6rem;
        overflow-wrap: anywhere;
      }
    }
  </style>
</Base>
