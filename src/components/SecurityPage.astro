---
import { blogPath, type Locale } from '../lib/i18n';
import type { SecurityCopy } from '../lib/security';

interface Props {
  copy: SecurityCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const docsHref = 'https://docs.objectos.ai/docs/reference/security';
const blogSlug =
  locale === 'zh-Hans' || locale === 'zh-Hant'
    ? 'ai-agent-business-data-security-boundaries'
    : 'extend-existing-systems-with-ai';
const blogHref = `${blogPath(locale)}${blogSlug}`;
---

<article class="security-page">
  <section class="hero">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.hero[0]}<br /><strong>{copy.hero[1]}</strong></h1>
    <p class="lead">{copy.lead}</p>
    <dl class="metrics">
      {copy.metrics.map((item) => (
        <div>
          <dt>{item.value}</dt>
          <dd>{item.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <nav class="page-nav" aria-label={copy.title}>
    <a href="#ai">{copy.aiTitle}</a>
    <a href="#data">{copy.residencyTitle}</a>
    <a href="#permissions">{copy.permissionTitle}</a>
    <a href="#deployment">{copy.deploymentTitle}</a>
    <a href="#faq">{copy.faqTitle}</a>
  </nav>

  <section class="panel ai-panel" id="ai">
    <div class="section-head">
      <p class="eyebrow">{copy.aiTitle}</p>
      <h2>{copy.aiTitle}</h2>
      <p>{copy.aiLead}</p>
    </div>
    <ol class="step-grid">
      {copy.aiSteps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="split" id="data">
    <div>
      <p class="eyebrow">{copy.residencyTitle}</p>
      <h2>{copy.residencyTitle}</h2>
      <p>{copy.residencyLead}</p>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            {copy.residencyColumns.map((column) => <th>{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {copy.residencyRows.map((row) => (
            <tr>
              <td>{row.data}</td>
              <td>{row.location}</td>
              <td>{row.leaves}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="split permissions" id="permissions">
    <div>
      <p class="eyebrow">{copy.permissionTitle}</p>
      <h2>{copy.permissionTitle}</h2>
      <p>{copy.permissionLead}</p>
    </div>
    <div class="layer-list">
      {copy.permissionLayers.map((layer) => (
        <div>
          <h3>{layer.title}</h3>
          <p>{layer.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="panel" id="deployment">
    <div class="section-head">
      <p class="eyebrow">{copy.deploymentTitle}</p>
      <h2>{copy.deploymentTitle}</h2>
      <p>{copy.deploymentLead}</p>
    </div>
    <div class="deploy-grid">
      {copy.deployments.map((deployment) => (
        <div>
          <h3>{deployment.title}</h3>
          <p>{deployment.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="section-head">
      <p class="eyebrow">{copy.faqTitle}</p>
      <h2>{copy.faqTitle}</h2>
    </div>
    <div class="faq-list">
      {copy.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <p class="eyebrow">{copy.ctaKicker}</p>
    <h2>{copy.ctaTitle}</h2>
    <p>{copy.ctaCopy}</p>
    <div class="actions">
      <a class="button primary" href={docsHref}>{copy.ctaPrimary} <span>→</span></a>
      <a class="button secondary" href={blogHref}>{copy.ctaSecondary}</a>
    </div>
  </section>
</article>

<style>
  .security-page {
    --sec-green: #087f5b;
    --sec-blue: #2563eb;
    --sec-amber: #b45309;
  }
  .security-page :global(h1),
  .security-page :global(h2),
  .security-page :global(h3),
  .security-page :global(p) {
    margin-top: 0;
  }
  .hero {
    max-width: 900px;
    padding: 2rem 0 4rem;
  }
  .eyebrow {
    color: var(--sec-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin: 0 0 1.4rem;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: 0;
  }
  .hero h1 strong {
    color: var(--sec-green);
    font-weight: inherit;
  }
  .lead {
    max-width: 720px;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
  .metrics dt {
    color: var(--ink);
    font-size: 1.8rem;
    font-weight: 750;
    line-height: 1.1;
  }
  .metrics dd {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .split,
  .panel,
  .faq {
    padding: 6rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 82px;
  }
  .page-nav {
    position: sticky;
    top: 58px;
    z-index: 4;
    display: flex;
    gap: 0.3rem;
    margin: 0 -0.25rem;
    padding: 0.55rem 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }
  .page-nav::-webkit-scrollbar {
    display: none;
  }
  .page-nav a {
    flex: 0 0 auto;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    font-size: 0.76rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .page-nav a:hover {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--sec-green) 35%, var(--line));
  }
  .split {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(460px, 1.25fr);
    gap: 4rem;
    align-items: start;
  }
  h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.2vw, 3.3rem);
    line-height: 1.18;
    letter-spacing: 0;
  }
  .split > div > p,
  .section-head p,
  .cta > p {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.85;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    font-size: 0.86rem;
  }
  th {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  td {
    color: var(--ink-soft);
  }
  td:first-child {
    color: var(--ink);
    font-weight: 650;
  }
  tr:last-child td {
    border-bottom: none;
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }
  .step-grid,
  .deploy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    padding: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .step-grid {
    list-style: none;
    margin: 0;
  }
  .step-grid li,
  .deploy-grid div {
    min-height: 245px;
    padding: 1.4rem;
    background: var(--surface);
  }
  .step-grid span {
    display: inline-block;
    margin-bottom: 2.3rem;
    color: var(--sec-green);
    font: 700 0.72rem/1 var(--font-mono);
  }
  .step-grid h3,
  .deploy-grid h3,
  .layer-list h3 {
    margin-bottom: 0.55rem;
    font-size: 1.02rem;
  }
  .step-grid p,
  .deploy-grid p,
  .layer-list p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.72;
  }
  .layer-list {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .layer-list div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
  }
  .deploy-grid div:nth-child(2) h3,
  .deploy-grid div:nth-child(2) + div h3 {
    color: var(--sec-blue);
  }
  .deploy-grid div:nth-child(4) h3 {
    color: var(--sec-amber);
  }
  .faq-list {
    display: grid;
    gap: 0.75rem;
  }
  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  summary {
    padding: 1rem 1.1rem;
    cursor: pointer;
    color: var(--ink);
    font-weight: 650;
  }
  details p {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .cta {
    margin-top: 2rem;
    padding: 4rem;
    color: white;
    background: #172b26;
    border-radius: 6px;
  }
  .cta .eyebrow {
    color: #8ee3c2;
  }
  .cta p {
    max-width: 680px;
    color: #bdc9c5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .button.primary {
    color: #172b26;
    background: white;
  }
  .button.secondary {
    color: white;
    border-color: rgba(255, 255, 255, 0.25);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .step-grid,
    .deploy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 0.5rem 0 2.25rem;
    }
    .hero h1 {
      margin-bottom: 1rem;
      font-size: 2.28rem;
      line-height: 1.08;
    }
    .lead {
      font-size: 0.98rem;
      line-height: 1.75;
    }
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 1.6rem;
      padding-top: 0.9rem;
    }
    .metrics dt {
      font-size: 1rem;
      overflow-wrap: anywhere;
    }
    .metrics dd {
      font-size: 0.68rem;
      line-height: 1.35;
    }
    .split,
    .panel,
    .faq {
      padding: 3.2rem 0;
      scroll-margin-top: 120px;
    }
    .page-nav {
      top: 106px;
      margin-right: -1rem;
      margin-left: -1rem;
      padding-right: 1rem;
      padding-left: 1rem;
    }
    h2 {
      font-size: 1.9rem;
    }
    .step-grid,
    .deploy-grid {
      grid-template-columns: 1fr;
    }
    .step-grid li,
    .deploy-grid div {
      min-height: auto;
    }
    .layer-list div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .cta {
      margin: 1rem -0.5rem 0;
      padding: 2.2rem 1.5rem;
    }
    .actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
