---
import { Image } from 'astro:assets';
import type { Locale } from '../lib/i18n';
import { formatDate, postPath, STATUS_COLOR, ui } from '../lib/i18n';
import type { LocalePost } from '../lib/posts';
import { termLabel } from '../lib/terms';
import { darkCover } from '../lib/cover-variant';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';

interface Props {
  post: LocalePost;
  locale: Locale;
  variant?: 'standard' | 'feature';
}

const { post, locale, variant = 'standard' } = Astro.props;
const d = post.entry.data;
const t = ui[locale];
// A raster cover is served as WebP at the thumbnail's width, not as the
// 1.5-1.9 MB original: a standard card is one of three columns (about 343px)
// on a desktop, one of two at 641-900px and the full column on a phone; the
// feature card's cover column is about 585px at 1024px and up, and the full
// column below. `sizes` is the width the image is drawn at, not the card's:
// the 16:10 thumb crops a 16:9 cover with object-fit: cover, which draws it
// 1.11x the card's width (a 343px card needs 381px of image; the phone's 2:1
// thumb needs none). The widest candidates cover the phone column at 3x and
// the feature at 2x. An SVG cover is a few KB and scales itself, so it is
// served as is. The feature card opens the blog index above the fold, so its
// cover is not lazy.
const THUMB_WIDTHS = [400, 540, 720, 1080, 1280];
const thumbSizes =
  variant === 'feature'
    ? '(min-width: 1024px) 640px, calc(100vw - 2rem)'
    : '(max-width: 640px) calc(100vw - 2rem), (max-width: 900px) calc(55vw - 2rem), 400px';
const thumbLoading = variant === 'feature' ? 'eager' : 'lazy';
// An SVG cover with a dark variant (src/lib/cover-variant.ts) is drawn twice,
// one image per theme. Both are lazy, the feature card's too: a display:none
// image is only skipped when it is lazy, so an eager pair would fetch both.
const coverDark = darkCover(post.entry.filePath, d.cover);
---

<li class:list={['article-item', variant]}>
  <a class="card card-link" href={postPath(locale, post.slug)}>
    <div class="thumb">
      {d.cover ? (
        d.cover.format === 'svg' ? (
          coverDark ? (
            <>
              <img
                class="cover-light"
                src={d.cover.src}
                alt={d.title}
                width={d.cover.width}
                height={d.cover.height}
                loading="lazy"
                decoding="async"
              />
              <img
                class="cover-dark"
                src={coverDark.src}
                alt={d.title}
                width={coverDark.width}
                height={coverDark.height}
                loading="lazy"
                decoding="async"
              />
            </>
          ) : (
            <img
              src={d.cover.src}
              alt={d.title}
              width={d.cover.width}
              height={d.cover.height}
              loading={thumbLoading}
              decoding="async"
            />
          )
        ) : (
          <Image
            src={d.cover}
            alt={d.title}
            width={Math.min(THUMB_WIDTHS.at(-1)!, d.cover.width)}
            widths={THUMB_WIDTHS}
            sizes={thumbSizes}
            format="webp"
            loading={thumbLoading}
            decoding="async"
          />
        )
      ) : (
        <div class="thumb-fallback">
          <span class="fmark">◆</span>
          <span class="ftopic">{termLabel(d.topic, locale)}</span>
        </div>
      )}
    </div>
    <div class="body">
      <div class="top">
        {d.status !== 'published' && (
          <span class="pill" style={`--c:${STATUS_COLOR[d.status]}`}>
            {t.status[d.status]}
          </span>
        )}
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(locale, d.date)}</time>
      </div>
      <h2 set:html={phraseHtml(d.title, locale)} />
      <p class="desc">{d.description}</p>
      <div class="facets">
        <span class="chip chip-brand">{termLabel(d.topic, locale)}</span>
        <span class="chip">{termLabel(d.audience, locale)}</span>
        {(d.solutions ?? []).map((slug) => (
          <span class="chip">{termLabel(slug, locale)}</span>
        ))}
        {(d.industries ?? []).map((slug) => (
          <span class="chip">{termLabel(slug, locale)}</span>
        ))}
        {d.tags.map((tag) => (
          <span class="chip tag">{tag}</span>
        ))}
      </div>
    </div>
  </a>
</li>

<style>
  .article-item {
    min-width: 0;
    content-visibility: auto;
    contain-intrinsic-size: 420px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    background: var(--surface-sunk);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--cover-filter);
  }
  /* One cover per theme (src/lib/cover-variant.ts). The dark variant is drawn
     dark, so it takes no --cover-filter dimming; raster covers and SVGs with
     no variant keep it. */
  :global(:root:not([data-theme='dark'])) .cover-dark,
  :global(:root[data-theme='dark']) .cover-light {
    display: none;
  }
  .thumb .cover-dark {
    filter: none;
  }
  .thumb-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: color-mix(in srgb, var(--brand) 50%, var(--muted));
  }
  .thumb-fallback .fmark {
    font-size: var(--fs-24);
    opacity: 0.45;
  }
  .thumb-fallback .ftopic {
    font-size: var(--fs-13);
    letter-spacing: 0.08em;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.25rem 1.35rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }
  .pill {
    font-size: var(--fs-12);
    color: var(--c);
    background: color-mix(in srgb, var(--c) 9%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
    border-radius: var(--r-pill);
    padding: 0.12rem 0.5rem;
    text-transform: capitalize;
  }
  .top time {
    font-size: var(--fs-13);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  h2 {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    line-height: var(--lh-heading);
    letter-spacing: 0;
    margin: 0 0 0.4rem;
    transition: color 0.18s ease;
  }
  /* zh and ja titles break only at the <wbr> between phrases
     (scripts/lib/cjk-phrases.mjs), so a word such as 业务 or アプリケーション
     is never split across lines; a phrase wider than the line still breaks,
     as a last resort. ko titles break at their own spaces, never inside a
     word such as 없음; Korean needs no <wbr>. */
  h2:lang(zh),
  h2:lang(ja),
  h2:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .card:hover h2 {
    color: var(--brand);
  }
  .desc {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: var(--fs-15);
    line-height: var(--lh-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .facets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  /* A tag is a plain chip with a # before it, so the three facet kinds read
     as two: the topic (brand) and everything else. */
  .chip.tag::before {
    content: '#';
    opacity: 0.6;
  }
  .feature .thumb {
    aspect-ratio: 16 / 9;
  }
  .feature h2 {
    font-size: var(--fs-30);
    line-height: var(--lh-heading);
  }
  .feature .desc {
    font-size: var(--fs-16);
    -webkit-line-clamp: 4;
  }
  .feature .body {
    padding: 1.35rem 1.45rem 1.55rem;
  }
  /* Desktop: the feature spans a full row (ArticleList) with the cover beside
     the text. The cover column is at least the cover's own 16:9 (the padding
     box) and stretches with the text when that is taller, cropping a sliver
     at the sides instead of leaving a band under the image; text shorter than
     the cover is centred, so neither column has an empty band. Below 1024px
     the text column gets too narrow and tall for the cover beside it (the
     crop passes the ~11% a 16:10 card thumb already takes), so narrower
     screens keep the stacked card, alone in its row. */
  @media (min-width: 1024px) {
    .feature .card {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .feature .thumb {
      position: relative;
      aspect-ratio: auto;
    }
    .feature .thumb::before {
      content: '';
      flex: none;
      width: 0;
      padding-top: 56.25%;
    }
    .feature .thumb :global(img) {
      position: absolute;
      inset: 0;
    }
    .feature .body {
      justify-content: center;
      padding: 1.35rem 1.6rem;
    }
    .feature .desc {
      -webkit-line-clamp: 3;
    }
    .feature .facets {
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .thumb,
    .feature .thumb {
      aspect-ratio: 2 / 1;
    }
    .body,
    .feature .body {
      padding: 0.9rem 1rem 1rem;
    }
    h2,
    .feature h2 {
      font-size: var(--fs-18);
      line-height: var(--lh-heading);
    }
    /* Latin-script titles: a word wider than the card hyphenates (by the
       <html lang> dictionary); one with no hyphenation point breaks anywhere
       as the last resort. Without either, a 36-letter German compound ran
       5px past the card at 360 and was clipped by its `overflow: hidden`.
       Same 12-letter floor as the article title (BlogPost.astro). zh, ja
       and ko keep their keep-all rule above. */
    h2:is(:lang(en), :lang(de), :lang(fr), :lang(es)) {
      -webkit-hyphens: auto;
      hyphens: auto;
      hyphenate-limit-chars: 12 5 5;
      overflow-wrap: anywhere;
    }
    .desc,
    .feature .desc {
      margin-bottom: 0.75rem;
      font-size: var(--fs-14);
      line-height: var(--lh-ui);
      -webkit-line-clamp: 2;
    }
    .facets {
      gap: 0.3rem;
    }
    .chip.tag {
      display: none;
    }
  }
</style>
