---
import { getGlossaryTerms, glossaryTermPath } from '../glossary/registry';
import { glossaryUi } from '../glossary/ui';
import { cardSpans } from '../lib/card-rows';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = glossaryUi(locale);
const terms = getGlossaryTerms(locale);
const spans = cardSpans(terms.length);
---

<div class="glossary-index">
  <header class="head">
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 set:html={phraseHtml(ui.indexHeading, locale)} />
    <p class="lead">{ui.indexLead}</p>
    <p class="count">{ui.termCount(terms.length)}</p>
  </header>

  {
    terms.length === 0 ? (
      <p class="empty">{ui.empty}</p>
    ) : (
      <ul class="term-grid">
        {terms.map((term, index) => (
          <li class={`span-${spans[index]}`}>
            <a class="card card-link" href={glossaryTermPath(locale, term.slug)}>
              <h2>
                {term.term}
                <span class="arrow" aria-hidden="true">→</span>
              </h2>
              <p>{term.definition}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .head {
    max-width: var(--measure-prose);
    padding: 0.5rem 0 2.75rem;
  }
  .eyebrow {
    margin: 0 0 0.85rem;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  /* zh and ja: break only at the <wbr> between phrases (scripts/lib/cjk-phrases.mjs).
     ko: break only at its own spaces; no <wbr>. */
  h1:lang(zh),
  h1:lang(ja),
  h1:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--ink-soft);
    font-size: var(--fs-17);
    line-height: var(--lh-prose);
  }
  .count {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font: 700 var(--fs-12)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .empty {
    color: var(--muted);
  }
  /* Three to a row on desktop, on six tracks so the count decides the rows
     (src/lib/card-rows.ts): 22 terms are six rows of three and two of two.
     `auto-fill` gave three columns at desktop width and left the last term,
     "Vibe coding", alone on its row. */
  .term-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .term-grid li {
    min-width: 0;
  }
  @media (min-width: 861px) {
    .term-grid .span-2 {
      grid-column: span 2;
    }
    .term-grid .span-3 {
      grid-column: span 3;
    }
    .term-grid .span-6 {
      grid-column: 1 / -1;
    }
  }
  /* Two columns between the phone and desktop layouts, where auto-fill gave
     two as well; an odd last term takes the row. */
  @media (max-width: 860px) {
    .term-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .term-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .term-grid a {
    display: block;
    height: 100%;
    padding: 1.15rem 1.2rem 1.3rem;
    text-decoration: none;
  }
  /* A card title, so the text face, as on the cards of every other page; the
     display face is for page titles and section headings. */
  .term-grid h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.55rem;
    color: var(--ink);
    font-size: var(--fs-18);
    line-height: var(--lh-heading);
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .arrow {
    flex: none;
    color: var(--brand);
    font-size: var(--fs-15);
  }
  .term-grid p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-body);
  }
  @media (max-width: 640px) {
    .head {
      padding-bottom: 2rem;
    }
    .lead {
      font-size: var(--fs-16);
    }
    .term-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.75rem;
    }
  }
</style>
