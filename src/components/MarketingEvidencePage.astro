---
import { getMarketingPages, marketingPagePath } from '../content-pages/registry';
import type { MarketingPage } from '../content-pages/types';
import { marketingPageUi } from '../content-pages/ui';
import { pricingPath, securityPath, type Locale } from '../lib/i18n';

interface Props {
  page: MarketingPage;
  locale: Locale;
}

const { page, locale } = Astro.props;
const pages = getMarketingPages(locale);
const ui = marketingPageUi(locale);
const relatedPages = pages.filter((item) => item.slug !== page.slug);
const marketingSlugs = new Set(pages.map((item) => item.slug));
const localizeHref = (href: string): string => {
  const match = href.match(/^\/en\/([^/#]+)\/?(#.*)?$/);
  if (!match) return href;
  const [, slug, hash = ''] = match;
  if (marketingSlugs.has(slug)) return `${marketingPagePath(locale, slug)}${hash}`;
  if (slug === 'security') return securityPath(locale);
  if (slug === 'pricing') return pricingPath(locale);
  return href;
};
---

<article class="evidence-page">
  <nav class="page-rail" aria-label={ui.pageRailLabel}>
    {pages.map((item) => (
      <a
        class:list={{ active: item.slug === page.slug }}
        href={marketingPagePath(locale, item.slug)}
        aria-current={item.slug === page.slug ? 'page' : undefined}>
        {item.navLabel}
      </a>
    ))}
  </nav>

  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heroTitle}</h1>
      <p class="lead">{page.lead}</p>
      <div class="actions">
        <a class="button primary" href={localizeHref(page.primary.href)}>{page.primary.label}</a>
        <a class="button secondary" href={localizeHref(page.secondary.href)}>{page.secondary.label}</a>
      </div>
    </div>
    <div class="hero-panel" aria-label={ui.loopLabel}>
      <img
        class="hero-snapshot"
        src="/images/objectos-home-hero.png"
        alt="ObjectOS product surface connecting business data, applications, and AI agents"
        width="1586"
        height="992"
        loading="eager"
        decoding="async"
      />
      <div class="loop-step write">
        <span>{ui.loop.writer.eyebrow}</span>
        <strong>{ui.loop.writer.title}</strong>
        <small>{ui.loop.writer.body}</small>
      </div>
      <div class="loop-line"></div>
      <div class="loop-step review">
        <span>{ui.loop.reviewer.eyebrow}</span>
        <strong>{ui.loop.reviewer.title}</strong>
        <small>{ui.loop.reviewer.body}</small>
      </div>
      <div class="loop-line"></div>
      <div class="loop-step runtime">
        <span>{ui.loop.runtime.eyebrow}</span>
        <strong>{ui.loop.runtime.title}</strong>
        <small>{ui.loop.runtime.body}</small>
      </div>
    </div>
  </section>

  <dl class="metrics">
    {page.metrics.map((metric) => (
      <div>
        <dt>{metric.value}</dt>
        <dd>{metric.label}</dd>
      </div>
    ))}
  </dl>

  <section class="artifact" aria-labelledby="artifact-title">
    <div>
      <p class="eyebrow">{page.artifact.eyebrow}</p>
      <h2 id="artifact-title">{page.artifact.title}</h2>
      <p>{page.artifact.body}</p>
    </div>
    {
      page.artifact.code ? (
        <pre><code>{page.artifact.code}</code></pre>
      ) : (
        <ol>
          {page.artifact.steps?.map((step) => <li>{step}</li>)}
        </ol>
      )
    }
  </section>

  {page.sections.map((section) => (
    <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-head">
        <p class="eyebrow">{section.eyebrow}</p>
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        <p>{section.copy}</p>
      </div>
      <div class="item-grid">
        {section.items.map((item) => (
          <div class="item">
            {item.meta && <span>{item.meta}</span>}
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  {
    page.table && (
      <section class="table-section" aria-labelledby="table-title">
        <div class="section-head compact">
          <p class="eyebrow">{ui.decisionEyebrow}</p>
          <h2 id="table-title">{ui.decisionTitle}</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                {page.table.columns.map((column) => <th>{column}</th>)}
              </tr>
            </thead>
            <tbody>
              {page.table.rows.map((row) => (
                <tr>
                  {row.map((cell) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    page.checklist && (
      <section class="checklist" aria-labelledby="checklist-title">
        <div>
          <p class="eyebrow">{ui.checklistEyebrow}</p>
          <h2 id="checklist-title">{page.checklistTitle}</h2>
        </div>
        <ul>
          {page.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )
  }

  <section class="faq" aria-labelledby="faq-title">
    <div class="section-head compact">
      <p class="eyebrow">{ui.faqEyebrow}</p>
      <h2 id="faq-title">{ui.faqTitle}</h2>
    </div>
    <div class="faq-list">
      {page.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="next">
    <div>
      <p class="eyebrow">{ui.nextEyebrow}</p>
      <h2>{ui.nextTitle}</h2>
    </div>
    <div class="next-links">
      {relatedPages.slice(0, 4).map((item) => (
        <a href={marketingPagePath(locale, item.slug)}>
          <strong>{item.navLabel}</strong>
          <span>{item.description}</span>
        </a>
      ))}
    </div>
  </section>
</article>

<style>
  .evidence-page {
    --proof-green: #087f5b;
    --proof-blue: #3157d8;
    --proof-amber: #b7791f;
    --proof-red: #b94949;
  }
  .evidence-page :global(h1),
  .evidence-page :global(h2),
  .evidence-page :global(h3),
  .evidence-page :global(p) {
    margin-top: 0;
  }
  .page-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: -1.25rem 0 2.5rem;
    padding: 0.45rem;
    background: color-mix(in srgb, var(--surface) 72%, var(--surface-sunk));
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .page-rail a {
    color: var(--ink-soft);
    border-radius: 6px;
    padding: 0.48rem 0.72rem;
    font-size: 0.8rem;
    font-weight: 680;
    text-decoration: none;
  }
  .page-rail a:hover,
  .page-rail a.active {
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.75fr);
    gap: 3rem;
    align-items: start;
    padding: 1.25rem 0 4rem;
  }
  .hero > *,
  .artifact > *,
  .checklist > *,
  .next > * {
    min-width: 0;
  }
  .eyebrow {
    color: var(--proof-green);
    font-size: 0.75rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1,
  h2 {
    font-family: var(--font-display);
    letter-spacing: 0;
  }
  h1 {
    max-width: 780px;
    margin: 0 0 1.35rem;
    font-size: clamp(2.9rem, 5.1vw, 4.45rem);
    line-height: 1.04;
  }
  .lead {
    max-width: 720px;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.7rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.68rem 1rem;
    border: 1px solid transparent;
    font-size: 0.9rem;
    font-weight: 720;
    text-decoration: none;
    text-align: center;
  }
  .button.primary {
    color: var(--surface);
    background: var(--ink);
    border-color: var(--ink);
  }
  .button.secondary {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--line);
  }
  .hero-panel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 88%, transparent), color-mix(in srgb, var(--accent-soft) 32%, transparent)),
      var(--surface);
    box-shadow: 0 30px 70px -54px rgba(var(--shadow), 0.72);
  }
  .hero-snapshot {
    display: block;
    grid-column: 1 / -1;
    width: 100%;
    height: clamp(240px, 28vw, 340px);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface-sunk);
  }
  .loop-step {
    min-height: 124px;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
  }
  .loop-step span {
    display: inline-flex;
    margin-bottom: 0.42rem;
    color: var(--proof-green);
    font: 760 0.68rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .loop-step strong {
    display: block;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.3;
  }
  .loop-step small {
    display: block;
    margin-top: 0.24rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .loop-step.review span {
    color: var(--proof-blue);
  }
  .loop-step.runtime span {
    color: var(--proof-amber);
  }
  .loop-line {
    display: none;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 5rem;
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .metrics div {
    min-height: 150px;
    padding: 1.2rem;
    background: var(--surface);
  }
  .metrics dt {
    color: var(--ink);
    font-size: 2rem;
    font-weight: 780;
    line-height: 1.05;
  }
  .metrics dd {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .artifact,
  .section,
  .table-section,
  .checklist,
  .faq,
  .next {
    padding: 5rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 104px;
  }
  .artifact {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(420px, 1.25fr);
    gap: 3rem;
    align-items: start;
  }
  .artifact h2,
  .section-head h2,
  .checklist h2,
  .next h2 {
    margin: 0 0 0.9rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.12;
  }
  .artifact p,
  .section-head p,
  .checklist p {
    color: var(--ink-soft);
    line-height: 1.8;
  }
  pre {
    margin: 0;
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--line) 84%, transparent);
    border-radius: 8px;
    background: #111713;
    color: #edf7ef;
    padding: 1.15rem;
    box-shadow: 0 28px 70px -56px rgba(0, 0, 0, 0.82);
  }
  code {
    font: 0.82rem/1.7 var(--font-mono);
  }
  .artifact ol,
  .checklist ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }
  .artifact li,
  .checklist li {
    position: relative;
    padding: 0.85rem 0.95rem 0.85rem 2.45rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink-soft);
  }
  .artifact li::before,
  .checklist li::before {
    content: '';
    position: absolute;
    top: 1.18rem;
    left: 1rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--proof-green);
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 1.45rem;
  }
  .section-head.compact {
    max-width: 820px;
  }
  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .item {
    min-height: 210px;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .item span {
    display: inline-flex;
    margin-bottom: 1.2rem;
    color: var(--proof-blue);
    font: 760 0.68rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .item h3 {
    margin-bottom: 0.55rem;
    font-size: 1.05rem;
    line-height: 1.32;
  }
  .item p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.72;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    font-size: 0.88rem;
  }
  th {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  td {
    color: var(--ink-soft);
  }
  td:first-child {
    color: var(--ink);
    font-weight: 700;
  }
  tr:last-child td {
    border-bottom: none;
  }
  .checklist {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(420px, 1.22fr);
    gap: 3rem;
    align-items: start;
  }
  .faq-list {
    display: grid;
    gap: 0.7rem;
  }
  details {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  summary {
    cursor: pointer;
    padding: 1rem 1.1rem;
    color: var(--ink);
    font-weight: 720;
  }
  details p {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--ink-soft);
    line-height: 1.75;
  }
  .next {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) minmax(440px, 1.35fr);
    gap: 3rem;
  }
  .next-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .next-links a {
    display: grid;
    gap: 0.35rem;
    min-height: 132px;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    text-decoration: none;
  }
  .next-links strong {
    color: var(--ink);
    line-height: 1.3;
  }
  .next-links span {
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .hero,
    .artifact,
    .checklist,
    .next {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
    .item-grid,
    .next-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .metrics {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .evidence-page {
      width: min(100%, calc(100vw - 2rem));
      overflow-x: clip;
    }
    .page-rail {
      margin-top: -0.5rem;
      max-width: 100%;
      flex-wrap: wrap;
      overflow-x: visible;
    }
    .page-rail a {
      flex: 1 1 calc(50% - 0.35rem);
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .hero {
      padding-top: 0.5rem;
      padding-bottom: 3rem;
    }
    .hero-copy {
      width: min(100%, calc(100vw - 2.75rem));
    }
    h1 {
      max-width: min(100%, 20rem);
      font-size: 2.32rem;
      line-height: 1.07;
      overflow-wrap: anywhere;
    }
    .lead {
      max-width: min(100%, 21rem);
      font-size: 0.98rem;
      overflow-wrap: break-word;
    }
    .actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: min(100%, 21rem);
    }
    .button {
      width: 100%;
      padding-right: 0.85rem;
      padding-left: 0.85rem;
    }
    .hero-panel {
      width: min(100%, calc(100vw - 2rem));
      grid-template-columns: minmax(0, 1fr);
      padding: 0.85rem;
    }
    .hero-snapshot {
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .loop-step {
      min-height: auto;
      padding: 0.9rem;
    }
    .loop-line {
      display: block;
      width: 1px;
      height: 22px;
      margin: -0.25rem 0 -0.25rem 1.4rem;
      background: var(--line);
    }
    .metrics {
      margin-bottom: 3rem;
    }
    .metrics div {
      min-height: auto;
    }
    .artifact,
    .section,
    .table-section,
    .checklist,
    .faq,
    .next {
      padding: 3rem 0;
    }
    .artifact h2,
    .section-head h2,
    .checklist h2,
    .next h2 {
      font-size: 2rem;
    }
    .item-grid,
    .next-links {
      grid-template-columns: minmax(0, 1fr);
    }
    .item {
      min-height: auto;
    }
    pre {
      padding: 0.95rem;
    }
    code {
      font-size: 0.76rem;
    }
  }
</style>
