---
import { Image } from 'astro:assets';
import heroImage from '../assets/objectos-home-hero.png';
import { getPostsInLocale } from '../lib/posts';
import { blogPath, formatDate, postPath, ui, type Locale } from '../lib/i18n';
import { homeCopy } from '../lib/home';
import { CLOUD_SIGNUP_URL, heroLineJoin, OBJECTSTACK_URL, positioning } from '../lib/positioning';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { CLUSTERS, clusterPath } from '../lib/clusters';
import { clusterCopy } from '../lib/cluster-i18n';
import { marketingPagePath } from '../content-pages/registry';
import VideoEmbed from './VideoEmbed.astro';

// The 90-second overview. Same video and same channel as the docs site
// homepage — these URLs are identical in every locale.
const OVERVIEW_VIDEO_ID = 'CX_FlOoOtr0';
const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@objectstack';
// The words on the video poster, drawn as HTML over the artwork (see
// VideoEmbed.astro). The title is this locale's video caption, which every
// locale already has, split after the product name: "ObjectStack" over "in 90
// Seconds", "90 秒总览", "を 90 秒で" (a leading particle stays on line one).
// The eyebrow and the sub-line are this locale's `videoPosterEyebrow` and
// `videoPosterNote` from `homeCopy` (see the interface note there).

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
// The one protocol link on the page: E1 names the three ObjectOS editions, and
// this link, right under it, says what they are built on and sends the
// developer to objectstack.ai. Nothing else on the home page links that site.
const protocolLink = positioning[locale].protocol;
const posterSplit = copy.videoCaption.match(/^(ObjectStack(?: [\u3040-\u309f]+)?) (.+)$/u);
const posterTitle: [string, string] = posterSplit ? [posterSplit[1], posterSplit[2]] : [copy.videoCaption, ''];
// The H1 is the canonical T1 split over two lines; `positioning.ts` asserts the
// two halves rejoin to T1 with exactly this joiner, so the rule lives there.
const lineJoin = heroLineJoin(locale);
// Headings in zh and ja carry a <wbr> between phrases (scripts/lib/cjk-phrases.mjs)
// and break nowhere else; the copy itself is unchanged.
const ph = (text: string): string => phraseHtml(text, locale);
const productTourHref = marketingPagePath(locale, 'product-tour');
const templatesHref = `${marketingPagePath(locale, 'templates')}#catalog`;
const agentDeveloperHref = marketingPagePath(locale, 'agent-developer');
const trustCenterHref = marketingPagePath(locale, 'trust-center');
const ontologyHref = marketingPagePath(locale, 'ontology');
const compareHref = marketingPagePath(locale, 'compare');

// Capability and AI cards deep-link into the capability pages. Index-based:
// every locale translates the same arrays in the same order.
const capabilityCardHrefs = [
  marketingPagePath(locale, 'data-modeling'),
  marketingPagePath(locale, 'data-modeling'),
  productTourHref,
  marketingPagePath(locale, 'permissions'),
];
const aiCardHrefs = [
  marketingPagePath(locale, 'ai'),
  marketingPagePath(locale, 'ai'),
  marketingPagePath(locale, 'mcp'),
];
const posts = (await getPostsInLocale(locale))
  .filter((post) => post.entry.data.status !== 'archived')
  .slice(0, 3);

const topicLink = (slug: string) => {
  const term = termBySlug(slug);
  return term ? termHref(locale, term) : `/${locale}/`;
};

const templateLinks = [
  {
    href: templatesHref,
    tone: 'green',
  },
  {
    href: templatesHref,
    tone: 'blue',
  },
  {
    href: templatesHref,
    tone: 'amber',
  },
];
const insightTerms = [
  'app-building',
  'integration-data',
  'governance',
  'crm',
  'manufacturing',
]
  .map((slug) => termBySlug(slug))
  .filter(Boolean);
const clusterLinks = CLUSTERS;
// The three "vs" chips land on the comparison page's product-by-product
// section, where each named product has its post; the section's text link
// goes to the page itself. Index-based tones, like the template cards.
const compareTones = ['green', 'blue', 'amber'];
const compareInDepthHref = `${compareHref}#in-depth`;

// A raster post cover is served as WebP at the card's width, not as the
// 1.5-1.9 MB original: one of three columns (about 345px) on a desktop, one of
// two at 641-900px, the full column on a phone. The widest candidate covers
// the phone column at 3x. An SVG cover is a few KB and is served as is.
const ARTICLE_WIDTHS = [360, 540, 720, 1080];
const ARTICLE_SIZES = '(max-width: 640px) calc(100vw - 2rem), (max-width: 900px) calc(50vw - 2rem), 360px';
// The product diagram under the positioning copy, as WebP instead of the
// 1.7 MB PNG. Its box is at most 850px wide at 3:2 (4:3 on a phone), and
// object-fit: cover draws the 1.6:1 image about 1.07x (1.2x) the box's width.
// It sits below the hero and the video at every viewport, so it stays lazy.
const HERO_WIDTHS = [480, 720, 960, 1280, 1586];
const HERO_SIZES = '(min-width: 898px) 910px, calc(120vw - 2.4rem)';
---

<div class:list={['home', `lang-${locale}`]}>
  {/* One flat flex column, deliberately: the video, the lead and the CTA row
      have to be siblings for the phone layout to reorder them with CSS
      `order` alone. Duplicating the hero markup per breakpoint would be a
      worse defect than the one the reorder fixes.

      Source order is the desktop order. On phones and small tablets the media
      query below reorders to eyebrow, h1, video, lead, CTAs, proof — which is
      also the more literal reading of "the video plays directly under the
      headline", since on a phone the lead alone runs about nine lines. */}
  <section class="hero">
    <p class="eyebrow"><span></span> <Fragment set:html={ph(copy.eyebrow)} /></p>
    <h1><span class="title-line" set:html={ph(copy.hero[0])} />{lineJoin}<strong set:html={ph(copy.hero[1])} /></h1>
    <p class="hero-lead">{copy.heroLead}</p>
    <a class="text-link hero-protocol-link" href={OBJECTSTACK_URL}>{protocolLink} <span aria-hidden="true">→</span></a>
    <div class="hero-actions">
      <a class="button primary" href={CLOUD_SIGNUP_URL}>{copy.primaryCta} <span>→</span></a>
      <a class="button secondary" href={productTourHref}>{copy.secondaryCta}</a>
    </div>
    <figure class="hero-video">
      <VideoEmbed
        videoId={OVERVIEW_VIDEO_ID}
        title={copy.videoCaption}
        poster="/images/objectstack-overview-poster-art.svg"
        playLabel={copy.videoPlayLabel}
        posterText={{
          eyebrow: copy.videoPosterEyebrow,
          title: posterTitle,
          note: copy.videoPosterNote,
        }}
      />
      <figcaption>
        <span class="video-name">{copy.videoCaption}</span>
        <a class="text-link" href={YOUTUBE_CHANNEL_URL} target="_blank" rel="noopener">
          {copy.videoMoreLink} <span aria-hidden="true">→</span>
        </a>
      </figcaption>
    </figure>
    <dl class="proof">
      {copy.proof.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}
    </dl>
  </section>

  <section class="positioning" aria-label={copy.positioningKicker}>
    <p class="section-kicker">{copy.positioningKicker}</p>
    <h2><span class="title-line" set:html={ph(copy.positioningTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.positioningTitle[1])} /></h2>
    <p class="positioning-copy">{copy.positioningCopy}</p>
    <a class="text-link positioning-link" href={ontologyHref}>{copy.positioningLink} <span aria-hidden="true">→</span></a>
    {/* The product diagram used to open the hero. The overview video is the
        page's first visual now, so this sits below it, illustrating the
        positioning it belongs to. */}
    <div class="hero-media">
      <Image
        src={heroImage}
        alt={copy.imageAlt}
        widths={HERO_WIDTHS}
        sizes={HERO_SIZES}
        format="webp"
        loading="lazy"
        decoding="async"
      />
      <div class="media-note">
        <span class="live-dot"></span>
        <span><strong>{copy.imageNoteTitle}</strong>{copy.imageNote}</span>
      </div>
    </div>
  </section>

  <section class="capability-section" id="capabilities">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.capabilitiesKicker}</p>
        <h2><span class="title-line" set:html={ph(copy.capabilitiesTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.capabilitiesTitle[1])} /></h2>
      </div>
      <a class="text-link" href={agentDeveloperHref}>{copy.capabilitiesLink} <span>→</span></a>
    </div>
    <ol class="capability-list">
      {copy.capabilities.map((item, index) => (
        <li>
          <span class="cap-index">{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={capabilityCardHrefs[index] ?? productTourHref}>
              {item.title}&nbsp;<span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="ai-section" id="ai">
    <div class="ai-copy">
      <p class="section-kicker">{copy.aiKicker}</p>
      <h2><span class="title-line" set:html={ph(copy.aiTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.aiTitle[1])} /></h2>
      <p>{copy.aiCopy}</p>
      <a class="text-link" href={agentDeveloperHref}>{copy.aiLink} <span>→</span></a>
    </div>
    <div class="ai-grid">
      {copy.aiItems.map((item, index) => (
        <div class:list={['ai-card', `tone-${index + 1}`]}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>
            <a href={aiCardHrefs[index] ?? productTourHref}>
              {item.title}&nbsp;<span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="workflow">
    <div class="workflow-intro">
      <p class="section-kicker">{copy.workflowKicker}</p>
      <h2><span class="title-line" set:html={ph(copy.workflowTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.workflowTitle[1])} /></h2>
      <p>{copy.workflowCopy}</p>
    </div>
    <div class="workflow-map" aria-label={copy.workflowKicker}>
      <div class="map-row">
        <span class="map-label">{copy.existingSystems}</span>
        <div class="map-items">
          {copy.systemLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
      <div class="connector"><span></span><b>{copy.connectModel}</b><span></span></div>
      <div class="object-layer">
        <small>OBJECTSTACK DEFINITION LAYER</small>
        <strong>{copy.objectLayer}</strong>
      </div>
      <div class="connector"><span></span><b>{copy.secureExecution}</b><span></span></div>
      <div class="map-row outputs">
        <span class="map-label">{copy.outcomes}</span>
        <div class="map-items">
          {copy.outcomeLabels.map((label) => <span>{label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="security-section" id="security">
    <div class="security-copy">
      <p class="section-kicker">{copy.securityKicker}</p>
      <h2><span class="title-line" set:html={ph(copy.securityTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.securityTitle[1])} /></h2>
      <p>{copy.securityCopy}</p>
      <a class="text-link" href={trustCenterHref}>{copy.securityLink} <span>→</span></a>
    </div>
    <div class="security-grid">
      {copy.securityItems.map((item) => (
        <div class="security-item">
          <span></span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="solution-section" id="templates">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.solutionsKicker}</p>
        <h2><span class="title-line" set:html={ph(copy.solutionsTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.solutionsTitle[1])} /></h2>
      </div>
    </div>
    <div class="solution-grid">
      {copy.solutions.map((solution, index) => (
        <a
          class:list={['solution', templateLinks[index].tone]}
          href={templateLinks[index].href}
        >
          <span class="solution-mark"></span>
          <h3>{solution.title}</h3>
          <p>{solution.copy}</p>
          <span class="solution-link">{copy.solutionLink}&nbsp;→</span>
        </a>
      ))}
    </div>
  </section>

  {/* id="compare" is a nav contract: the header's "Why ObjectOS" item links here. */}
  <section class="solution-section" id="compare">
    <div class="section-head">
      <div>
        <p class="section-kicker">{copy.compareKicker}</p>
        <h2><span class="title-line" set:html={ph(copy.compareTitle[0])} />{lineJoin}<span class="title-line" set:html={ph(copy.compareTitle[1])} /></h2>
      </div>
      <a class="text-link" href={compareHref}>{copy.compareLink} <span>→</span></a>
    </div>
    <div class="solution-grid">
      {copy.comparisons.map((c, index) => (
        <a
          class:list={['solution', compareTones[index]]}
          href={compareInDepthHref}
        >
          <span class="solution-mark"></span>
          <h3>{c.title}</h3>
          <p>{c.copy}</p>
          <span class="solution-link">{copy.compareLink}&nbsp;→</span>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="articles">
      <div class="section-head">
        <div>
          <p class="section-kicker">{copy.insightsKicker}</p>
          <h2 set:html={ph(copy.insightsTitle)} />
        </div>
        <a class="text-link" href={blogPath(locale)}>{copy.insightsLink} <span>→</span></a>
      </div>
      <nav class="insight-links" aria-label={copy.insightsTitle}>
        {insightTerms.map((term) => (
          <a href={termHref(locale, term!)}>
            {termLabel(term!.slug, locale)}
          </a>
        ))}
      </nav>
      {clusterLinks.length > 0 && (
        <nav class="cluster-links" aria-label={ui[locale].siteNav.featuredClusters}>
          {clusterLinks.map((cluster) => (
            <a href={clusterPath(locale, cluster.slug)}>{clusterCopy(cluster, locale).shortTitle}</a>
          ))}
        </nav>
      )}
      <div class="article-grid">
        {posts.map((post) => (
          <a class="article" href={postPath(locale, post.slug)}>
            {post.entry.data.cover &&
              (post.entry.data.cover.format === 'svg' ? (
                <img
                  src={post.entry.data.cover.src}
                  alt={post.entry.data.title}
                  width={post.entry.data.cover.width}
                  height={post.entry.data.cover.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={post.entry.data.cover}
                  alt={post.entry.data.title}
                  width={Math.min(ARTICLE_WIDTHS.at(-1)!, post.entry.data.cover.width)}
                  widths={ARTICLE_WIDTHS}
                  sizes={ARTICLE_SIZES}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            <div>
              <time datetime={post.entry.data.date.toISOString().slice(0, 10)}>
                {formatDate(locale, post.entry.data.date)}
              </time>
              <h3>{post.entry.data.title}</h3>
              <p>{post.entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="closing">
    <p class="section-kicker">{copy.closingKicker}</p>
    <h2 set:html={ph(copy.closingTitle)} />
    <p>{copy.closingCopy}</p>
    <a class="button light" href={topicLink('integration-data')}>{copy.closingCta} <span>→</span></a>
  </section>
</div>

<style>
  /* The accents colour text (kickers, indexes, card links), so each clears
     4.5:1 on --surface and --bg in its theme. Light: green 5.33, blue 6.01,
     amber 5.34, red 4.90 on --surface. The light values are dark inks that
     read 2.8-3.1:1 on the dark surface, hence the override: green 7.20,
     blue 7.03, amber 7.74, red 6.92 on the dark --surface. */
  .home {
    --home-green: #057a58;
    --home-blue: #3157d8;
    --home-amber: #93600f;
    --home-red: #bd4b4b;
    --panel-shadow: 0 22px 58px -42px rgba(var(--shadow), 0.62);
  }
  :global(:root[data-theme='dark']) .home {
    --home-green: #3fbf8f;
    --home-blue: #8fa3ff;
    --home-amber: #e3a54a;
    --home-red: #f08a8a;
  }
  .home :global(h1),
  .home :global(h2),
  .home :global(h3),
  .home :global(p) {
    margin-top: 0;
  }
  .home :global(h1),
  .home :global(h2) {
    font-family: var(--font-display);
    font-weight: 760;
    text-wrap: balance;
  }
  /* A two-part heading is two block lines, each balanced on its own. A forced
     <br> between them kept the desktop shape but, once a part wrapped on a
     phone, left one word of it alone on a line ("model,", "agents."). */
  .title-line {
    display: block;
  }
  /* zh and ja headings break only at the <wbr> between phrases, so a word
     such as ソフトウェア or 网络 is never split across lines; a phrase wider
     than the line still breaks, as a last resort. ko breaks at its own
     spaces, so keep-all alone keeps 시스템 whole; no <wbr>. The ko card
     titles (h3) take it too: they carry no <wbr>, so zh and ja h3 cannot. */
  .home :global(h1:lang(zh)),
  .home :global(h1:lang(ja)),
  .home :global(h1:lang(ko)),
  .home :global(h2:lang(zh)),
  .home :global(h2:lang(ja)),
  .home :global(h2:lang(ko)),
  .home :global(h3:lang(ko)),
  .eyebrow:lang(zh),
  .eyebrow:lang(ja),
  .eyebrow:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* Single column since the overview video took over as the page's opening
     visual: the copy block runs full width and the video sits directly under
     it. No `min-height` floor here on purpose — the old one reserved a
     viewport's worth of space for the side image and would now do nothing but
     push the video below the fold. */
  /* Flex column so the phone breakpoint can reorder these six children with
     `order` alone. Centred, like the docs site hero: left-aligned copy in a
     single column left ~680px of a 1440px viewport empty where the side image
     used to be, and put the text on a different axis from the video. */
  .hero {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0 2.5rem;
    text-align: center;
  }
  .hero > .eyebrow,
  .hero > h1 {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }
  /* No `justify-content` for the eyebrow: it is inline content now (see the
     `.eyebrow` rule below), centred by the hero's own `text-align: center`. */
  .hero > .hero-lead {
    margin-inline: auto;
  }
  .hero > .hero-actions {
    justify-content: center;
  }
  /* Wider than the copy column, and the gap the old separate video section
     used to get from the hero's bottom padding. */
  .hero-video,
  .hero > .proof {
    width: 100%;
    max-width: 940px;
    margin-inline: auto;
  }
  .hero-video {
    margin-top: 2rem;
    margin-bottom: 0;
  }
  .eyebrow,
  .section-kicker {
    color: var(--home-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* The rule is a lead-in glued to the first word, not a column of its own.
     As a flex row the rule and the text were two flex items: the text item
     took all the remaining width and centred itself inside it, so the moment
     the eyebrow wrapped — every locale at ≤390px, measured — the rule was
     stranded at the far left, 37-55px from the nearest word and floating at
     the vertical middle of the two lines, reading as a stray mark rather than
     a lead-in. Laid out as inline content instead, the rule stays on the
     first line immediately before the first word, wherever `text-align:
     center` puts that line.

     This is deliberately not a phone-only override. At ≥414px, where the
     eyebrow is a single line in every locale, inline flow reproduces the flex
     row's geometry: same 8.8px gap (`margin-right` replaces the `gap`), rule
     centred on the line to within 0.06px, and the eyebrow box the same height
     — which is what keeps the video below it from moving. */
  .eyebrow {
    display: block;
    margin-bottom: 1.35rem;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .eyebrow span {
    display: inline-block;
    width: 26px;
    height: 1px;
    margin-right: 0.55rem;
    vertical-align: middle;
    background: currentColor;
  }
  .hero h1 {
    /* Sized by whichever axis is tighter. The headline was sized off width
       alone, so a 1366x768 laptop got a 74px two-line headline — ~216px, the
       single largest thing between the top of the page and the video. The
       `8vh` term is self-limiting: 8vh reaches the 5rem ceiling at 1000px of
       viewport height, so a tall desktop computes exactly what it computed
       before, and the size meets the old value continuously rather than
       stepping at a breakpoint.
       (`vh` is the large viewport height, so a collapsing mobile URL bar does
       not resize it — and phones take the fixed 2.7rem below anyway.) */
    font-size: clamp(3.1rem, min(5.4vw, 8vh), 5rem);
    line-height: 1.01;
    letter-spacing: 0;
    margin-bottom: 1.4rem;
    /* The single-column hero gives the headline a wider measure than the old
       two-column one did, which left a one-word orphan on its second line. */
    text-wrap: balance;
  }
  .hero h1 strong {
    display: block;
    color: color-mix(in srgb, var(--home-green) 88%, var(--ink));
    font-weight: inherit;
    font-size: 0.9em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-lead {
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
    max-width: 35rem;
    margin-bottom: 0.9rem;
  }
  /* The protocol link sits between the lead and the CTA row, as the lead's
     secondary line, so the row keeps the lead's old 1.8rem clearance. The
     hero is a centred flex column, so the link centres itself too. */
  .hero-protocol-link {
    align-self: center;
    margin-bottom: 1.8rem;
  }
  /* Desktop measure and leading for the lead, which runs T2, T4 and E1
     together: at 35rem/1.85 it was seven lines in en and nine in ja, and with
     the CTA row under it that was 609-664px of a 625px laptop screen. */
  @media (min-width: 901px) {
    .hero-lead {
      max-width: 40rem;
      line-height: 1.72;
      margin-bottom: 1.5rem;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.32) inset;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button.primary {
    color: white;
    background: linear-gradient(135deg, #151a17, #24483b);
    box-shadow: 0 18px 34px -24px rgba(5, 122, 88, 0.75);
  }
  .button.secondary {
    border-color: var(--line);
    background: var(--surface);
    box-shadow: 0 12px 30px -26px rgba(var(--shadow), 0.45);
  }
  /* Four chips, one per promise of the README's T3 line, so four columns at
     desktop width — at the strip's 940px that is ~220px a column, which holds
     the longest title (`de` "Von Agents bedienbar", `ja` the twelve-kana
     agent chip) on one line. 2-up on tablets, 1-up on phones below. */
  .proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 2.25rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .proof div {
    display: flex;
    flex-direction: column;
  }
  .proof dt {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }
  .proof dd {
    color: var(--muted);
    font-size: 0.75rem;
    margin: 0.1rem 0 0;
  }
  .hero-media {
    position: relative;
    isolation: isolate;
    margin-top: 3rem;
  }
  .hero-media::before {
    content: '';
    position: absolute;
    inset: -18px 22px 28px -20px;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--home-green) 28%, transparent);
    border-radius: 8px;
  }
  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    border-radius: 8px;
    box-shadow: 0 34px 86px -48px rgba(19, 78, 58, 0.78);
  }
  /* Dark theme: the same dimming as the marketing pages' hero
     (MarketingEvidencePage.astro): the white render is muted on the image
     itself rather than left as a white block on the dark page. */
  :global(:root[data-theme='dark']) .hero-media img {
    filter: brightness(0.6) contrast(1.12);
  }
  .media-note {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    max-width: 250px;
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.75rem 0.85rem;
    color: #292524;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 8px;
    box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.4);
    font-size: 0.72rem;
    line-height: 1.5;
    backdrop-filter: blur(12px);
  }
  /* Dark theme: the note was the light theme's near-white glass, which stood
     out the more once the image under it was dimmed. It takes the dark
     surface instead; --ink on it is the page's own body-text pair. */
  :global(:root[data-theme='dark']) .media-note {
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    border-color: var(--line);
    box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.7);
  }
  .media-note strong {
    display: block;
    font-size: 0.78rem;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    margin-top: 0.3rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.13);
  }
  /* The 90-second overview. It is a `figure` in the hero's flex column now,
     so its width and spacing live with the other hero children above. */
  .hero-video {
    margin-left: auto;
    margin-right: auto;
  }
  .hero-video figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.15rem;
    margin-top: 0.95rem;
    font-size: 0.85rem;
  }
  .video-name {
    color: var(--ink-soft);
    font-weight: 650;
  }
  .positioning {
    max-width: 850px;
    padding: 7rem 0 8rem;
    position: relative;
  }
  .positioning::before {
    content: '';
    display: block;
    width: 96px;
    height: 5px;
    margin-bottom: 2.4rem;
    background: linear-gradient(90deg, var(--home-green), var(--home-blue), var(--home-amber));
  }
  .positioning h2,
  .section-head h2,
  .ai-copy h2,
  .workflow-intro h2,
  .security-copy h2,
  .closing h2 {
    font-size: clamp(2rem, 4.2vw, 3.55rem);
    line-height: 1.18;
    letter-spacing: 0;
    margin-bottom: 1.3rem;
  }
  .positioning-copy,
  .ai-copy > p,
  .workflow-intro > p:last-child,
  .security-copy > p:last-child,
  .closing > p {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.9;
  }
  /* The positioning section is a block, not a flex head, so the shared
     text-link needs its own vertical spacing here. */
  .positioning-link {
    display: inline-block;
    margin-top: 0.5rem;
  }
  .capability-section,
  .ai-section,
  .workflow,
  .security-section,
  .solution-section,
  .articles {
    padding: 7rem 0;
    border-top: 1px solid var(--line);
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .text-link {
    flex: 0 0 auto;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    transition: color 0.16s ease, border-color 0.16s ease;
  }
  .text-link:hover {
    color: var(--home-green);
    border-color: var(--home-green);
  }
  .capability-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .capability-list li {
    display: grid;
    grid-template-columns: 40px 1fr;
    /* A row's taller card stretches its neighbour; without this the extra
       height is shared into the title row and pushes the body down. */
    align-content: start;
    gap: 0 1rem;
    padding: 2rem 1.5rem 2.2rem 0;
    border-bottom: 1px solid var(--line);
    transition: background 0.16s ease;
  }
  .capability-list li:hover {
    background: color-mix(in srgb, var(--surface) 42%, transparent);
  }
  .capability-list li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .capability-list li:nth-child(even) {
    padding-left: 1.5rem;
  }
  .cap-index {
    grid-row: span 2;
    color: var(--home-green);
    font: 700 0.72rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .capability-list h3 {
    font-size: 1.12rem;
    line-height: 1.45;
    margin-bottom: 0.55rem;
  }
  .capability-list h3 a,
  .ai-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* The title link covers its whole card: the card is the tap target, not
     the 20px title line, and it is the only link in the card. */
  .capability-list li,
  .ai-card {
    position: relative;
  }
  .capability-list h3 a::after,
  .ai-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .capability-list h3 a:hover,
  .ai-card h3 a:hover {
    text-decoration: underline;
  }
  .card-arrow {
    color: var(--accent);
    font-size: 0.85em;
  }
  .capability-list p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.86fr) minmax(460px, 1.14fr);
    gap: 4rem;
    align-items: start;
  }
  .ai-copy .text-link {
    display: inline-block;
    margin-top: 0.6rem;
  }
  .ai-grid {
    display: grid;
    gap: 0.9rem;
  }
  .ai-card {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 0 1rem;
    padding: 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--panel-shadow);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .ai-card:hover {
    border-color: color-mix(in srgb, var(--tone) 36%, var(--line));
    box-shadow: 0 28px 64px -42px color-mix(in srgb, var(--tone) 35%, rgba(var(--shadow), 0.5));
    transform: translateY(-2px);
  }
  .ai-card span {
    grid-row: span 2;
    color: var(--tone);
    font: 750 0.78rem/1 var(--font-mono);
    padding-top: 0.35rem;
  }
  .ai-card h3 {
    font-size: 1.12rem;
    margin-bottom: 0.55rem;
  }
  .ai-card p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 0;
  }
  .ai-card.tone-1 { --tone: var(--home-blue); }
  .ai-card.tone-2 { --tone: var(--home-green); }
  .ai-card.tone-3 { --tone: var(--home-amber); }
  .workflow {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(440px, 1.25fr);
    gap: 5rem;
    align-items: center;
  }
  .workflow > * {
    min-width: 0;
  }
  .workflow-map {
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--panel-shadow);
  }
  .map-row {
    display: grid;
    gap: 0.8rem;
  }
  .map-label {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .map-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }
  .map-items span {
    display: grid;
    min-height: 54px;
    place-items: center;
    color: var(--ink-soft);
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 650;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .outputs .map-items {
    grid-template-columns: repeat(3, 1fr);
  }
  .outputs .map-items span {
    color: var(--home-green);
    background: color-mix(in srgb, var(--home-green) 8%, var(--surface));
    border-color: color-mix(in srgb, var(--home-green) 25%, var(--line));
  }
  .connector {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.7rem;
    align-items: center;
    margin: 1rem 0;
    color: var(--muted);
  }
  .connector span {
    height: 1px;
    background: var(--line);
  }
  .connector b {
    font-size: 0.64rem;
    font-weight: 650;
  }
  .object-layer {
    display: grid;
    gap: 0.45rem;
    padding: 1.25rem;
    color: white;
    background: linear-gradient(135deg, #12352c, #183f35);
    border-radius: 6px;
    box-shadow: 0 18px 42px -30px rgba(5, 122, 88, 0.9);
    text-align: center;
  }
  .object-layer small {
    color: #8ee3c2;
    font: 650 0.58rem/1.4 var(--font-mono);
  }
  .object-layer strong {
    font-size: 0.88rem;
  }
  .security-section {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(460px, 1.2fr);
    gap: 4rem;
    align-items: start;
  }
  .security-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--panel-shadow);
  }
  .security-item {
    min-height: 230px;
    padding: 1.45rem;
    background: var(--surface);
    transition: background 0.18s ease;
  }
  .security-item:hover {
    background: color-mix(in srgb, var(--surface) 88%, var(--accent-soft));
  }
  .security-item span {
    display: block;
    width: 28px;
    height: 4px;
    margin-bottom: 2.2rem;
    background: var(--home-green);
    border-radius: 999px;
  }
  .security-item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.65rem;
  }
  .security-item p {
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.72;
    margin-bottom: 0;
  }
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  /* No min-height: a floor taller than the content only reserved empty space
     (94px of it above every title, when the mark took the slack). */
  .solution {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    box-shadow: var(--panel-shadow);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .solution:hover {
    transform: translateY(-3px);
    border-color: var(--tone);
    box-shadow: 0 30px 64px -44px color-mix(in srgb, var(--tone) 42%, rgba(var(--shadow), 0.55));
  }
  .solution.green { --tone: var(--home-green); }
  .solution.blue { --tone: var(--home-blue); }
  .solution.amber { --tone: var(--home-amber); }
  .solution-mark {
    width: 34px;
    height: 5px;
    margin-bottom: 1.6rem;
    background: var(--tone);
    border-radius: 999px;
  }
  .solution h3 {
    font-size: 1.35rem;
    margin-bottom: 0.65rem;
  }
  .solution p {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.75;
    margin-bottom: 1.4rem;
  }
  /* The card's slack goes above the link, so titles sit under the mark and
     the links line up along the bottom of a row. */
  .solution-link {
    margin-top: auto;
    color: var(--tone);
    font-size: 0.76rem;
    font-weight: 700;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .insight-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: -1.7rem 0 2rem;
  }
  .insight-links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 12px 28px -24px rgba(var(--shadow), 0.42);
    transition: transform 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }
  .insight-links a:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateY(-1px);
  }
  .cluster-links {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.6rem;
    margin: -1rem 0 2.4rem;
  }
  .cluster-links a {
    min-height: 72px;
    display: flex;
    align-items: flex-end;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 760;
    line-height: 1.25;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(180deg, transparent, color-mix(in srgb, var(--home-green) 9%, transparent)),
      var(--surface);
    transition: transform 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }
  .cluster-links a:hover {
    color: var(--home-green);
    border-color: color-mix(in srgb, var(--home-green) 38%, var(--line));
    transform: translateY(-2px);
  }
  .article {
    color: var(--ink);
    text-decoration: none;
  }
  /* `height: auto` is load-bearing: the `height` attribute maps to a CSS
     height, which beats `aspect-ratio` and cut each 16:9 cover to a 344×500
     sliver. The box is the covers' own 16:9; `contain` letterboxes the odd
     16:10 cover instead of cropping its title. */
  .article img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-sunk);
    box-shadow: 0 18px 42px -34px rgba(var(--shadow), 0.52);
  }
  .article time {
    color: var(--muted);
    font: 600 0.68rem/1 var(--font-mono);
  }
  .article h3 {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0.65rem 0 0.4rem;
    transition: color 0.16s ease;
  }
  .article:hover h3 {
    color: var(--home-green);
  }
  .article p {
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .closing {
    margin-top: 7rem;
    padding: 5rem;
    color: white;
    background:
      linear-gradient(135deg, rgba(23, 43, 38, 0.96), rgba(21, 26, 23, 0.98)),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 64px);
    border: 1px solid rgba(142, 227, 194, 0.18);
    border-radius: 8px;
    box-shadow: 0 36px 90px -58px rgba(5, 122, 88, 0.82);
  }
  .closing .section-kicker {
    color: #8ee3c2;
  }
  .closing > p {
    color: #bdc9c5;
  }
  .button.light {
    margin-top: 1rem;
    color: #172b26;
    background: white;
  }
  /* The video moves directly under the headline, ahead of the lead and the CTA
     row, on phones and small tablets (`max-width: 900px`), where the lead alone
     runs about nine lines and pushed the video off the screen entirely. The
     markup and the source order are untouched, so this costs no duplicated
     DOM.

     A wide but short screen keeps the source order: eyebrow, headline, lead,
     CTA row, then the video. This rule used to fire on `max-height: 1040px`
     too, to get the video into a laptop's first screen, and that put the
     primary CTA under a 529px frame: its bottom was at 1207px on a 1366x625
     laptop and 1256px at 1920x945, with the lead off-screen as well. The CTA
     is the screen's job; the video starts right under it (43px of it shows at
     1366x625 in en, 314px at 1920x945) and the header CTA stays sticky. */
  @media (max-width: 900px) {
    .hero > .eyebrow {
      order: 1;
    }
    .hero > h1 {
      order: 2;
    }
    .hero-video {
      order: 3;
      margin-top: 0.25rem;
      margin-bottom: 2rem;
    }
    .hero > .hero-lead,
    .hero > .hero-protocol-link {
      /* Same order value: flex keeps source order within it, so the link
         stays right under the lead on a phone instead of falling to the top
         as an unordered child would. */
      order: 4;
    }
    .hero > .hero-actions {
      order: 5;
    }
    .hero > .proof {
      order: 6;
    }
  }
  @media (max-width: 900px) {
    .hero {
      padding-top: 1.5rem;
    }
    .hero > .eyebrow,
    .hero > h1 {
      max-width: 680px;
    }
    .workflow {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .ai-section,
    .security-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .solution-grid,
    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
    .cluster-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .solution:last-child {
      grid-column: span 2;
    }
    /* Four chips in two rows of two: at tablet widths four columns would be
       ~150px each, which breaks the longer titles onto two lines. */
    .proof {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .home.lang-de .hero h1,
  .home.lang-fr .hero h1,
  .home.lang-es .hero h1 {
    font-size: clamp(2.8rem, 4vw, 4rem);
  }
  /* A Japanese heading breaks only between phrases, and a phrase keeps its
     particle (オペレーションを、 is nine characters), so the section headings
     are sized for the narrowest column they sit in: the workflow column is
     372px at 1366, which held 6.5 characters at 3.55rem and broke inside
     オペレーション. 2.5rem holds nine. Phones keep 2rem. */
  .home.lang-ja .positioning h2,
  .home.lang-ja .section-head h2,
  .home.lang-ja .ai-copy h2,
  .home.lang-ja .workflow-intro h2,
  .home.lang-ja .security-copy h2,
  .home.lang-ja .closing h2 {
    font-size: clamp(2rem, 3vw, 2.5rem);
  }
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2.7rem;
    }
    .home.lang-de .hero h1,
    .home.lang-fr .hero h1,
    .home.lang-es .hero h1 {
      font-size: 2.25rem;
    }
    /* The second line, ソフトウェアである。, is one phrase of ten characters:
       at 2.7rem it was wider than a 390px phone's column and broke inside it.
       At 2.15rem it fits the 312px column of a 360px phone. */
    .home.lang-ja .hero h1 {
      font-size: 2.15rem;
    }
    .hero-media img {
      aspect-ratio: 4 / 3;
    }
    .media-note {
      display: none;
    }
    .hero-media::before {
      inset: -10px 12px 18px -10px;
    }
    /* One column on phones. Two columns survive down here only by getting
       narrower than their own content: at 390px each column is ~175px,
       which breaks the longer titles (`de`, `fr`) onto two lines and runs
       the `dd` to three. The value below is a row gap separating four
       stacked entries.

       640px is this file's existing phone breakpoint rather than a new
       number. The strip is the last child in both the source order and the
