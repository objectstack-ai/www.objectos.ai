---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import ChineseHome from '../../components/ChineseHome.astro';
import { ui, segToLocale, homePath, LOCALES } from '../../lib/i18n';
import { s2t } from '../../lib/zhconvert';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const t = ui[locale];
const ZH = '构建 AI-native 软件的文章。';
const description =
  locale === 'zh-Hans'
    ? 'ObjectOS 是面向企业业务系统的 AI-native 应用平台，连接现有数据、应用、流程与 AI Agent。'
    : locale === 'en'
    ? 'Writing on building AI-native software.'
    : locale === 'zh-Hant'
      ? s2t(ZH)
      : ZH;
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));
---

<Base
  title={locale === 'zh-Hans' ? 'ObjectOS · AI-native 企业应用平台' : `${t.articlesTitle} · ${t.siteName}`}
  {description}
  {locale}
  {alternates}>
  {locale === 'zh-Hans' ? <ChineseHome /> : <ArticleList {locale} />}
</Base>
