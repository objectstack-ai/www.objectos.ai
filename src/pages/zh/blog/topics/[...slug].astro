---
import Base from '../../../../layouts/Base.astro';
import ArticleList from '../../../../components/ArticleList.astro';
import { getAllUsedTerms } from '../../../../lib/posts';
import { termBySlug, termSlugPath, termHref } from '../../../../lib/terms';
import { ui } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const terms = await getAllUsedTerms();
  return terms.map((term) => ({
    params: { slug: termSlugPath(term) },
    props: { group: term.group, slug: term.slug },
  }));
}

const { group, slug } = Astro.props;
const term = termBySlug(slug)!;
---

<Base
  title={`${term.label['zh-Hans']} · ${ui['zh-Hans'].siteName}`}
  description={`${term.label['zh-Hans']} —— 构建 AI-native 软件的文章。`}
  locale="zh-Hans"
  enHref={termHref('en', term)}
  zhHref={termHref('zh-Hans', term)}>
  <ArticleList locale="zh-Hans" filter={{ group, slug }} />
</Base>
