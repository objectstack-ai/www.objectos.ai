---
import { phraseHtml } from '../lib/cjk-phrases';
import { postPath, type Locale } from '../lib/i18n';
import { securityEnglishFields, type SecurityCopy } from '../lib/security';

interface Props {
  copy: SecurityCopy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const docsHref = 'https://docs.objectos.ai/docs/reference/security';
const lineJoin = locale === 'zh-Hans' || locale === 'zh-Hant' || locale === 'ja' ? '' : ' ';
// One target in every locale: the agent security-boundaries article, which is
// published in all eight. The English page used to send readers to the
// existing-systems post while Chinese sent them here, so the same button meant
// two different things.
const blogSlug = 'ai-agent-business-data-security-boundaries';
// `postPath` carries the trailing slash: `/en/blog/x` answers with a 308 to
// `/en/blog/x/`, a redirect on every security page's CTA.
const blogHref = postPath(locale, blogSlug);
// The ja/de/es/fr/ko copies translate the frame and inherit the rest from
// English; each inherited part is marked `lang="en"` so it is announced, and
// identified, as English (WCAG 3.1.2). `undefined` renders no attribute.
const englishFields = securityEnglishFields(locale);
const en = (field: keyof SecurityCopy): 'en' | undefined =>
  englishFields.has(field) ? 'en' : undefined;
// zh and ja headings carry a <wbr> between phrases (src/lib/cjk-phrases.ts);
// a field inherited from English is English text and gets none.
const ph = (text: string, field: keyof SecurityCopy): string => phraseHtml(text, en(field) ?? locale);
---

<article class="security-page">
  <section class="hero">
    <p class="eyebrow" lang={en('eyebrow')}>{copy.eyebrow}</p>
    <h1 lang={en('hero')}><Fragment set:html={ph(copy.hero[0], 'hero')} /><br />{lineJoin}<strong set:html={ph(copy.hero[1], 'hero')} /></h1>
    <p class="lead" lang={en('lead')}>{copy.lead}</p>
    <dl class="metrics" lang={en('metrics')}>
      {copy.metrics.map((item) => (
        <div>
          <dt>{item.value}</dt>
          <dd>{item.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <nav class="page-nav" aria-label={copy.title}>
    <a href="#ai" lang={en('aiTitle')}>{copy.aiTitle}</a>
    <a href="#data" lang={en('residencyTitle')}>{copy.residencyTitle}</a>
    <a href="#permissions" lang={en('permissionTitle')}>{copy.permissionTitle}</a>
    <a href="#deployment" lang={en('deploymentTitle')}>{copy.deploymentTitle}</a>
    <a href="#faq" lang={en('faqTitle')}>{copy.faqTitle}</a>
  </nav>

  <section class="panel ai-panel" id="ai">
    <div class="section-head">
      <p class="eyebrow" lang={en('aiKicker')}>{copy.aiKicker}</p>
      <h2 lang={en('aiTitle')} set:html={ph(copy.aiTitle, 'aiTitle')} />
      <p lang={en('aiLead')}>{copy.aiLead}</p>
    </div>
    <ol class="step-grid" lang={en('aiSteps')}>
      {copy.aiSteps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="split" id="data">
    <div>
      <p class="eyebrow" lang={en('residencyKicker')}>{copy.residencyKicker}</p>
      <h2 id="residency-title" lang={en('residencyTitle')} set:html={ph(copy.residencyTitle, 'residencyTitle')} />
      <p lang={en('residencyLead')}>{copy.residencyLead}</p>
    </div>
    <div class="table-wrap" tabindex="0" role="group" aria-labelledby="residency-title">
      <table>
        <thead lang={en('residencyColumns')}>
          <tr>
            {copy.residencyColumns.map((column) => <th>{column}</th>)}
          </tr>
        </thead>
        <tbody lang={en('residencyRows')}>
          {copy.residencyRows.map((row) => (
            <tr>
              <td>{row.data}</td>
              <td>{row.location}</td>
              <td>{row.leaves}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="split permissions" id="permissions">
    <div>
      <p class="eyebrow" lang={en('permissionKicker')}>{copy.permissionKicker}</p>
      <h2 lang={en('permissionTitle')} set:html={ph(copy.permissionTitle, 'permissionTitle')} />
      <p lang={en('permissionLead')}>{copy.permissionLead}</p>
    </div>
    <div class="layer-list" lang={en('permissionLayers')}>
      {copy.permissionLayers.map((layer) => (
        <div>
          <h3>{layer.title}</h3>
          <p>{layer.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="panel" id="deployment">
    <div class="section-head">
      <p class="eyebrow" lang={en('deploymentKicker')}>{copy.deploymentKicker}</p>
      <h2 lang={en('deploymentTitle')} set:html={ph(copy.deploymentTitle, 'deploymentTitle')} />
      <p lang={en('deploymentLead')}>{copy.deploymentLead}</p>
    </div>
    <div class="deploy-grid" lang={en('deployments')}>
      {copy.deployments.map((deployment) => (
        <div>
          <h3>{deployment.title}</h3>
          <p>{deployment.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="section-head">
      <p class="eyebrow" lang={en('faqKicker')}>{copy.faqKicker}</p>
      <h2 lang={en('faqTitle')} set:html={ph(copy.faqTitle, 'faqTitle')} />
    </div>
    <div class="faq-list" lang={en('faqs')}>
      {copy.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <p class="eyebrow" lang={en('ctaKicker')}>{copy.ctaKicker}</p>
    <h2 lang={en('ctaTitle')} set:html={ph(copy.ctaTitle, 'ctaTitle')} />
    <p lang={en('ctaCopy')}>{copy.ctaCopy}</p>
    <div class="actions">
      <a class="button primary" href={docsHref} lang={en('ctaPrimary')}>{copy.ctaPrimary} <span>→</span></a>
      <a class="button secondary" href={blogHref} lang={en('ctaSecondary')}>{copy.ctaSecondary}</a>
    </div>
  </section>
</article>

<style>
  /* Text accents. Light on --surface: green 4.99, blue 5.16, amber 5.01.
     Those inks read 3.2-3.3:1 on the dark surface, so the dark theme swaps
     in the site's dark accents: green 7.20, blue 7.03, amber 7.74. */
  .security-page {
    --sec-green: #087f5b;
    --sec-blue: #2563eb;
    --sec-amber: #b45309;
  }
  :global(:root[data-theme='dark']) .security-page {
    --sec-green: #3fbf8f;
    --sec-blue: #8fa3ff;
    --sec-amber: #e3a54a;
  }
  .security-page :global(h1),
  .security-page :global(h2),
  .security-page :global(h3),
  .security-page :global(p) {
    margin-top: 0;
  }
  .hero {
    max-width: 900px;
    padding: 2rem 0 4rem;
  }
  .eyebrow {
    color: var(--sec-green);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin: 0 0 1.4rem;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: 0;
  }
  .hero h1 strong {
    color: var(--sec-green);
    font-weight: inherit;
  }
  /* zh and ja: break only at the <wbr> between phrases (src/lib/cjk-phrases.ts),
     so 网络 or ネットワーク is never split; a phrase wider than the line still
     breaks, as a last resort. */
  h1:lang(zh),
  h1:lang(ja),
  h2:lang(zh),
  h2:lang(ja) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead {
    max-width: 720px;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.85;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
  .metrics dt {
    color: var(--ink);
    font-size: 1.8rem;
    font-weight: 750;
    line-height: 1.1;
  }
  .metrics dd {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .split,
  .panel,
  .faq {
    padding: 6rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 82px;
  }
  .page-nav {
    position: sticky;
    top: 58px;
    z-index: 4;
    display: flex;
    gap: 0.3rem;
    margin: 0 -0.25rem;
    padding: 0.55rem 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }
  .page-nav::-webkit-scrollbar {
    display: none;
  }
  .page-nav a {
    flex: 0 0 auto;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    font-size: 0.76rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .page-nav a:hover {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--sec-green) 35%, var(--line));
  }
  .split {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(460px, 1.25fr);
    gap: 4rem;
    align-items: start;
  }
  h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.2vw, 3.3rem);
    line-height: 1.18;
    letter-spacing: 0;
  }
  .split > div > p,
  .section-head p,
  .cta > p {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.85;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    font-size: 0.86rem;
  }
  th {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  td {
    color: var(--ink-soft);
  }
  td:first-child {
    color: var(--ink);
    font-weight: 650;
  }
  tr:last-child td {
    border-bottom: none;
  }
  /* On a phone the 620px floor put the third column off-screen, with nothing
     to say it was there. Same treatment as the article tables (BlogPost.astro)
     and the marketing decision table: cells wrap, each column keeps a 6.5rem
     floor (three columns fit a 360px phone), and if the wrap still overflows
     (a 320px phone) it draws an always-on scrollbar and a trailing-edge fade.
     The wrap is focusable and named by the section heading. The tighter
     padding, type size and tracking match the decision table; here they
     shorten the wrapped table from 694px to 569px at 360px. */
  @media (max-width: 640px) {
    .table-wrap {
      overscroll-behavior-x: contain;
    }
    .table-wrap::-webkit-scrollbar {
      height: 6px;
    }
    .table-wrap::-webkit-scrollbar-track {
      background: color-mix(in srgb, var(--surface-sunk) 70%, transparent);
      border-radius: 999px;
    }
    .table-wrap::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--ink) 32%, transparent);
      border-radius: 999px;
    }
    @supports (animation-timeline: scroll(self inline)) {
      .table-wrap {
        animation: residency-table-edge-fade linear both;
        animation-timeline: scroll(self inline);
      }
    }
    @keyframes residency-table-edge-fade {
      from {
        mask-image: linear-gradient(to right, #000 calc(100% - 34px), transparent);
      }
      to {
        mask-image: linear-gradient(to right, #000 100%, transparent);
      }
    }
    table {
      min-width: 0;
    }
    th,
    td {
      box-sizing: border-box;
      min-width: 6.5rem;
      padding-right: 0.6rem;
      padding-left: 0.6rem;
      overflow-wrap: anywhere;
    }
    th {
      letter-spacing: 0.02em;
    }
    td {
      font-size: 0.82rem;
    }
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }
  .step-grid,
  .deploy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    padding: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .step-grid {
    list-style: none;
    margin: 0;
  }
  .step-grid li,
  .deploy-grid div {
    min-height: 245px;
    padding: 1.4rem;
    background: var(--surface);
  }
  .step-grid span {
    display: inline-block;
    margin-bottom: 2.3rem;
    color: var(--sec-green);
    font: 700 0.72rem/1 var(--font-mono);
  }
  .step-grid h3,
  .deploy-grid h3,
  .layer-list h3 {
    margin-bottom: 0.55rem;
    font-size: 1.02rem;
  }
  .step-grid p,
  .deploy-grid p,
  .layer-list p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.72;
  }
  .layer-list {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .layer-list div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
  }
  .deploy-grid div:nth-child(2) h3,
  .deploy-grid div:nth-child(2) + div h3 {
    color: var(--sec-blue);
  }
  .deploy-grid div:nth-child(4) h3 {
    color: var(--sec-amber);
  }
  .faq-list {
    display: grid;
    gap: 0.75rem;
  }
  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  summary {
    padding: 1rem 1.1rem;
    cursor: pointer;
    color: var(--ink);
    font-weight: 650;
  }
  details p {
    margin: 0;
    padding: 0 1.1rem 1.1rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.75;
  }
  .cta {
    margin-top: 2rem;
    padding: 4rem;
    color: white;
    background: #172b26;
    border-radius: 6px;
  }
  .cta .eyebrow {
    color: #8ee3c2;
  }
  .cta p {
    max-width: 680px;
    color: #bdc9c5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .button.primary {
    color: #172b26;
    background: white;
  }
  .button.secondary {
    color: white;
    border-color: rgba(255, 255, 255, 0.25);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .step-grid,
    .deploy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 0.5rem 0 2.25rem;
    }
    .hero h1 {
      margin-bottom: 1rem;
      font-size: 2.28rem;
      line-height: 1.08;
    }
    .lead {
      font-size: 0.98rem;
      line-height: 1.75;
    }
    .metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 1.6rem;
      padding-top: 0.9rem;
    }
    .metrics dt {
      font-size: 1rem;
      overflow-wrap: anywhere;
    }
    .metrics dd {
      font-size: 0.68rem;
      line-height: 1.35;
    }
    .split,
    .panel,
    .faq {
      padding: 3.2rem 0;
      scroll-margin-top: 120px;
    }
    .page-nav {
      top: 106px;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-right: 0;
      margin-left: 0;
      padding-right: 0;
      padding-left: 0;
      overflow-x: visible;
    }
    .page-nav a {
      flex: 1 1 9rem;
      min-height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      white-space: normal;
    }
    h2 {
      font-size: 1.9rem;
    }
    /* Japanese breaks only between phrases, and the longest here are nine
       (ネットワーク内に。) and eleven (セキュリティレビューを) characters:
       sized so each fits the 312px column of a 360px phone. */
    .hero h1:lang(ja) {
      font-size: 2rem;
    }
    h2:lang(ja) {
      font-size: 1.6rem;
    }
    .step-grid,
    .deploy-grid {
      grid-template-columns: 1fr;
    }
    .step-grid li,
    .deploy-grid div {
      min-height: auto;
    }
    .layer-list div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .cta {
      margin: 1rem -0.5rem 0;
      padding: 2.2rem 1.5rem;
    }
    .actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
