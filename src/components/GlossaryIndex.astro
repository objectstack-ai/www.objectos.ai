---
import {
  getGlossaryIndexSourceLocale,
  getGlossaryTermSourceLocale,
  getGlossaryTerms,
  glossaryTermPath,
} from '../glossary/registry';
import { glossaryUi } from '../glossary/ui';
import { cardSpans } from '../lib/card-rows';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';
import { htmlLang, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sourceLocale = getGlossaryIndexSourceLocale(locale);
const ui = glossaryUi(sourceLocale);
const terms = getGlossaryTerms(locale);

// A partly translated locale (#428: ja/ko/de/es/fr carry 5 of 24 terms) lists
// its translated terms first and the English stand-ins after them, under a
// heading that says why they are English. Interleaving them alphabetically
// put five Japanese cards among nineteen English ones with nothing marking
// which was which. A fully translated locale, or the English index, has no
// second group and renders exactly as before.
const isLocalized = (slug: string): boolean =>
  getGlossaryTermSourceLocale(locale, slug) === sourceLocale;
const localized = terms.filter((term) => isLocalized(term.slug));
const fallback = terms.filter((term) => !isLocalized(term.slug));
const groups = [
  { terms: localized, lang: undefined, spans: cardSpans(localized.length) },
  ...(fallback.length > 0
    ? [{ terms: fallback, lang: htmlLang('en'), spans: cardSpans(fallback.length) }]
    : []),
].filter((group) => group.terms.length > 0);
const isPartial = localized.length > 0 && fallback.length > 0;
---

<div class="glossary-index">
  <header class="head">
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 set:html={phraseHtml(ui.indexHeading, sourceLocale)} />
    <p class="lead">{ui.indexLead}</p>
    <p class="count">{ui.termCount(isPartial ? localized.length : terms.length)}</p>
  </header>

  {
    terms.length === 0 ? (
      <p class="empty">{ui.empty}</p>
    ) : (
      groups.map((group, groupIndex) => (
        <>
          {groupIndex > 0 && (
            <header class="group-head">
              <h2 id="untranslated-title">{ui.fallbackHeading}</h2>
              <p>{ui.fallbackLead}</p>
              <p class="count">{ui.termCount(group.terms.length)}</p>
            </header>
          )}
          <ul
            class:list={['term-grid', { 'term-grid-fallback': groupIndex > 0 }]}
            aria-labelledby={groupIndex > 0 ? 'untranslated-title' : undefined}>
            {group.terms.map((term, index) => (
              <li class={`span-${group.spans[index]}`}>
                <a
                  class="card card-link"
                  href={glossaryTermPath(locale, term.slug)}
                  lang={group.lang}>
                  <h2>
                    {term.term}
                    <span class="arrow" aria-hidden="true">→</span>
                  </h2>
                  <p>{term.definition}</p>
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    )
  }
</div>

<style>
  .head {
    max-width: var(--measure-prose);
    padding: 0.5rem 0 2.75rem;
  }
  .eyebrow {
    margin: 0 0 0.85rem;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  /* zh and ja: break only at the <wbr> between phrases (scripts/lib/cjk-phrases.mjs).
     ko: break only at its own spaces; no <wbr>. */
  /* On a phone, Latin-script headings hyphenate a word wider than the line by
     the <html lang> dictionary, as post titles do (BlogPost.astro): at 360 a
     German term split Genehmigungswor / kflow (#428). 12+ letters only, 5 kept
     on each side; `overflow-wrap` stays the last resort. Wider screens fit
     every word, and hyphenating there only served text-wrap: balance. */
  @media (max-width: 640px) {
    h1:is(:lang(en), :lang(de), :lang(fr), :lang(es)) {
      -webkit-hyphens: auto;
      hyphens: auto;
      hyphenate-limit-chars: 12 5 5;
    }
  }
  h1:lang(zh),
  h1:lang(ja),
  h1:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--ink-soft);
    font-size: var(--fs-17);
    line-height: var(--lh-prose);
  }
  .count {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font: 700 var(--fs-12)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .empty {
    color: var(--muted);
  }
  /* Three to a row on desktop, on six tracks so the count decides the rows
     (src/lib/card-rows.ts): 22 terms are six rows of three and two of two.
     `auto-fill` gave three columns at desktop width and left the last term,
     "Vibe coding", alone on its row. */
  .term-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .term-grid li {
    min-width: 0;
  }
  /* The English stand-ins on a partly translated index (#428). */
  /* The rule runs the grid's full width, as the one above the first grid does;
     only the text keeps the prose measure. */
  .group-head {
    margin: 3rem 0 0;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--line);
  }
  .group-head > * {
    max-width: var(--measure-prose);
  }
  .group-head h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-24);
    line-height: var(--lh-heading);
  }
  .group-head p:not(.count) {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-15);
    line-height: var(--lh-body);
  }
  .term-grid-fallback {
    padding-top: 1.5rem;
    border-top: 0;
  }
  @media (min-width: 861px) {
    .term-grid .span-2 {
      grid-column: span 2;
    }
    .term-grid .span-3 {
      grid-column: span 3;
    }
    .term-grid .span-6 {
      grid-column: 1 / -1;
    }
  }
  /* Two columns between the phone and desktop layouts, where auto-fill gave
     two as well; an odd last term takes the row. */
  @media (max-width: 860px) {
    .term-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .term-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .term-grid a {
    display: block;
    height: 100%;
    padding: 1.15rem 1.2rem 1.3rem;
    text-decoration: none;
  }
  /* A card title, so the text face, as on the cards of every other page; the
     display face is for page titles and section headings. */
  .term-grid h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.55rem;
    color: var(--ink);
    font-size: var(--fs-18);
    line-height: var(--lh-heading);
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .arrow {
    flex: none;
    color: var(--brand);
    font-size: var(--fs-15);
  }
  .term-grid p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-body);
  }
  @media (max-width: 640px) {
    .head {
      padding-bottom: 2rem;
    }
    .lead {
      font-size: var(--fs-16);
    }
    .term-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.75rem;
    }
  }
</style>
