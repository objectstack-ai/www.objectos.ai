---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { fallbackRoute, sourceLocaleByIdentity } from '../../lib/fallback';
import { LOCALES, termsPath, segToLocale } from '../../lib/i18n';
import { termsCopy } from '../../lib/legal';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = termsCopy[locale];
// ja/de/es/fr/ko render the English policy: noindexed, canonical to the English
// URL, and absent from hreflang (src/lib/fallback.ts).
const route = fallbackRoute(locale, sourceLocaleByIdentity(termsCopy), termsPath);
---

<Base
  title={`${copy.title} · ObjectOS`}
  description={copy.description}
  {locale}
  contentLocale={route.sourceLocale}
  canonical={route.canonical}
  noindex={route.isFallback}
  alternates={route.alternates}
  navAlternates={route.navAlternates}>
  <LegalPage {copy} />
</Base>
