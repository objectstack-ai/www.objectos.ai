---
import { getGlossaryTerms, glossaryTermPath } from '../glossary/registry';
import { glossaryUi } from '../glossary/ui';
import { cardSpans } from '../lib/card-rows';
import { phraseHtml } from '../lib/cjk-phrases';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = glossaryUi(locale);
const terms = getGlossaryTerms(locale);
const spans = cardSpans(terms.length);
---

<div class="glossary-index">
  <header class="head">
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 set:html={phraseHtml(ui.indexHeading, locale)} />
    <p class="lead">{ui.indexLead}</p>
    <p class="count">{ui.termCount(terms.length)}</p>
  </header>

  {
    terms.length === 0 ? (
      <p class="empty">{ui.empty}</p>
    ) : (
      <ul class="term-grid">
        {terms.map((term, index) => (
          <li class={`span-${spans[index]}`}>
            <a href={glossaryTermPath(locale, term.slug)}>
              <h2>
                {term.term}
                <span class="arrow" aria-hidden="true">→</span>
              </h2>
              <p>{term.definition}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Eyebrow and card arrows: 4.62:1 on the light --bg; the dark theme's
     #3fbf8f is 7.85:1 on its --bg (the light ink read 3.6:1 there). */
  .glossary-index {
    --glossary-accent: #087f5b;
  }
  :global(:root[data-theme='dark']) .glossary-index {
    --glossary-accent: #3fbf8f;
  }
  .head {
    max-width: 760px;
    padding: 0.5rem 0 2.75rem;
  }
  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--glossary-accent);
    font-size: 0.75rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: 0;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  /* zh and ja: break only at the <wbr> between phrases (src/lib/cjk-phrases.ts). */
  h1:lang(zh),
  h1:lang(ja) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead {
    margin: 0;
    max-width: 68ch;
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.8;
  }
  .count {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .empty {
    color: var(--muted);
  }
  /* Three to a row on desktop, on six tracks so the count decides the rows
     (src/lib/card-rows.ts): 22 terms are six rows of three and two of two.
     `auto-fill` gave three columns at desktop width and left the last term,
     "Vibe coding", alone on its row. */
  .term-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .term-grid li {
    min-width: 0;
  }
  @media (min-width: 861px) {
    .term-grid .span-2 {
      grid-column: span 2;
    }
    .term-grid .span-3 {
      grid-column: span 3;
    }
    .term-grid .span-6 {
      grid-column: 1 / -1;
    }
  }
  /* Two columns between the phone and desktop layouts, where auto-fill gave
     two as well; an odd last term takes the row. */
  @media (max-width: 860px) {
    .term-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .term-grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .term-grid a {
    display: block;
    height: 100%;
    padding: 1.15rem 1.2rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    text-decoration: none;
  }
  .term-grid a:hover {
    border-color: color-mix(in srgb, var(--glossary-accent) 45%, var(--line));
  }
  .term-grid h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.55rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.3;
    letter-spacing: 0;
    overflow-wrap: break-word;
  }
  .arrow {
    flex: none;
    color: var(--glossary-accent);
    font-size: 0.95rem;
  }
  .term-grid p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  @media (max-width: 640px) {
    .head {
      padding-bottom: 2rem;
    }
    .lead {
      font-size: 0.97rem;
    }
    .term-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.75rem;
    }
  }
</style>
