---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Cluster } from '../lib/clusters';
import { clusterCopy, clusterLabels } from '../lib/cluster-i18n';
import { blogPath, formatDate, postPath, type Locale } from '../lib/i18n';
import { builtHubLocale } from '../lib/posts';
import { darkCover } from '../lib/cover-variant';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';

interface Props {
  cluster: Cluster;
  locale: Locale;
  posts: { slug: string; entry: CollectionEntry<'blog'> }[];
}

const { cluster, locale } = Astro.props;
// `coverDark`: an SVG cover's dark variant (src/lib/cover-variant.ts); the
// card then draws both images, lazy, one shown per theme.
const posts = Astro.props.posts.map((post) => ({ ...post, coverDark: darkCover(post.entry.filePath, post.entry.data.cover) }));
// zh and ja headings carry a <wbr> between phrases (scripts/lib/cjk-phrases.mjs).
const ph = (text: string): string => phraseHtml(text, locale);
const copy = clusterCopy(cluster, locale);
const labels = clusterLabels(locale);
// `relatedTerms` is hand-curated, so a term may have no hub in this locale:
// link the hub that is really built (this locale's, else English's) and drop
// the term when neither exists. `hreflang` marks the English fallback.
const termLinks = (
  await Promise.all(
    cluster.relatedTerms.map(async (slug) => {
      const term = termBySlug(slug);
      const hubLocale = term && (await builtHubLocale(term, locale));
      return term && hubLocale
        ? {
            href: termHref(hubLocale, term),
            label: termLabel(slug, locale),
            hreflang: hubLocale === locale ? undefined : hubLocale,
          }
        : undefined;
    })
  )
).filter((link) => link !== undefined);
// A raster cover is served as WebP at the width the reading-path card draws
// it at, not as the 240-370 KB original JPG. Above 640px the image is a 180px
// (150px at 641-900px) column as tall as the card's text, about 190-230px, and
// object-fit: cover fills it by height, so a 1.6:1 or 16:9 cover is drawn
// 300-370px wide: `sizes` says 400px. On a phone the card stacks and the image
// is the full column at 16:9, drawn at its own width. The widest candidate
// covers the phone column at 3x. An SVG cover is a few KB and scales itself,
// so it is served as is.
const CARD_WIDTHS = [400, 540, 720, 1080];
const CARD_SIZES = '(max-width: 640px) calc(100vw - 2rem), 400px';
---

<article class="cluster">
  <section class="cluster-hero">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 set:html={ph(copy.title)} />
      <p class="lead">{copy.lead}</p>
    </div>
    <aside class="hero-rail" aria-label={labels.clusterSignals}>
      {labels.heroRail.map((item) => <span>{item}</span>)}
    </aside>
  </section>

  <section class="definition">
    <p>{copy.definition}</p>
  </section>

  <section class="split">
    <div>
      <p class="section-kicker">{labels.whyNow}</p>
      <ul class="signal-list">
        {copy.whyNow.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="section-kicker">{labels.capabilities}</p>
      <ul class="signal-list">
        {copy.capabilities.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="use-cases">
    <p class="section-kicker">{labels.useCases}</p>
    <div class="use-grid">
      {copy.useCases.map((item, index) => (
        <div class="use-case card">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{item}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="reading-path">
    <div class="section-head">
      <div>
        <p class="section-kicker">{labels.readingPath}</p>
        <h2 set:html={ph(labels.relatedArticles)} />
      </div>
      <a class="btn btn-ghost" href={blogPath(locale)}>{labels.allArticles} <span aria-hidden="true">→</span></a>
    </div>
    <div class="article-grid">
      {posts.map(({ slug, entry, coverDark }) => (
        <a class="article-card card card-link" href={postPath(locale, slug)}>
          {entry.data.cover &&
            (entry.data.cover.format === 'svg' ? (
              coverDark ? (
                <>
                  <img
                    class="cover-light"
                    src={entry.data.cover.src}
                    alt={entry.data.title}
                    width="360"
                    height="380"
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    class="cover-dark"
                    src={coverDark.src}
                    alt={entry.data.title}
                    width="360"
                    height="380"
                    loading="lazy"
                    decoding="async"
                  />
                </>
              ) : (
                <img
                  src={entry.data.cover.src}
                  alt={entry.data.title}
                  width="360"
                  height="380"
                  loading="lazy"
                  decoding="async"
                />
              )
            ) : (
              <Image
                src={entry.data.cover}
                alt={entry.data.title}
                width={Math.min(CARD_WIDTHS.at(-1)!, entry.data.cover.width)}
                widths={CARD_WIDTHS}
                sizes={CARD_SIZES}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            ))}
          <div>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>
              {formatDate(locale, entry.data.date)}
            </time>
            <h3 set:html={ph(entry.data.title)} />
            <p>{entry.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="terms">
    <p class="section-kicker">{labels.explore}</p>
    <div class="term-row">
      {termLinks.map((link) => (
        <a class="chip chip-brand" href={link.href} hreflang={link.hreflang}>
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <section class="faq">
    <p class="section-kicker">{labels.faq}</p>
    <div class="faq-list">
      {copy.faq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</article>

<style>
  .cluster {
    display: grid;
    gap: 3rem;
  }
  .cluster-hero {
    min-height: min(620px, calc(100vh - 132px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 3rem;
    align-items: center;
  }
  .eyebrow,
  .section-kicker {
    margin: 0 0 0.8rem;
  }
  /* Page title and section headings take the display face, as on every page;
     article-card titles stay in the text face. */
  /* zh and ja headings break only at the <wbr> between phrases
     (scripts/lib/cjk-phrases.mjs); a phrase wider than the line still breaks,
     as a last resort. ko breaks at its own spaces; it needs no <wbr>. */
  h1:lang(zh),
  h1:lang(ja),
  h1:lang(ko),
  h2:lang(zh),
  h2:lang(ja),
  h2:lang(ko),
  h3:lang(zh),
  h3:lang(ja),
  h3:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .cluster-hero h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    max-width: var(--measure-wide);
    text-wrap: balance;
  }
  /* A Japanese title breaks only between phrases, and a katakana word is one
     phrase: アプリプラットフォーム is eleven characters, which the 744px h1
     held 8.3 of at 5.6rem and a 360px phone 8.4 of at 2.45rem, so it broke
     inside the word. The page h1 step holds eleven on a desktop (56px, 616px
     of 744); the phone takes the 30px step (330px of 312, broken at the
     particle before it). */
  .cluster-hero h1:lang(ja) {
    line-height: var(--lh-display);
  }
  .lead {
    color: var(--ink-soft);
    font-size: var(--fs-20);
    line-height: var(--lh-body);
    margin: 0;
    max-width: var(--measure-wide);
  }
  .hero-rail {
    border-left: 1px solid var(--line);
    display: grid;
    gap: 0.7rem;
    padding-left: 1.2rem;
  }
  .hero-rail span {
    color: var(--ink-soft);
    font-size: var(--fs-14);
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .definition {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 2rem 0;
  }
  .definition p {
    font-size: var(--fs-24);
    line-height: var(--lh-ui);
    margin: 0;
    max-width: var(--measure-media);
  }
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  .signal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .signal-list li {
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    padding-top: 0.85rem;
  }
  .use-cases,
  .reading-path,
  .terms,
  .faq {
    display: grid;
    gap: 1rem;
  }
  .use-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .use-case {
    padding: 1rem;
  }
  .use-case span {
    color: var(--muted);
    display: block;
    font-size: var(--fs-13);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.8rem;
  }
  .use-case p {
    margin: 0;
  }
  .section-head {
    align-items: end;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    margin: 0;
    text-wrap: balance;
  }
  .section-head .btn-ghost {
    flex-shrink: 0;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .article-card {
    color: inherit;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    min-height: 190px;
    overflow: hidden;
    text-decoration: none;
  }
  .article-card img {
    width: 100%;
    height: 100%;
    min-height: 190px;
    object-fit: cover;
    filter: var(--cover-filter);
  }
  /* One cover per theme (src/lib/cover-variant.ts); the dark variant is drawn
     dark and takes no --cover-filter dimming. */
  :global(:root:not([data-theme='dark'])) .article-card .cover-dark,
  :global(:root[data-theme='dark']) .article-card .cover-light {
    display: none;
  }
  .article-card img.cover-dark {
    filter: none;
  }
  .article-card div {
    padding: 1rem;
  }
  .article-card time {
    color: var(--muted);
    font-size: var(--fs-13);
    font-variant-numeric: tabular-nums;
  }
  .article-card h3 {
    font-size: var(--fs-18);
    line-height: var(--lh-heading);
    margin: 0.35rem 0;
  }
  .article-card p {
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: var(--lh-ui);
    margin: 0;
  }
  .term-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .faq-list {
    display: grid;
    gap: 0.75rem;
  }
  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 1rem;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
  }
  details p {
    color: var(--ink-soft);
    margin: 0.75rem 0 0;
  }
  @media (max-width: 900px) {
    .cluster {
      gap: 2.4rem;
    }
    .cluster-hero,
    .split,
    .use-grid,
    .article-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cluster-hero {
      min-height: 0;
      padding: 2rem 0 1rem;
    }
    .hero-rail {
      border-left: 0;
      border-top: 1px solid var(--line);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 1rem 0 0;
    }
    .article-card {
      grid-template-columns: 150px minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cluster {
      gap: 2rem;
    }
    .cluster-hero h1 {
      overflow-wrap: anywhere;
    }
    .cluster-hero h1:lang(ja) {
      font-size: var(--fs-30);
    }
    .lead,
    .definition p {
      font-size: var(--fs-16);
    }
    .hero-rail {
      grid-template-columns: minmax(0, 1fr);
    }
    .section-head {
      align-items: flex-start;
      flex-direction: column;
    }
    .article-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-card img {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }
</style>
