---
import {
  ui,
  blogPath,
  homePath,
  pricingPath,
  LOCALES,
  LANG_NATIVE,
  type Locale,
} from '../lib/i18n';
import { getUsedTerms } from '../lib/posts';
import { termHref, groupMeta, type TermGroup } from '../lib/terms';
import { marketingPagePath } from '../content-pages/registry';
import { glossaryIndexPath } from '../glossary/registry';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = ui[locale];
const pathname = Astro.url.pathname;

const homeHref = homePath(locale);
const blogHref = blogPath(locale);
const pricingHref = pricingPath(locale);
const productTourHref = marketingPagePath(locale, 'product-tour');
const platformHref = marketingPagePath(locale, 'platform');
const aiHref = marketingPagePath(locale, 'ai');
const mcpHref = marketingPagePath(locale, 'mcp');
const dataModelingHref = marketingPagePath(locale, 'data-modeling');
const appUiHref = marketingPagePath(locale, 'app-ui');
const automationHref = marketingPagePath(locale, 'automation');
const approvalsHref = marketingPagePath(locale, 'approvals');
const permissionsHref = marketingPagePath(locale, 'permissions');
const analyticsHref = marketingPagePath(locale, 'analytics');
const trustCenterHref = marketingPagePath(locale, 'trust-center');
const agentGuideHref = marketingPagePath(locale, 'agent-developer');
const templatesHref = marketingPagePath(locale, 'templates');
const storiesHref = marketingPagePath(locale, 'customer-stories');
const glossaryHref = glossaryIndexPath(locale);

const DOCS_URL = 'https://docs.objectos.ai';
const GITHUB_URL = 'https://github.com/objectstack-ai/objectstack';

const inBlog = pathname.startsWith(`/${locale}/blog`);
const onBlogHome = pathname === blogHref;
const inPricing = pathname === pricingHref;
const inGlossary = pathname.startsWith(glossaryHref);

// Topic terms feed the Resources menu (only those with content in this locale).
const topicTerms = (await getUsedTerms('topic', locale)).filter((term) => !term.parent);
const onTopic = (href: string) => pathname.startsWith(href);

// Primary nav model — one source of truth for both the desktop dropdowns and
// the mobile drawer, so they can never drift apart. A group with more than one
// section renders as a multi-column mega panel on desktop and as labeled
// subsections inside the drawer accordion.
type NavItem = { label: string; href: string; external?: boolean; active: boolean };
type NavSection = { label?: string; items: NavItem[] };
type NavGroup = { id: string; label: string; active: boolean; sections: NavSection[] };

const capabilityItems: NavItem[] = [
  { label: t.siteNav.dataModeling, href: dataModelingHref, active: pathname === dataModelingHref },
  { label: t.siteNav.appInterfaces, href: appUiHref, active: pathname === appUiHref },
  { label: t.siteNav.automation, href: automationHref, active: pathname === automationHref },
  { label: t.siteNav.approvals, href: approvalsHref, active: pathname === approvalsHref },
  { label: t.siteNav.permissionsSecurity, href: permissionsHref, active: pathname === permissionsHref },
  { label: t.siteNav.analytics, href: analyticsHref, active: pathname === analyticsHref },
  { label: t.siteNav.aiBuildAsk, href: aiHref, active: pathname === aiHref },
  { label: t.siteNav.toolsMcp, href: mcpHref, active: pathname === mcpHref },
];

const groups: NavGroup[] = [
  {
    id: 'product',
    label: t.siteNav.product,
    active:
      pathname === productTourHref ||
      pathname === platformHref ||
      pathname === trustCenterHref ||
      capabilityItems.some((it) => it.active),
    sections: [
      {
        label: t.siteNav.groupEvaluate,
        items: [
          { label: t.siteNav.productTour, href: productTourHref, active: pathname === productTourHref },
          { label: t.siteNav.platform, href: platformHref, active: pathname === platformHref },
          { label: t.siteNav.whyObjectOs, href: `${homeHref}#compare`, active: false },
          { label: t.siteNav.trustCenter, href: trustCenterHref, active: pathname === trustCenterHref },
        ],
      },
      { label: t.siteNav.groupCapabilities, items: capabilityItems },
    ],
  },
  {
    id: 'developers',
    label: t.siteNav.developers,
    active: pathname === agentGuideHref || pathname === templatesHref,
    sections: [
      {
        items: [
          { label: t.siteNav.agentGuide, href: agentGuideHref, active: pathname === agentGuideHref },
          { label: t.siteNav.docs, href: DOCS_URL, external: true, active: false },
          { label: 'GitHub', href: GITHUB_URL, external: true, active: false },
          { label: t.siteNav.templates, href: templatesHref, active: pathname === templatesHref },
        ],
      },
    ],
  },
  {
    id: 'resources',
    label: t.siteNav.resources,
    active: inBlog || inGlossary || pathname === storiesHref,
    sections: [
      {
        items: [
          { label: t.backToList, href: blogHref, active: onBlogHome },
          { label: t.siteNav.glossary, href: glossaryHref, active: inGlossary },
          ...topicTerms.map((term) => {
            const href = termHref(locale, term);
            return { label: term.label[locale], href, active: onTopic(href) };
          }),
          { label: t.siteNav.referenceStories, href: storiesHref, active: pathname === storiesHref },
        ],
      },
    ],
  },
];

// Blog browse axes (in-page filter, blog context only). Solution axis is
// intentionally omitted — that area is not ready to surface in navigation.
const AXES: TermGroup[] = ['topic', 'role', 'industry'];
const menus = (
  await Promise.all(
    AXES.map(async (group) => {
      const terms = (await getUsedTerms(group, locale)).filter((term) => !term.parent);
      const active = terms.some((term) => pathname.startsWith(termHref(locale, term)));
      return { group, terms, active };
    })
  )
).filter((m) => m.terms.length > 0);
---

<header class:list={['site-header', { 'blog-context': inBlog }]}>
  <div class="bar">
    <a class="wordmark" href={homeHref}>
      <Logo size={22} class="logo" />
      <span class="name" translate="no">{t.siteName}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        groups.map((g) => (
          <div class="menu" data-menu>
            <button
              type="button"
              class:list={['menu-trigger', { active: g.active }]}
              aria-expanded="false"
              aria-haspopup="true"
              data-menu-trigger>
              {g.label}
              <span class="caret" aria-hidden="true">▾</span>
            </button>
            <div class:list={['menu-panel', { mega: g.sections.length > 1 }]} role="menu">
              {g.sections.map((s) => (
                <div class="menu-col">
                  {s.label && <span class="menu-col-label" role="presentation">{s.label}</span>}
                  {s.items.map((it) => (
                    <a
                      class:list={['menu-item', { active: it.active }]}
                      href={it.href}
                      role="menuitem"
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}>
                      {it.label}
                      {it.external && <span class="ext" aria-hidden="true">↗</span>}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <a class:list={['navlink', { active: inPricing }]} href={pricingHref} aria-current={inPricing ? 'page' : undefined}>
        {t.footer.pricing}
      </a>
    </nav>

    <div class="bar-right">
      <a
        class="iconbtn bar-desktop"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        title="GitHub">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>

      <button
        type="button"
        class="iconbtn bar-desktop"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode">
        <span class="moon" aria-hidden="true">☾</span>
        <span class="sun" aria-hidden="true">☀</span>
      </button>

      <div class="menu langmenu bar-desktop" data-menu>
        <button
          type="button"
          class="lang-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={`Language: ${LANG_NATIVE[locale]}`}
          title={`Language: ${LANG_NATIVE[locale]}`}
          data-menu-trigger>
          <span class="globe" aria-hidden="true">🌐</span>
          <span class="lang-cur native">{LANG_NATIVE[locale]}</span>
          <span class="caret" aria-hidden="true">▾</span>
        </button>
        <div class="menu-panel lang-panel" role="menu">
          {
            LOCALES.map((l) => (
              <a
                class:list={['menu-item', { active: l === locale }]}
                href={alternates[l] ?? homePath(l)}
                data-lang={l}
                role="menuitem">
                {LANG_NATIVE[l]}
              </a>
            ))
          }
        </div>
      </div>

      <a class="cta" href={pricingHref}>{t.getStarted}</a>

      <button
        type="button"
        class="iconbtn hamburger"
        aria-label={t.siteNav.menu}
        aria-expanded="false"
        aria-controls="site-drawer"
        data-drawer-open>
        <svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <line x1="3" y1="6" x2="17" y2="6" />
          <line x1="3" y1="10" x2="17" y2="10" />
          <line x1="3" y1="14" x2="17" y2="14" />
        </svg>
      </button>
    </div>
  </div>

  {
    inBlog && menus.length > 0 && (
      <nav class="blognav" aria-label="Browse">
        <div class="mainnav-inner">
          <a
            class:list={['nav-link', { active: onBlogHome }]}
            href={blogHref}
            aria-current={onBlogHome ? 'page' : undefined}>
            {t.all}
          </a>
          {menus.map((m) => (
            <div class="menu" data-menu>
              <button
                type="button"
                class:list={['menu-trigger', { active: m.active }]}
                aria-expanded="false"
                aria-haspopup="true"
                data-menu-trigger>
                {groupMeta(m.group).label[locale]}
                <span class="caret" aria-hidden="true">▾</span>
              </button>
              <div class="menu-panel" role="menu">
                {m.terms.map((term) => (
                  <a
                    class:list={[
                      'menu-item',
                      { active: pathname.startsWith(termHref(locale, term)) },
                    ]}
                    href={termHref(locale, term)}
                    role="menuitem">
                    {term.label[locale]}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </nav>
    )
  }
</header>

<!-- Mobile drawer: every destination lives here, so nothing is unreachable on
     small screens (including the primary sections from a blog article). -->
<div class="drawer" id="site-drawer" data-drawer aria-hidden="true">
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label={t.siteNav.menu}>
    <div class="drawer-head">
      <span class="drawer-title">{t.siteNav.menu}</span>
      <button type="button" class="iconbtn" aria-label="Close" data-drawer-close>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <line x1="5" y1="5" x2="15" y2="15" />
          <line x1="15" y1="5" x2="5" y2="15" />
        </svg>
      </button>
    </div>

    <nav class="drawer-nav" aria-label="Mobile">
      {
        groups.map((g) => (
          <details class="drawer-group" open={g.active}>
            <summary>
              {g.label}
              <span class="caret" aria-hidden="true">▾</span>
            </summary>
            <div class="drawer-links">
              {g.sections.map((s) => (
                <>
                  {s.label && <span class="drawer-sec-label">{s.label}</span>}
                  {s.items.map((it) => (
                    <a
                      class:list={['drawer-link', { active: it.active }]}
                      href={it.href}
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}>
                      {it.label}
                      {it.external && <span class="ext" aria-hidden="true">↗</span>}
                    </a>
                  ))}
                </>
              ))}
            </div>
          </details>
        ))
      }
      <a class:list={['drawer-flat', { active: inPricing }]} href={pricingHref}>{t.footer.pricing}</a>
    </nav>

    <a class="drawer-cta" href={pricingHref}>{t.getStarted}</a>

    <div class="drawer-foot">
      <div class="drawer-langs">
        {
          LOCALES.map((l) => (
            <a
              class:list={['drawer-lang', { active: l === locale }]}
              href={alternates[l] ?? homePath(l)}
              data-lang={l}>
              {LANG_NATIVE[l]}
            </a>
          ))
        }
      </div>
      <div class="drawer-utils">
        <a class="drawer-util" href={GITHUB_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          GitHub
        </a>
        <button type="button" class="drawer-util" data-theme-toggle>
          <span class="moon" aria-hidden="true">☾</span>
          <span class="sun" aria-hidden="true">☀</span>
          <span class="theme-label">Theme</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Remember the reader's language choice so `/` redirects there next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', a.dataset.lang || 'en');
      } catch {
        /* ignore */
      }
    });
  });

  // Dark-mode toggle (persisted; default comes from the inline head script).
  // querySelectorAll: there is a toggle in the bar and one in the drawer.
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* ignore */
      }
    });
  });

  // Dropdown menus (nav groups + axes + language): click to open, single-open,
  // close on outside-click / Escape.
  const menus = document.querySelectorAll<HTMLElement>('[data-menu]');
  function closeAll(except?: HTMLElement) {
    menus.forEach((m) => {
      if (m === except) return;
      m.classList.remove('open');
      m.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
    });
  }
  menus.forEach((menu) => {
    const trigger = menu.querySelector('[data-menu-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      closeAll(menu);
    });
  });
  document.addEventListener('click', () => closeAll());

  // Mobile drawer.
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const openBtn = document.querySelector<HTMLElement>('[data-drawer-open]');
  function setDrawer(open: boolean) {
    if (!drawer) return;
    drawer.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }
  openBtn?.addEventListener('click', () => setDrawer(true));
  document.querySelectorAll('[data-drawer-close]').forEach((el) =>
    el.addEventListener('click', () => setDrawer(false))
  );
  // Navigating away should close the sheet.
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setDrawer(false))
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      setDrawer(false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface-glass);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    box-shadow: 0 10px 28px -26px rgba(var(--shadow), 0.55);
    backdrop-filter: saturate(1.35) blur(18px);
  }
  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    height: 64px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
    transition: transform 0.16s ease;
  }
  .wordmark:hover {
    transform: translateY(-1px);
  }
  .logo {
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(0 8px 13px rgba(63, 91, 246, 0.22));
  }
  .name {
    font-weight: 760;
    letter-spacing: 0;
  }

  /* Primary desktop nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-right: auto;
    margin-left: 2rem;
  }
  .navlink {
    color: var(--ink-soft);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
    padding: 0.43rem 0.72rem;
    border-radius: 6px;
    white-space: nowrap;
    transition:
      color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }
  .navlink:hover,
  .navlink.active {
    color: var(--ink);
    background: var(--surface-sunk);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
  }

  .bar-right {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 70%, var(--surface-sunk));
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s,
      transform 0.15s;
  }
  .iconbtn:hover {
    color: var(--ink);
    background: var(--surface);
    transform: translateY(-1px);
  }
  .hamburger {
    display: none;
  }

  /* Language dropdown */
  .langmenu {
    position: relative;
  }
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
    font-size: 0.82rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--surface) 70%, var(--surface-sunk));
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.43rem 0.72rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }
  .lang-trigger:hover {
    color: var(--ink);
    background: var(--surface);
    transform: translateY(-1px);
  }
  .lang-trigger .globe {
    font-size: 0.85rem;
  }
  .lang-panel {
    left: auto;
    right: 0;
  }

  /* Primary CTA — pinned in the bar at every width so it never scrolls away */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.82rem;
    font-weight: 680;
    color: var(--surface);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.46rem 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      opacity 0.15s ease;
  }
  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px -14px rgba(var(--shadow), 0.55);
    opacity: 0.95;
  }

  /* Dropdown menus (shared by nav groups, blog axes, language) */
  .menu {
    position: relative;
  }
  .menu-trigger {
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--ink-soft);
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.43rem 0.72rem;
    border-radius: 6px;
    transition:
      color 0.15s,
      background 0.15s,
      box-shadow 0.16s ease;
  }
  .menu-trigger:hover,
  .menu-trigger.active {
    color: var(--ink);
    background: var(--surface-sunk);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--line) 70%, transparent);
  }
  .caret {
    font-size: 0.6rem;
    opacity: 0.55;
    transition: transform 0.15s;
  }
  .menu.open .caret {
    transform: rotate(180deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
