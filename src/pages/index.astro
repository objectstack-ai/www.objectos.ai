---
// Root `/`: detect the reader's language and redirect to the right locale.
// Static page — runs client-side. Honors a remembered choice (set by the
// header toggle); otherwise: zh-TW / zh-HK / zh-Hant → Traditional, other
// zh → Simplified, ja/de/es/fr/ko → matching locale, everything else →
// English (default/fallback).
//
// To a crawler this page is a redirect, not a page: the zero-delay meta
// refresh is read as a permanent redirect to /en/, which is also what the
// script answers for a client with no language preference. So it names /en/
// as its canonical, and its alternates are absolute — a relative `href` in an
// hreflang annotation is ignored. It is not noindexed: `noindex` on a page
// that redirects and names a canonical is a contradictory signal (keep this
// out of the index vs. index the target), and the redirect already keeps it
// out. The sitemap leaves `/` out (astro.config.mjs).
import { homePath, LOCALES } from '../lib/i18n';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ObjectOS</title>
    <link rel="canonical" href={absoluteUrl(homePath('en'))} />
    {LOCALES.map((locale) => <link rel="alternate" hreflang={locale} href={absoluteUrl(homePath(locale))} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(homePath('en'))} />
    <link rel="alternate" type="application/rss+xml" title="Articles · ObjectOS" href={absoluteUrl('/rss.xml')} />
    <script is:inline>
      (function () {
        try {
          var ok = ['en', 'zh-Hans', 'zh-Hant', 'ja', 'de', 'es', 'fr', 'ko'];
          var saved = localStorage.getItem('preferred-lang');
          var lang;
          if (saved && ok.indexOf(saved) !== -1) {
            lang = saved;
          } else {
            var navs = navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ''];
            for (var i = 0; i < navs.length; i++) {
              var nav = String(navs[i] || '').toLowerCase();
              if (nav.indexOf('zh') === 0) {
                lang = /hant|tw|hk|mo/.test(nav) ? 'zh-Hant' : 'zh-Hans';
                break;
              } else if (nav.indexOf('ja') === 0) {
                lang = 'ja';
                break;
              } else if (nav.indexOf('de') === 0) {
                lang = 'de';
                break;
              } else if (nav.indexOf('es') === 0) {
                lang = 'es';
                break;
              } else if (nav.indexOf('fr') === 0) {
                lang = 'fr';
                break;
              } else if (nav.indexOf('ko') === 0) {
                lang = 'ko';
                break;
              } else if (nav.indexOf('en') === 0) {
                lang = 'en';
                break;
              }
            }
            lang = lang || 'en';
          }
          location.replace('/' + lang + '/');
        } catch (e) {
          location.replace('/en/');
        }
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/en/" />
  </head>
  <body>
    <p>Redirecting… <a href="/en/">English</a> · <a href="/zh-Hans/">简体</a> ·
      <a href="/zh-Hant/">繁體</a> · <a href="/ja/">日本語</a> ·
      <a href="/de/">Deutsch</a> · <a href="/es/">Español</a> ·
      <a href="/fr/">Français</a> · <a href="/ko/">한국어</a></p>
  </body>
</html>
