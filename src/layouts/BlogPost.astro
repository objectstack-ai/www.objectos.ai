---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate, ui, blogPath, postPath, STATUS_COLOR, type Locale } from '../lib/i18n';
import { termBySlug, termHref, termLabel } from '../lib/terms';
import { getPostsInLocale, isPublicPost } from '../lib/posts';

interface Props {
  data: CollectionEntry<'blog'>['data'];
  slug: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { data, slug, locale, alternates } = Astro.props;
const t = ui[locale];
const dateStr = data.date.toISOString().slice(0, 10);
const displayDate = formatDate(locale, data.date);
const coverSrc =
  typeof data.cover === 'string'
    ? data.cover
    : (data.cover as { src?: string } | undefined)?.src;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();
const currentUrl = site ? `${site}${Astro.url.pathname}` : Astro.url.href;
const imageUrl = coverSrc ? absoluteUrl(coverSrc) : absoluteUrl('/images/objectos-home-hero.png');
const topic = termBySlug(data.topic)!;
const relatedPosts = (await getPostsInLocale(locale))
  .filter((post) => post.slug !== slug && post.entry.data.status !== 'archived')
  .map((post) => {
    const d = post.entry.data;
    let score = 0;
    if (d.topic === data.topic) score += 4;
    if (d.audience === data.audience) score += 2;
    score += (d.solutions ?? []).filter((value) => (data.solutions ?? []).includes(value)).length * 2;
    score += (d.industries ?? []).filter((value) => (data.industries ?? []).includes(value)).length * 2;
    return { ...post, score };
  })
  .filter((post) => post.score > 0)
  .sort((a, b) => b.score - a.score || b.entry.data.date.getTime() - a.entry.data.date.getTime())
  .slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: data.date.toISOString(),
    author: {
      '@type': 'Organization',
      name: data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: 'ObjectStack AI LLC',
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl('/logo.svg'),
      },
    },
    mainEntityOfPage: currentUrl,
    url: currentUrl,
    image: imageUrl,
    articleSection: termLabel(data.topic, locale),
    keywords: data.tags,
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.articlesTitle,
        item: absoluteUrl(blogPath(locale)),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: termLabel(data.topic, locale),
        item: absoluteUrl(termHref(locale, topic)),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.title,
        item: slug ? absoluteUrl(postPath(locale, slug)) : currentUrl,
      },
    ],
  },
];
---

<Base
  title={data.title}
  description={data.description}
  canonical={data.canonical_url}
  image={coverSrc}
  type="article"
  noindex={!isPublicPost(data)}
  publishedTime={data.date.toISOString()}
  modifiedTime={data.date.toISOString()}
  author={data.author}
  jsonLd={jsonLd}
  {locale}
  {alternates}>
  <article>
    <a class="back" href={blogPath(locale)}>← {t.backToList}</a>

    <header class="post-head">
      <div class="meta">
        <a class="cat topic" href={termHref(locale, topic)}>
          {termLabel(data.topic, locale)}
        </a>
        <a class="cat" href={termHref(locale, termBySlug(data.audience)!)}>
          {termLabel(data.audience, locale)}
        </a>
        {
          (data.solutions ?? []).map((slug) => (
            <a class="cat" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        {
          (data.industries ?? []).map((slug) => (
            <a class="cat" href={termHref(locale, termBySlug(slug)!)}>
              {termLabel(slug, locale)}
            </a>
          ))
        }
        <span class="pill" style={`--c:${STATUS_COLOR[data.status]}`}>
          {t.status[data.status]}
        </span>
        <span class="dot">·</span>
        <time datetime={dateStr}>{displayDate}</time>
        <span class="dot">·</span>
        <span>{t.by} {data.author}</span>
      </div>

      <h1>{data.title}</h1>
      {data.description && <p class="lead">{data.description}</p>}

      {
        coverSrc && (
          <img
            class="cover"
            src={coverSrc}
            alt={data.title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )
      }

      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      {
        data.channels.length > 0 && (
          <div class="channels">
            <span class="channels-label">{t.alsoOn}</span>
            {data.channels.map((c) => (
              <a href={c.url} target="_blank" rel="noopener">
                {c.platform}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      relatedPosts.length > 0 && (
        <aside class="related" aria-labelledby="related-title">
          <h2 id="related-title">{t.relatedTitle}</h2>
          <ul>
            {relatedPosts.map((post) => (
              <li>
                <a href={postPath(locale, post.slug)}>{post.entry.data.title}</a>
                <p>{post.entry.data.description}</p>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>

  <style>
    article {
      max-width: 860px;
      min-width: 0;
      margin: 0 auto;
    }
    .back {
      display: inline-block;
      margin-bottom: 2rem;
      font-size: 0.85rem;
      color: var(--ink-soft);
      text-decoration: none;
      transition: color 0.16s ease, transform 0.16s ease;
    }
    .back:hover {
      color: var(--ink);
      transform: translateX(-2px);
    }
    .post-head {
      padding-bottom: 2.25rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--line);
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: var(--ink-soft);
      margin-bottom: 1.1rem;
    }
    .cat {
      font-size: 0.78rem;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.15rem 0.55rem;
      border: 1px solid color-mix(in srgb, var(--accent) 16%, transparent);
      border-radius: 999px;
      text-decoration: none;
    }
    .cat:hover {
      background: color-mix(in srgb, var(--accent) 16%, var(--surface));
    }
    .dot {
      color: var(--muted);
    }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 5vw, 3.35rem);
      line-height: 1.06;
      letter-spacing: 0;
      margin: 0 0 1rem;
    }
    .lead {
      font-size: 1.15rem;
      line-height: 1.55;
      color: var(--ink-soft);
      margin: 0;
    }
    .cover {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      margin-top: 1.75rem;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--surface-sunk);
      box-shadow: 0 28px 70px -48px rgba(var(--shadow), 0.68);
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      padding: 0;
      margin: 1.4rem 0 0;
    }
    .tags li {
      font-size: 0.74rem;
      color: var(--ink-soft);
      background: var(--surface-sunk);
      border-radius: 999px;
      padding: 0.15rem 0.55rem;
    }
    .channels {
      margin-top: 1.2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.85rem;
    }
    .channels-label {
      color: var(--muted);
    }
    .channels a {
      text-decoration: none;
      background: var(--accent-soft);
      padding: 0.1rem 0.5rem;
      border-radius: 999px;
    }
    .related {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }
    .related h2 {
      font-size: 1.1rem;
      margin: 0 0 1rem;
      letter-spacing: 0;
    }
    .related ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.9rem;
    }
    .related li {
      padding: 0.95rem 1rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      box-shadow: 0 14px 38px -34px rgba(var(--shadow), 0.45);
      transition: transform 0.16s ease, border-color 0.16s ease;
    }
    .related li:hover {
      border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
      transform: translateY(-2px);
    }
    .related a {
      display: inline-block;
      color: var(--ink);
      font-weight: 700;
      line-height: 1.35;
      text-decoration: none;
    }
    .related a:hover {
      color: var(--accent);
    }
    .related p {
      margin: 0.35rem 0 0;
      color: var(--ink-soft);
      font-size: 0.9rem;
      line-height: 1.55;
    }
  </style>

  <style is:global>
    .prose {
      min-width: 0;
      font-size: 1.06rem;
      line-height: 1.82;
      color: var(--ink);
    }
    .prose > :first-child {
      margin-top: 0;
    }
    .prose h2 {
      font-family: var(--font-display);
      font-size: 1.75rem;
      letter-spacing: 0;
      margin: 2.6rem 0 1rem;
      line-height: 1.25;
      scroll-margin-top: 104px;
    }
    .prose h3 {
      font-size: 1.22rem;
      margin: 2rem 0 0.75rem;
      scroll-margin-top: 104px;
    }
    .prose p {
      margin: 0 0 1.25rem;
    }
    .prose a {
      color: var(--accent);
      text-underline-offset: 2px;
    }
    .prose strong {
      color: var(--ink);
      font-weight: 650;
    }
    .prose ul,
    .prose ol {
      padding-left: 1.4rem;
      margin: 0 0 1.25rem;
    }
    .prose li {
      margin: 0.4rem 0;
    }
    .prose blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1.2rem;
      border-left: 4px solid color-mix(in srgb, var(--accent) 42%, var(--line));
      border-radius: 0 8px 8px 0;
      background: color-mix(in srgb, var(--surface) 64%, transparent);
      color: var(--ink-soft);
      overflow-wrap: anywhere;
    }
    .prose blockquote p {
      margin: 0;
    }
    .prose hr {
      border: none;
      border-top: 1px solid var(--line);
      margin: 2.5rem 0;
    }
    .prose img {
      width: 100%;
      height: auto;
      max-width: 100%;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--surface);
      box-shadow: 0 18px 48px -42px rgba(var(--shadow), 0.55);
      display: block;
      margin: 1.5rem auto;
    }
    .prose :not(pre) > code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: var(--surface-sunk);
      padding: 0.12em 0.4em;
      border-radius: 5px;
      border: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
      overflow-wrap: anywhere;
    }
    .prose pre {
      max-width: 100%;
      margin: 1.5rem 0;
      padding: 1rem 1.15rem;
      border-radius: 10px;
      overflow-x: auto;
      font-size: 0.86rem;
      line-height: 1.6;
      border: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface-sunk) 72%, var(--surface));
      box-shadow: 0 18px 42px -36px rgba(var(--shadow), 0.45);
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.95rem;
    }
    .prose th,
    .prose td {
      border: 1px solid var(--line);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }
    .prose th {
      background: var(--surface-sunk);
    }
    @media (max-width: 640px) {
      .back {
        margin-bottom: 1.35rem;
      }
      .post-head {
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      .meta {
        gap: 0.4rem;
        font-size: 0.76rem;
      }
      .cat {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
      }
      .dot {
        display: none;
      }
      h1 {
        font-size: 2rem;
        line-height: 1.18;
        overflow-wrap: anywhere;
      }
      .lead {
        font-size: 1rem;
        line-height: 1.65;
      }
      .cover {
        margin-top: 1.25rem;
        border-radius: 6px;
      }
      .prose {
        font-size: 1rem;
        line-height: 1.75;
      }
      .prose h2 {
        margin-top: 2.25rem;
        font-size: 1.35rem;
        overflow-wrap: anywhere;
      }
      .prose h3 {
        font-size: 1.12rem;
        overflow-wrap: anywhere;
      }
      .prose pre {
        margin-right: -0.25rem;
        margin-left: -0.25rem;
        padding: 0.85rem;
        border-radius: 6px;
        font-size: 0.78rem;
      }
      .prose table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        font-size: 0.82rem;
        white-space: nowrap;
      }
    }
  </style>
</Base>
