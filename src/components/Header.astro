---
import { ui, homePath, type Locale } from '../lib/i18n';
import { getUsedProducts } from '../lib/posts';
import { productLabel, productPath } from '../lib/products';

interface Props {
  locale: Locale;
  enHref: string;
  zhHref: string;
}

const { locale, enHref, zhHref } = Astro.props;
const t = ui[locale];

const products = await getUsedProducts();
const pathname = Astro.url.pathname;
const homeHref = homePath(locale);
const onHome = pathname === homeHref;
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={homeHref}>
      <span class="mark">◆</span>
      <span class="name">{t.siteName}</span>
      <span class="sep">/</span>
      <span class="nav">{t.nav}</span>
    </a>

    <nav class="lang" aria-label="Language">
      <a
        class:list={['seg', { active: locale === 'en' }]}
        href={enHref}
        aria-current={locale === 'en' ? 'true' : undefined}>EN</a
      >
      <a
        class:list={['seg', { active: locale === 'zh-Hans' }]}
        href={zhHref}
        aria-current={locale === 'zh-Hans' ? 'true' : undefined}>中文</a
      >
    </nav>
  </div>

  {
    products.length > 0 && (
      <nav class="products" aria-label="Products">
        <div class="products-inner">
          <a class:list={['prod', { active: onHome }]} href={homeHref}>
            {t.all}
          </a>
          {products.map((slug) => (
            <a
              class:list={[
                'prod',
                { active: pathname.startsWith(productPath(locale, slug)) },
              ]}
              href={productPath(locale, slug)}>
              {productLabel(slug, locale)}
            </a>
          ))}
        </div>
      </nav>
    )
  }
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    height: 58px;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .mark {
    color: var(--accent);
    font-size: 0.7rem;
    transform: translateY(-1px);
  }
  .name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .sep {
    color: var(--muted);
  }
  .nav {
    color: var(--ink-soft);
    font-weight: 450;
  }

  .lang {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    background: var(--surface-sunk);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .seg {
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
    transition:
      color 0.15s,
      background 0.15s;
  }
  .seg:hover {
    color: var(--ink);
  }
  .seg.active {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  /* Product-level nav (primary axis) */
  .products {
    border-top: 1px solid var(--line);
  }
  .products-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    overflow-x: auto;
  }
  .prod {
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.15s;
  }
  .prod:hover {
    color: var(--ink);
  }
  .prod.active {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
</style>
