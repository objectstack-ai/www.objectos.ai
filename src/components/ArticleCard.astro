---
import { Image } from 'astro:assets';
import type { Locale } from '../lib/i18n';
import { formatDate, postPath, STATUS_COLOR, ui } from '../lib/i18n';
import type { LocalePost } from '../lib/posts';
import { termLabel } from '../lib/terms';
import { phraseHtml } from '../../scripts/lib/cjk-phrases.mjs';

interface Props {
  post: LocalePost;
  locale: Locale;
  variant?: 'standard' | 'feature';
}

const { post, locale, variant = 'standard' } = Astro.props;
const d = post.entry.data;
const t = ui[locale];
// A raster cover is served as WebP at the thumbnail's width, not as the
// 1.5-1.9 MB original: a standard card is one of three columns (about 343px)
// on a desktop, one of two at 641-900px and the full column on a phone; the
// feature card's cover column is about 585px at 1024px and up, and the full
// column below. `sizes` is the width the image is drawn at, not the card's:
// the 16:10 thumb crops a 16:9 cover with object-fit: cover, which draws it
// 1.11x the card's width (a 343px card needs 381px of image; the phone's 2:1
// thumb needs none). The widest candidates cover the phone column at 3x and
// the feature at 2x. An SVG cover is a few KB and scales itself, so it is
// served as is. The feature card opens the blog index above the fold, so its
// cover is not lazy.
const THUMB_WIDTHS = [400, 540, 720, 1080, 1280];
const thumbSizes =
  variant === 'feature'
    ? '(min-width: 1024px) 640px, calc(100vw - 2rem)'
    : '(max-width: 640px) calc(100vw - 2rem), (max-width: 900px) calc(55vw - 2rem), 400px';
const thumbLoading = variant === 'feature' ? 'eager' : 'lazy';
---

<li class:list={['article-item', variant]}>
  <a class="card" href={postPath(locale, post.slug)}>
    <div class="thumb">
      {d.cover ? (
        d.cover.format === 'svg' ? (
          <img
            src={d.cover.src}
            alt={d.title}
            width={d.cover.width}
            height={d.cover.height}
            loading={thumbLoading}
            decoding="async"
          />
        ) : (
          <Image
            src={d.cover}
            alt={d.title}
            width={Math.min(THUMB_WIDTHS.at(-1)!, d.cover.width)}
            widths={THUMB_WIDTHS}
            sizes={thumbSizes}
            format="webp"
            loading={thumbLoading}
            decoding="async"
          />
        )
      ) : (
        <div class="thumb-fallback">
          <span class="fmark">◆</span>
          <span class="ftopic">{termLabel(d.topic, locale)}</span>
        </div>
      )}
    </div>
    <div class="body">
      <div class="top">
        {d.status !== 'published' && (
          <span class="pill" style={`--c:${STATUS_COLOR[d.status]}`}>
            {t.status[d.status]}
          </span>
        )}
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(locale, d.date)}</time>
      </div>
      <h2 set:html={phraseHtml(d.title, locale)} />
      <p class="desc">{d.description}</p>
      <div class="facets">
        <span class="facet topic">{termLabel(d.topic, locale)}</span>
        <span class="facet">{termLabel(d.audience, locale)}</span>
        {(d.solutions ?? []).map((slug) => (
          <span class="facet">{termLabel(slug, locale)}</span>
        ))}
        {(d.industries ?? []).map((slug) => (
          <span class="facet">{termLabel(slug, locale)}</span>
        ))}
        {d.tags.map((tag) => (
          <span class="facet tag">{tag}</span>
        ))}
      </div>
    </div>
  </a>
</li>

<style>
  .article-item {
    min-width: 0;
    content-visibility: auto;
    contain-intrinsic-size: 420px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 18px 48px -40px rgba(var(--shadow), 0.52);
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    box-shadow: 0 28px 58px -40px rgba(var(--shadow), 0.72);
    transform: translateY(-3px);
  }
  .thumb {
    aspect-ratio: 16 / 10;
    background: var(--surface-sunk);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.28s ease;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.035);
  }
  .thumb-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: color-mix(in srgb, var(--accent) 50%, var(--muted));
  }
  .thumb-fallback .fmark {
    font-size: 1.7rem;
    opacity: 0.45;
  }
  .thumb-fallback .ftopic {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.25rem 1.35rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }
  .pill {
    font-size: 0.72rem;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 9%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
    text-transform: capitalize;
  }
  .top time {
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.24;
    letter-spacing: 0;
    margin: 0 0 0.4rem;
    transition: color 0.18s ease;
  }
  /* zh and ja titles break only at the <wbr> between phrases
     (scripts/lib/cjk-phrases.mjs), so a word such as 业务 or アプリケーション
     is never split across lines; a phrase wider than the line still breaks,
     as a last resort. ko titles break at their own spaces, never inside a
     word such as 없음; Korean needs no <wbr>. */
  h2:lang(zh),
  h2:lang(ja),
  h2:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .card:hover h2 {
    color: var(--accent);
  }
  .desc {
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .facets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .facet {
    font-size: 0.72rem;
    color: var(--ink-soft);
    background: var(--surface-sunk);
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .facet.topic {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .facet.tag {
    color: var(--muted);
    background: transparent;
    padding: 0.12rem 0.35rem;
  }
  .facet.tag::before {
    content: '#';
    opacity: 0.6;
  }
  .feature .thumb {
    aspect-ratio: 16 / 9;
  }
  .feature h2 {
    font-size: clamp(1.55rem, 2.6vw, 2.15rem);
    line-height: 1.12;
  }
  .feature .desc {
    font-size: 1rem;
    -webkit-line-clamp: 4;
  }
  .feature .body {
    padding: 1.35rem 1.45rem 1.55rem;
  }
  /* Desktop: the feature spans a full row (ArticleList) with the cover beside
     the text. The cover column is at least the cover's own 16:9 (the padding
     box) and stretches with the text when that is taller, cropping a sliver
     at the sides instead of leaving a band under the image; text shorter than
     the cover is centred, so neither column has an empty band. Below 1024px
     the text column gets too narrow and tall for the cover beside it (the
     crop passes the ~11% a 16:10 card thumb already takes), so narrower
     screens keep the stacked card, alone in its row. */
  @media (min-width: 1024px) {
    .feature .card {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .feature .thumb {
      position: relative;
      aspect-ratio: auto;
    }
    .feature .thumb::before {
      content: '';
      flex: none;
      width: 0;
      padding-top: 56.25%;
    }
    .feature .thumb :global(img) {
      position: absolute;
      inset: 0;
    }
    .feature .body {
      justify-content: center;
      padding: 1.35rem 1.6rem;
    }
    /* Sized so the text fits beside the cover's 16:9 at the 1072px content
       width; longer localized titles fall back to the stretch above. */
    .feature h2 {
      font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    }
    .feature .desc {
      -webkit-line-clamp: 3;
    }
    .feature .facets {
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .card {
      border-radius: 8px;
    }
    .thumb,
    .feature .thumb {
      aspect-ratio: 2 / 1;
    }
    .body,
    .feature .body {
      padding: 0.9rem 1rem 1rem;
    }
    h2,
    .feature h2 {
      font-size: 1.08rem;
      line-height: 1.38;
    }
    /* Latin-script titles: a word wider than the card hyphenates (by the
       <html lang> dictionary); one with no hyphenation point breaks anywhere
       as the last resort. Without either, a 36-letter German compound ran
       5px past the card at 360 and was clipped by its `overflow: hidden`.
       Same 12-letter floor as the article title (BlogPost.astro). zh, ja
       and ko keep their keep-all rule above. */
    h2:is(:lang(en), :lang(de), :lang(fr), :lang(es)) {
      -webkit-hyphens: auto;
      hyphens: auto;
      hyphenate-limit-chars: 12 5 5;
      overflow-wrap: anywhere;
    }
    .desc,
    .feature .desc {
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
      line-height: 1.55;
      -webkit-line-clamp: 2;
    }
    .facets {
      gap: 0.3rem;
    }
    .facet {
      font-size: 0.67rem;
    }
    .facet.tag {
      display: none;
    }
  }
</style>
