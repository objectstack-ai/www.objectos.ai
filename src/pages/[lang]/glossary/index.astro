---
import Base from '../../../layouts/Base.astro';
import GlossaryIndex from '../../../components/GlossaryIndex.astro';
import {
  getGlossaryIndexSourceLocale,
  getGlossaryTermSourceLocale,
  getGlossaryTerms,
  glossaryIndexAlternates,
  glossaryIndexNavTargets,
  glossaryIndexPath,
  glossaryTermPath,
} from '../../../glossary/registry';
import { glossaryUi } from '../../../glossary/ui';
import { homePath, htmlLang, LOCALES, segToLocale, ui as siteUi } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const t = siteUi[locale];

// Same rule as marketing pages: a locale with no authored content renders the
// English copy, canonicalizes to the English URL, and is not indexed.
const sourceLocale = getGlossaryIndexSourceLocale(locale);
const isFallback = sourceLocale !== locale;
const canonical = glossaryIndexPath(sourceLocale);
const ui = glossaryUi(sourceLocale);

// The set lists only terms that exist in its own language. A partly translated
// locale (#428) shows English stand-ins on the page, but those URLs are
// noindexed and canonicalize to /en/, so naming them as members of a ja set
// would point structured data at pages that are not ja and not indexable.
const terms = getGlossaryTerms(locale).filter(
  (term) => getGlossaryTermSourceLocale(sourceLocale, term.slug) === sourceLocale
);

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (href: string): string =>
  site ? new URL(href, `${site}/`).toString() : new URL(href, Astro.url).toString();

const setUrl = absoluteUrl(canonical);
const title = `${ui.indexTitle} · ${t.siteName}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': setUrl,
    name: ui.indexTitle,
    description: ui.indexLead,
    url: setUrl,
    inLanguage: htmlLang(sourceLocale),
    hasDefinedTerm: terms.map((term) => ({
      '@type': 'DefinedTerm',
      '@id': absoluteUrl(glossaryTermPath(sourceLocale, term.slug)),
      name: term.term,
      description: term.definition,
      url: absoluteUrl(glossaryTermPath(sourceLocale, term.slug)),
      inDefinedTermSet: setUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.siteName,
        item: absoluteUrl(homePath(locale)),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: ui.indexTitle,
        item: setUrl,
      },
    ],
  },
];
---

<Base
  {title}
  description={ui.indexLead}
  {locale}
  contentLocale={sourceLocale}
  {canonical}
  noindex={isFallback}
  alternates={glossaryIndexAlternates()}
  navAlternates={glossaryIndexNavTargets()}
  {jsonLd}>
  <GlossaryIndex {locale} />
</Base>
