---
import Base from '../../layouts/Base.astro';
import Pricing from '../../components/Pricing.astro';
import { LOCALES, segToLocale, pricingPath, refundsPath } from '../../lib/i18n';
import { pricingCopy } from '../../lib/pricing';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const locale = segToLocale(Astro.params.lang!)!;
const copy = pricingCopy[locale];
const alternates = Object.fromEntries(LOCALES.map((language) => [language, pricingPath(language)]));
---

<Base title={`${copy.title} · ObjectOS`} description={copy.description} {locale} {alternates}>
  <Pricing {copy} refundsHref={refundsPath(locale)} />
</Base>
