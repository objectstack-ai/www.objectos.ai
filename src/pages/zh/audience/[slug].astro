---
import Base from '../../../layouts/Base.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { getUsedAudiences } from '../../../lib/posts';
import { audienceLabel, type AudienceSlug } from '../../../lib/audiences';
import { ui } from '../../../lib/i18n';

export async function getStaticPaths() {
  const items = await getUsedAudiences();
  return items.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: AudienceSlug };
const label = audienceLabel(slug, 'zh-Hans');
---

<Base
  title={`${label} · ${ui['zh-Hans'].siteName}`}
  description={`${label} —— 构建 AI-native 软件的文章。`}
  locale="zh-Hans"
  enHref={`/audience/${slug}`}
  zhHref={`/zh/audience/${slug}`}>
  <ArticleList locale="zh-Hans" activeAudience={slug} />
</Base>
